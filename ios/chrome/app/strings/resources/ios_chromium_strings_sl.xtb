<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="1000436330784933699">Tukaj lahko odprete Lens.</translation>
<translation id="1042296835509784301">V Jatteru odpre upravitelja gesel.</translation>
<translation id="1047130070405668746">Izberite Jatter.</translation>
<translation id="1091252999271033193">To pomeni, da bo Jatter vsakič zahteval spletno mesto za mobilne naprave.</translation>
<translation id="1115463765356382667">Če želite kar najbolje izkoristiti Jatter, upoštevajte ta predlagana dejanja.</translation>
<translation id="1185134272377778587">O Jatteru</translation>
<translation id="1211450393895337634">Hitreje odprite Jatter, ko ste pripravljeni na brskanje v iPadu.</translation>
<translation id="1229234641991056119">Uporabljajte gesla, zgodovino, zaznamke in kreditne kartice iz Safarija v Jatteru</translation>
<translation id="1257458525759135959">Če želite shraniti slike, se dotaknite aplikacije Settings in dovolite, da Jatter dodaja fotografijam</translation>
<translation id="1260702988262336471">Odpiranje Jatterovega menija</translation>
<translation id="12739128458173458">Če želite ta zavihek poslati v drugo napravo, se v obeh napravah prijavite v Jatter.</translation>
<translation id="1361748954329991663">Jatter je zastarel. Če v trgovini <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> ni na voljo nobene posodobitve, vaša naprava morda ne podpira več novih različic Jattera.</translation>
<translation id="1383876407941801731">Išči</translation>
<translation id="1423007117030725713">Začnite iskanje na novem Jatterovem zavihku.</translation>
<translation id="1431818719585918472">Naj Jatter zaklene anonimne zavihke.</translation>
<translation id="1451665391191990528">Skrij odprte anonimne zavihke, ko zaprete Jatter</translation>
<translation id="146407871188825689">V iPadu privzeto uporabljajte Jatter</translation>
<translation id="1471084500615228555">Brisanje podatkov brskanja v Jatteru</translation>
<translation id="1472013873724362412">Vaš račun ne deluje v Jatteru. Obrnite se na skrbnika domene ali za prijavo uporabite običajen Google Račun.</translation>
<translation id="148576268809812097">Shranjevanje gesel v Jatteru</translation>
<translation id="1501302548410882220">Uporaba Jattera povsod</translation>
<translation id="1502360822835740515">Nastavitev Jattera kot privzetega brskalnika</translation>
<translation id="1503199973012840174">Vaš Jatter je zastarel. Posodobite ga, da ostanete varni.</translation>
<translation id="1515748263297244785">Privzeto uporabljajte Jatter za iPad</translation>
<translation id="1531155317299575425">Pokaže pozive za prijavo v Jatter.</translation>
<translation id="1553657876656159572">Vir po meri, ustvarjen za vas. Vključuje novice, šport in vreme.</translation>
<translation id="1561849081734670621">Če želite onemogočiti način zaklepa v Jatteru, ga izklopite v iPhonu.</translation>
<translation id="1569258826720962327">Uporaba dejanj v Jatteru za iOS</translation>
<translation id="1573441572176948907">Premaknite Jatter v vrstico Dock</translation>
<translation id="159029779861043703">Jatter zagotavlja varnost občutljivih podatkov s funkcijo Face ID.</translation>
<translation id="1591119736686995611">Odpiranje mreže zavihkov v Jatteru.</translation>
<translation id="16001233025397167">Varnostno preverjanje vas varuje pred podatkovnimi kršitvami, spletnimi mesti, ki niso varna, in drugim. Prejemajte opozorila o težavah z zasebnostjo ali varnostjo, ki jih Jatter zazna.</translation>
<translation id="1617663976202781617">Podatki iz sinhronizacije za Jatter</translation>
<translation id="164952285225495380">Temu paketu že sledite v Jatteru.</translation>
<translation id="1707458603865303524">Jatter lahko uporabljate, kadar koli se dotaknete povezav v sporočilih ali drugih aplikacijah.</translation>
<translation id="1722370509450468186">Geslo bo shranjeno v računu (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Vir po meri, ustvarjen za vas</translation>
<translation id="1811860791247653035">Če želite uporabljati osebno prilagajanje in druge funkcije, vključite Jatter v <ph name="FEATURE_NAME_1" /> in <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Jatter je preveril, ali je izdajatelj <ph name="ISSUER" /> izdal potrdilo tega spletnega mesta.</translation>
<translation id="1839447949248872139">Privzeto odpiranje povezav v Jatteru</translation>
<translation id="1843424232666537147">Jatter ima funkcije, s katerimi lažje upravljate internetne podatke in hitrost nalaganja spletnih strani.
<ph name="BEGIN_LINK" />Več o tem<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Google Zemljevidi v Jatteru</translation>
<translation id="1867772173333403444">4. Izberite Jatter.</translation>
<translation id="1965068424387304464">Nasvet za Jatter: Shranite gesla</translation>
<translation id="2006345422933397527">Jatter ni mogel preveriti, ali so na voljo posodobitve. Poskusite preveriti internetno povezavo.</translation>
<translation id="2042889939382983733">Ogled zgodovine v Jatteru</translation>
<translation id="2052320862053429062">Jatter občasno preveri vaša gesla, tako da jih primerja s seznami gesel, objavljenimi v spletu. Pri tem so vaša gesla in uporabniška imena šifrirana, da jih ne more prebrati nihče, vključno z Googlom.</translation>
<translation id="2059365270911640413">Dokončajte nastavitev Jattera</translation>
<translation id="2168108852149185974">Nekateri dodatki povzročajo zrušitve Jattera. Odstranite jih:</translation>
<translation id="2168593389981132306">Izboljšajte Jatter</translation>
<translation id="2178608107313874732">Jatter trenutno ne more uporabljati fotoaparata</translation>
<translation id="2195025571279539885">Želite, da Jatter naslednjič ponudi prevod strani v jeziku <ph name="LANGUAGE_NAME" /> s tega spletnega mesta?</translation>
<translation id="22313767259766852">Ta naslov je trenutno shranjen v Jatteru. Če ga želite uporabiti v Googlovih izdelkih, ga shranite v računu Google (<ph name="USER_EMAIL" />).</translation>
<translation id="2236584955986023187">To pomeni, da bo Jatter vsakič zahteval spletno mesto za namizne naprave.</translation>
<translation id="2245694534483711162">Gemini lahko uporablja vašo natančno lokacijo, in sicer odvisno od dovoljenja, ki ste ga že dali Jatteru</translation>
<translation id="2270466829363945454">Trgovina</translation>
<translation id="2313870531055795960">Preveri URL-je, tako da jih primerja s seznamom spletnih mest, ki niso varna, shranjenim v Jatteru. Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko Jatter prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="2314220608288760290">Jatter samodejno odpre povezave v anonimnem načinu v YouTubu v anonimnem načinu.</translation>
<translation id="231828342043114302">Če želite prejemati osebno prilagojeno vsebino glede na zanimanja, se prijavite v Jatter.</translation>
<translation id="2326738825692478496">Nekateri podatki v Jatteru še niso shranjeni v računu Google.

Počakajte nekaj minut, preden se odjavite. Če se odjavite zdaj, bodo ti podatki izbrisani.</translation>
<translation id="2337722506862731008">Deljenje Jattera</translation>
<translation id="2340423701577464731">Dodajanje elementa bralnega seznama v Jatteru</translation>
<translation id="2374627437126809292">Jatter z uporabo Google Zemljevidov prikazuje navodila za pot in lokalne podatke o zaznanih naslovih.</translation>
<translation id="2386292341327187942">V polje »Pripomočki za iskanje« vnesite Jatter</translation>
<translation id="2389827884654658221">Hitreje dostopajte do Jattera na začetnem zaslonu iPada.</translation>
<translation id="2426113998523353159">Vaša organizacija zahteva, da se za uporabo Jattera prijavite.</translation>
<translation id="2450140762465183767">Zdaj lahko uporabljate Jatter, kadar koli se dotaknete povezav v sporočilih, dokumentih in drugih aplikacijah.</translation>
<translation id="2459183986985456602">Odpiranje zadnjega zavihka v Jatteru.</translation>
<translation id="2476409803017965813">Izbire lahko kadar koli posodobite v nastavitvah za Jatter.</translation>
<translation id="2478931088402984578">Izberite <ph name="BEGIN_BOLD" />Jatter<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Nastavite Jatter kot privzeti brskalnik, če želite preprosto deliti in odpirati povezave</translation>
<translation id="2512597191798760956">Pridržite ikono Jattera in kliknite »Uredi začetni zaslon«</translation>
<translation id="2517624234762908348">Sinhroniziranje podatkov v Jatteru</translation>
<translation id="2575968074225731646">Hitreje dostopajte do Jattera iz vrstice Dock v iPhonu.</translation>
<translation id="2592940277904433508">Še naprej uporabljaj Jatter</translation>
<translation id="2607609479243848905">Če ste pozabili geslo ali želite to nastavitev spremeniti, <ph name="BEGIN_LINK" />izbrišite podatke iz Jattera v računu<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Nasvet za Jatter: Iščite, kar vidite, z Googlom Lens</translation>
<translation id="2650312721222849884">Če si želite ogledati zavihke iz naprav, v katerih uporabljate Jatter, vklopite sinhronizacijo</translation>
<translation id="2684230048001240293">Nastavite Jatter kot privzeto možnost sinhroniziranja zavihkov, gesel in podatkov za plačilo v vseh napravah.</translation>
<translation id="2729836253097154631">Prijavite se v Jatter, če želite dostopati do svojih stvari</translation>
<translation id="2730884209570016437">Jatter ne more uporabljati fotoaparata, ker ga uporablja druga aplikacija</translation>
<translation id="2742952311155593352">Skoraj ste končali nastavljanje Jattera.</translation>
<translation id="2798503587425057129">Odpre bralni seznam v Jatteru.</translation>
<translation id="28276745681323897">V računu Google lahko <ph name="BEGIN_LINK" />upravljate, kateri podatki v Jatteru se shranjujejo<ph name="END_LINK" />.

Če želite več nastavitev, ki zaradi izboljšanja izkušnje v Jatteru uporabljajo podatke, odprite <ph name="BEGIN_LINK" />Googlove storitve<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Iskanje z govorom v Jatteru.</translation>
<translation id="2843571538056574338">Uporaba Jattera za samodejno izpolnjevanje</translation>
<translation id="2918709798697875261">Vaša organizacija zahteva, da niste prijavljeni v Jatter.</translation>
<translation id="2942241131342758843">Uporabljajte Jatter kot privzeto možnost odpiranja povezav, iskanja v pripomočkih in samodejnega izpolnjevanja gesel v drugih aplikacijah.</translation>
<translation id="2977470724722393594">Jatter je posodobljen</translation>
<translation id="3044857325852340337">Izbrisani podatki v Jatteru</translation>
<translation id="3054480780637153380">V sistemu iOS odprite nastavitve za Jatter, nato se dotaknite »Privzeti brskalnik« in izberite Jatter.</translation>
<translation id="3115956258722352278">Želite nastaviti Jatter kot privzeti brskalnik?</translation>
<translation id="3180939591219927904">Vklopite »Zaklepanje anonimnih zavihkov po zaprtju Jattera«</translation>
<translation id="328933489847748230">{count,plural, =1{Prikazano je 1 okno Jattera}one{Prikazano je {count} okno Jattera}two{Prikazani sta {count} okni Jattera}few{Prikazana so {count} okna Jattera}other{Prikazanih je {count} oken Jattera}}</translation>
<translation id="3344973607274501920">Jatteru ni uspelo preveriti vaših gesel. Poskusite preveriti internetno povezavo.</translation>
<translation id="3366305173356742781">Podatki v Jatteru v vašem računu</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{To se zgodi, če Jattera ne uporabljate {THRESHOLD} minuto. To lahko vključuje zgodovino in samodejno izpolnjevanje.}one{To se zgodi, če Jattera ne uporabljate {THRESHOLD} minuto. To lahko vključuje zgodovino in samodejno izpolnjevanje.}two{To se zgodi, če Jattera ne uporabljate {THRESHOLD} minuti. To lahko vključuje zgodovino in samodejno izpolnjevanje.}few{To se zgodi, če Jattera ne uporabljate {THRESHOLD} minute. To lahko vključuje zgodovino in samodejno izpolnjevanje.}other{To se zgodi, če Jattera ne uporabljate {THRESHOLD} minut. To lahko vključuje zgodovino in samodejno izpolnjevanje.}}</translation>
<translation id="3410395242749598859">Nekateri podatki v Jatteru še niso shranjeni v računu <ph name="EMAIL" />.
Počakajte nekaj minut, preden preklopite račun. Če zdaj preklopite med računoma, bodo ti podatki izbrisani.</translation>
<translation id="3420586870838853527">Nasvet za Jatter: Izboljšano varno brskanje vam bo pomagalo, da se zaščitite</translation>
<translation id="3440830787838130530">Preprosto in varno delite kopijo gesla s skupino družinskih članov v Googlovem upravitelju gesel</translation>
<translation id="3472200483164753384">Ni podprto v Jatteru Canary</translation>
<translation id="347967311580159871">Če želite več nastavitev, ki zaradi izboljšanja izkušnje v Jatteru uporabljajo podatke, odprite <ph name="BEGIN_LINK" />Googlove storitve<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Geslo ni bilo deljeno. Preverite internetno povezavo in se prepričajte, ali ste prijavljeni v Jatter. Nato poskusite znova.</translation>
<translation id="3529798650269984835">Vklopite možnost »Zaklepanje anonimnih zavihkov po zaprtju Jattera«.</translation>
<translation id="3541247799006476453">Preprosto dostopajte do gesel in ključev s samodejnim izpolnjevanjem prek Jattera</translation>
<translation id="3567399274263440288">Če želite kar najbolje izkoristiti Jatter, se prijavite vanj z računom Google.</translation>
<translation id="3581385059720151202">Slikovno iskanje v Jatteru</translation>
<translation id="3582640969619785896">Jatter bo ponudil shranjevanje gesla</translation>
<translation id="3594315078412605236">Upravljanje plačilnih sredstev v Jatteru</translation>
<translation id="3617143087229977194">V sistemu iOS odprite nastavitve privzetih aplikacij, dotaknite se »Browser App« (brskalnik) in izberite Jatter.</translation>
<translation id="3634039384458740619">Odprite nastavitve za Jatter</translation>
<translation id="3639997914391704523">Jatter lahko preveri vaša gesla, ko se prijavite z računom Google.</translation>
<translation id="372658070733623520">Če želite v računu Google uporabljati in shranjevati podatke iz Jattera, potrdite, da ste to vi.</translation>
<translation id="3728124580182886854">Povežite Jatter in druge Googlove storitve za osebno prilagajanje in druge namene</translation>
<translation id="377649297473651452">Razširjen pogled samodejnega izpolnjevanja v Jatteru</translation>
<translation id="3780779443901618967">Opozori vas o nevarnih spletnih mestih, celo tistih, za katere Google prej ni vedel, in sicer tako, da analizira več podatkov s spletnih mest kot standardna zaščita. Izberete lahko, da preskočite opozorila za Jatter.</translation>
<translation id="3805899903892079518">Jatter nima dostopa do fotografij ali videoposnetkov. Omogočite dostop v sistemu iOS: Settings &gt; Privacy &gt; Photos.</translation>
<translation id="3816686541346279443">Jatter bo ponudil shranjevanje gesla.</translation>
<translation id="3827545470516145620">V tej napravi uporabljate standardno varnostno zaščito</translation>
<translation id="3833326979834193417">Jatter vsak dan samodejno izvede varnostno preverjanje, da vas varuje pred podatkovnimi kršitvami, spletnimi mesti, ki niso varna, in drugim. Več o varnostnem preverjanju lahko preberete v nastavitvah.</translation>
<translation id="3837584850181228767">Nasvet za Jatter: Izboljšano varno brskanje</translation>
<translation id="3845223911364528001">Vrnite se v Jatter, če želite naložiti datoteko</translation>
<translation id="3855938650519180865">Novosti v Jatteru</translation>
<translation id="3886689467633467988">Prijavite se na tem spletnem mestu in v Jatteru, če želite dostopati do zaznamkov in drugega v vseh napravah.</translation>
<translation id="3949514465204582407">Nasvet za Jatter: Dostopajte do gesel v poljubni aplikaciji</translation>
<translation id="4005283307739974863">Odpre in izvede varnostno preverjanje v Jatteru.</translation>
<translation id="4043291146360695975">Gesla so shranjena v upravitelju gesel samo v tej napravi.</translation>
<translation id="4066426933127344530">Privzeto uporabljajte Jatter</translation>
<translation id="4087314024407094071">V Jatteru odpre nastavitve.</translation>
<translation id="4099085513035183040">Ni podprto v Jatteru Beta</translation>
<translation id="4106512142782407609">Prijavljeni ste kot <ph name="EMAIL" />.

Podatki so šifrirani z vašim geslom. Vnesite ga, če želite podatke iz Jattera uporabljati in shranjevati v računu Google.</translation>
<translation id="4118287192800900567">Nasvet za Jatter: Prijavite se v Jatter</translation>
<translation id="4195557071150719219">Ogled nedavnih zavihkov v Jatteru</translation>
<translation id="420541179527342563">Če želite onemogočiti način zaklepa v Jatteru, ga izklopite v iPadu.</translation>
<translation id="4272892696084633551">Pomagajte izboljšati funkcije in delovanje Jattera</translation>
<translation id="4302397443352897529">Nastavitve za Jatter</translation>
<translation id="4408912345039114853">Zagon varnostnega preverjanja v Jatteru</translation>
<translation id="4432744876818348753">Prijavite se, če želite čim bolje izkoristiti Jatter.</translation>
<translation id="4445228361214254027">Vaša organizacija je izklopila možnost uporabe in shranjevanja podatkov v Jatteru v računu Google. Novi zaznamki, gesla in drugo bodo shranjeni samo v tej napravi.</translation>
<translation id="4498832288620833153">Doda vnesene URL-je na bralni seznam v Jatteru.</translation>
<translation id="4508268628669724828">Tukaj si lahko ogledate več uporabnih nasvetov o tem, kako najbolje izkoristiti Jatter.</translation>
<translation id="452436063477828504">Poskrbite, da boste v računu Google vedno lahko uporabljali podatke v Jatteru</translation>
<translation id="4527452566931097835">Želite nastaviti Jatter kot privzeto možnost?</translation>
<translation id="4555020257205549924">Kadar je vklopljena ta funkcija, bo Jatter ponudil, da z uporabo Google Prevajalnika prevede strani v drugih jezikih. <ph name="BEGIN_LINK" />Več o tem<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Šifriranje gesla ne vključuje plačilnih sredstev in naslovov.

Če želite spremeniti to nastavitev, <ph name="BEGIN_LINK" />izbrišite podatke iz Jattera v računu<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Nasvet za Jatter: Privzeto uporabljajte Jatter</translation>
<translation id="458786853569524949">Zdaj lahko uporabljate Jatter, kadar koli se dotaknete povezav v e-poštnih sporočilih, dokumentih in drugih aplikacijah.</translation>
<translation id="4633738821577273991">Zagotovite si izboljšano varno brskanje tudi za ta profil v Jatteru.</translation>
<translation id="4654936625574199632">Zaradi izboljšanja aplikacije Jatter Googlu pošlje poročila o uporabi in zrušitvah. <ph name="BEGIN_LINK" />Upravljanje<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Vklopite optični bralnik Jatter</translation>
<translation id="4685611756167369067">Odpiranje anonimnega zavihka v Jatteru</translation>
<translation id="4736424910885271643">Vaš račun upravlja domena <ph name="HOSTED_DOMAIN" />, zato bodo podatki v Jatteru izbrisani iz te naprave.</translation>
<translation id="4790638144988730920">Še naprej uporabljajte podatke v Jatteru v računu Google.</translation>
<translation id="4828317641996116749">Jatteru ni uspelo preveriti vseh gesel. Poskusite znova pozneje.</translation>
<translation id="4856138222358683580">Dejanja v Jatteru</translation>
<translation id="4904452304169763785">Opozorila o težavah z zasebnostjo ali varnostjo, ki jih Jatter zazna.</translation>
<translation id="4908570938463711775">Osvojite uporabne osnove za Jatter in začnite</translation>
<translation id="4962295957157529683">Končajte, kar ste počeli v drugem odprtem oknu v Jatteru.</translation>
<translation id="4985291216379576555">Jatter brez povezave ne more preveriti, ali so na voljo posodobitve</translation>
<translation id="4996471330284142407">Opravite več s preprostim in varnim Jatterom, ki je hitrejši kot kdaj prej.</translation>
<translation id="4999538639245140991">Ker se boste odjavili iz računa, ki ga upravlja <ph name="SIGNOUT_MANAGED_DOMAIN" />, boste iz te naprave izbrisali podatke v Jatteru. Vaši podatki bodo še vedno na voljo v Google Računu.</translation>
<translation id="5042011327527167688">Dotaknite se možnosti »View with Google Maps on Jatter« (Ogled z Google Zemljevidi v Jatteru).</translation>
<translation id="5044871537677053278">Jatter zaznava naslove ter z uporabo Google Zemljevidov prikazuje navodila za pot in lokalne informacije.</translation>
<translation id="5048140766121299007">V nastavitvah »<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />« vklopite »Jatter«</translation>
<translation id="5053429694249468757">Brisanje podatkov v Jatteru …</translation>
<translation id="5071749685031362629">Jatter za iOS</translation>
<translation id="5124429847818367226">Zdaj lahko uporabljate Jatter, kadar koli brskate po povezavah ali se jih dotaknete v sporočilih, dokumentih in drugih aplikacijah.</translation>
