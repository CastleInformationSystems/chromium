<translation id="1000436330784933699">Ovde možete da otvorite Objektiv.</translation>
<translation id="1042296835509784301">Otvara Menadžer lozinki u Jatter-u.</translation>
<translation id="1047130070405668746">Izaberite Jatter</translation>
<translation id="1091252999271033193">To znači da će Jatter svaki put zahtevati mobilni sajt.</translation>
<translation id="1115463765356382667">Obavite ove predložene radnje u nastavku da biste iskoristili Jatter na najbolji način.</translation>
<translation id="1185134272377778587">O Jatter-u</translation>
<translation id="1211450393895337634">Brže otvarajte Jatter kada budete spremni da pregledate na iPad-u.</translation>
<translation id="1229234641991056119">Koristite Safari lozinke, istoriju, obeleživače i kreditne kartice u Jatter-u</translation>
<translation id="1257458525759135959">Da biste sačuvali slike, dodirnite Podešavanja da biste omogućili Jatter-u da dodaje slike</translation>
<translation id="1260702988262336471">Otvorite Jatter meni</translation>
<translation id="12739128458173458">Da biste poslali ovu karticu na drugi uređaj, prijavite se u Jatter na oba uređaja.</translation>
<translation id="1361748954329991663">Jatter je zastareo. Ako ažuriranje nije dostupno u <ph name="BEGIN_LINK" />App Store-u<ph name="END_LINK" />, uređaj možda ne podržava nove verzije Jatter-a.</translation>
<translation id="1383876407941801731">Pretraži</translation>
<translation id="1423007117030725713">Započnite pretragu na novoj Jatter kartici.</translation>
<translation id="1431818719585918472">Dozvolite Jatter-u da zaključa kartice bez arhiviranja.</translation>
<translation id="1451665391191990528">Sakrij otvorene kartice bez arhiviranja kada napustite Jatter</translation>
<translation id="146407871188825689">Podrazumevano koristite Jatter na iPad-u</translation>
<translation id="1471084500615228555">Brisanje podataka pregledanja u Jatter-u</translation>
<translation id="1472013873724362412">Nalog ne funkcioniše na Jatter-u. Kontaktirajte administratora domena ili se prijavite pomoću običnog Google naloga.</translation>
<translation id="148576268809812097">Sačuvajte lozinke u Jatter-u</translation>
<translation id="1501302548410882220">Koristite Jatter svuda</translation>
<translation id="1502360822835740515">Podesite Jatter za podrazumevani pregledač</translation>
<translation id="1503199973012840174">Jatter je zastareo. Ažurirajte ga da biste bili bezbedni.</translation>
<translation id="1515748263297244785">Podrazumevano koristite Jatter za iPad</translation>
<translation id="1531155317299575425">Prikazuje upite za prijavljivanje u Jatter.</translation>
<translation id="1553657876656159572">Prilagođeni fid napravljen za vas. Uključujući vesti, sport i vreme.</translation>
<translation id="1561849081734670621">Da biste onemogućili režim zaključavanja u Jatter-u, isključite ga na iPhone-u.</translation>
<translation id="1569258826720962327">Koristite Jatter radnje na iOS-u</translation>
<translation id="1573441572176948907">Premestite Jatter na traku s aplikacijama</translation>
<translation id="159029779861043703">Jatter štiti osetljive podatke pomoću Face ID-a.</translation>
<translation id="1591119736686995611">Otvara mrežu Jatter kartica.</translation>
<translation id="16001233025397167">Provera bezbednosti vas štiti od povrede podataka, nebezbednih veb-sajtova i drugog. Primajte obaveštenja o svim problemima u vezi sa privatnošću ili bezbednošću koje Jatter otkrije za vas.</translation>
<translation id="1617663976202781617">Podaci iz Jatter sinhronizacije</translation>
<translation id="164952285225495380">Ovaj paket se već prati u Jatter-u.</translation>
<translation id="1707458603865303524">Koristite Jatter svaki put kada dodirnete linkove u porukama i drugim aplikacijama.</translation>
<translation id="1722370509450468186">Lozinka se čuva na vašem nalogu (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Prilagođeni fid napravljen za vas</translation>
<translation id="1811860791247653035">Da biste dobili personalizaciju i druge funkcije, uvrstite Jatter u: <ph name="FEATURE_NAME_1" /> i <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Jatter je potvrdio da je <ph name="ISSUER" /> izdao sertifikat ovog veb-sajta.</translation>
<translation id="1839447949248872139">Podrazumevano otvarajte linkove u Jatter-u</translation>
<translation id="1843424232666537147">Jatter ima funkcije koje vam pomažu da upravljate internet podacima i brzinom učitavanja veb-stranica.
<ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Mape u Jatter-u</translation>
<translation id="1867772173333403444">4. Izaberite Jatter</translation>
<translation id="1965068424387304464">Napomena za Jatter: Sačuvajte lozinke</translation>
<translation id="2006345422933397527">Jatter ne može da traži ažuriranja. Proverite internet vezu.</translation>
<translation id="2042889939382983733">Pregledajte Jatter istoriju</translation>
<translation id="2052320862053429062">Jatter povremeno upoređuje vaše lozinke sa listama koje su objavljene onlajn. Dok to radi, vaše lozinke i korisnička imena su šifrovani, pa niko ne može da ih pročita, uključujući Google.</translation>
<translation id="2059365270911640413">Dovršite podešavanje Jatter-a</translation>
<translation id="2168108852149185974">Neki programski dodaci izazivaju otkazivanje Jatter-a. Deinstalirajte:</translation>
<translation id="2168593389981132306">Poboljšajte Jatter</translation>
<translation id="2178608107313874732">Jatter trenutno ne može da koristi kameru</translation>
<translation id="2195025571279539885">Želite li da Jatter sledeći put ponudi da prevede stranice sa ovog sajta čiji je jezik <ph name="LANGUAGE_NAME" />?</translation>
<translation id="22313767259766852">Ova adresa je trenutno sačuvana u Jatter-u. Da biste je koristili u svim Google proizvodima, sačuvajte je na Google nalogu, <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">To znači da će Jatter svaki put zahtevati sajt za računar.</translation>
<translation id="2245694534483711162">Gemini može da koristi preciznu lokaciju, u zavisnosti od dozvole koju ste već dali Jatter-u</translation>
<translation id="2270466829363945454">Kupujte</translation>
<translation id="2313870531055795960">Proverava URL-ove sa listom nebezbednih sajtova koji se čuvaju u Jatter-u. Ako neki sajt pokuša da ukrade vašu lozinku ili probate da preuzmete štetnu datoteku, Jatter može da pošalje URL-ove, uključujući delove sadržaja stranice, u Bezbedno pregledanje.</translation>
<translation id="2314220608288760290">Jatter automatski otvara YouTube linkove bez arhiviranja u režimu bez arhiviranja.</translation>
<translation id="231828342043114302">Da biste dobijali personalizovani sadržaj na osnovu interesovanja, prijavite se u Jatter.</translation>
<translation id="2326738825692478496">Neki Jatter podaci još nisu sačuvani na Google nalogu.

Sačekajte nekoliko minuta pre nego što se odjavite. Ako se odjavite odmah, ovi podaci će biti izbrisani.</translation>
<translation id="2337722506862731008">Deli Jatter</translation>
<translation id="2340423701577464731">Dodavanje stavke liste za čitanje u Jatter</translation>
<translation id="2374627437126809292">Jatter koristi Google mape da bi vam pružao putanju i lokalne informacije o otkrivenim adresama.</translation>
<translation id="2386292341327187942">U okvir Pretražite vidžete unesite Jatter</translation>
<translation id="2389827884654658221">Brže pristupajte Jatter-u sa početnog ekrana iPad-a.</translation>
<translation id="2426113998523353159">Organizacija zahteva da se prijavite da biste koristili Jatter.</translation>
<translation id="2450140762465183767">Sada možete da koristite Jatter svaki put kada dodirnete linkove u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="2459183986985456602">Otvorite svoju najnoviju karticu u Jatter-u.</translation>
<translation id="2476409803017965813">Uvek možete da ažurirate izabrane opcije u podešavanjima Jatter-a.</translation>
<translation id="2478931088402984578">Izaberite <ph name="BEGIN_BOLD" />Jatter<ph name="END_BOLD" />.</translation>
<translation id="2485774047568879945">Podesite Jatter kao podrazumevani pregledač da biste lako delili i otvarali linkove</translation>
<translation id="2512597191798760956">Pritisnite i zadržite ikonu Jatter-a, pa kliknite na Izmenite početni ekran</translation>
<translation id="2517624234762908348">Sinhronizuj Jatter podatke</translation>
<translation id="2575968074225731646">Brže pristupajte Jatter-u sa trake s aplikacijama na iPhone-u.</translation>
<translation id="2592940277904433508">Nastavi sa korišćenjem Jatter-a</translation>
<translation id="2607609479243848905">Ako ste zaboravili pristupnu frazu ili želite da promenite ovo podešavanje, <ph name="BEGIN_LINK" />izbrišite Jatter podatke na nalogu<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Savet za Jatter: Pretražujte ono što vidite pomoću Google objektiva</translation>
<translation id="2650312721222849884">Da biste videli kartice na bilo kojem uređaju na kom koristite Jatter, uključite sinhronizaciju</translation>
<translation id="2684230048001240293">Podesite Jatter kao podrazumevanu aplikaciju za sinhronizovanje kartica, lozinki i informacija o plaćanju na svim uređajima</translation>
<translation id="2729836253097154631">Prijavite se u Jatter da biste preuzeli sadržaj</translation>
<translation id="2730884209570016437">Jatter ne može da koristi kameru zato što je već koristi druga aplikacija</translation>
<translation id="2742952311155593352">Još malo i završićete podešavanje Jatter-a.</translation>
<translation id="2798503587425057129">Otvara Jatter listu za čitanje.</translation>
<translation id="28276745681323897">Možete da <ph name="BEGIN_LINK" />upravljate time koji Jatter podaci se čuvaju<ph name="END_LINK" /> na Google nalogu.

Još podešavanja koja koriste podatke za poboljšanje doživljaja Jatter-a potražite u <ph name="BEGIN_LINK" />Google uslugama<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Pretražujte glasom u Jatter-u.</translation>
<translation id="2843571538056574338">Koristite Jatter za automatsko popunjavanje</translation>
<translation id="2918709798697875261">Organizacija zahteva da ostanete odjavljeni sa Jatter-a.</translation>
<translation id="2942241131342758843">Podrazumevano koristite Jatter da biste otvarali linkove, pretraživali iz vidžeta i automatski popunjavali lozinke u drugim aplikacijama</translation>
<translation id="2977470724722393594">Jatter je ažuriran</translation>
<translation id="3044857325852340337">Jatter podaci su izbrisani</translation>
<translation id="3054480780637153380">Otvorite podešavanja Jatter-a u iOS-u, pa dodirnite Default Browser App (Podrazumevana aplikacija za pregledač) i izaberite Jatter.</translation>
<translation id="3115956258722352278">Želite da podesite Jatter za podrazumevani pregledač?</translation>
<translation id="3180939591219927904">Uključite Zaključaj kartice bez arhiviranja posle zatvaranja Jatter-a</translation>
<translation id="328933489847748230">{count,plural, =1{Sada se prikazuje 1 Jatter prozor}one{Sada se prikazuje {count} Jatter prozor}few{Sada se prikazuju {count} Jatter prozora}other{Sada se prikazuje {count} Jatter prozora}}</translation>
<translation id="3344973607274501920">Jatter nije uspeo da vam proveri lozinke. Proverite internet vezu.</translation>
<translation id="3366305173356742781">Jatter podaci na nalogu</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{To se dešava kada se Jatter ne koristi {THRESHOLD} minut. To može da obuhvata istoriju i automatsko popunjavanje.}one{To se dešava kada se Jatter ne koristi {THRESHOLD} minut. To može da obuhvata istoriju i automatsko popunjavanje.}few{To se dešava kada se Jatter ne koristi {THRESHOLD} minuta. To može da obuhvata istoriju i automatsko popunjavanje.}other{To se dešava kada se Jatter ne koristi {THRESHOLD} minuta. To može da obuhvata istoriju i automatsko popunjavanje.}}</translation>
<translation id="3410395242749598859">Neki Jatter podaci još nisu sačuvani na nalogu <ph name="EMAIL" />.
Sačekajte nekoliko minuta pre nego što promenite nalog. Ako sada promenite nalog, ovi podaci će se izbrisati.</translation>
<translation id="3420586870838853527">Savet za Jatter: Poboljšano bezbedno pregledanje će vam uštedeti mnogo vremena</translation>
<translation id="3440830787838130530">Lako i bezbedno delite kopiju lozinke sa grupom za porodicu u Google menadžeru lozinki</translation>
<translation id="3472200483164753384">Nije podržano u verziji Jatter Canary</translation>
<translation id="347967311580159871">Više podešavanja koja koriste podatke za poboljšanje doživljaja Jatter-a potražite u <ph name="BEGIN_LINK" />Google uslugama<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Lozinka se ne deli. Proverite internet vezu i uverite se da ste prijavljeni u Jatter. Onda probajte ponovo.</translation>
<translation id="3529798650269984835">Uključite Zaključaj kartice bez arhiviranja posle zatvaranja Jatter-a.</translation>
<translation id="3541247799006476453">Lako pristupajte lozinkama i pristupnim ključevima pomoću Jatter-a za automatsko popunjavanje</translation>
<translation id="3567399274263440288">Da biste koristili Jatter na najbolji način, prijavite se na Jatter pomoću Google naloga.</translation>
<translation id="3581385059720151202">Pretraživanje vizuelnog materijala u Jatter-u</translation>
<translation id="3582640969619785896">Jatter će vam ponuditi da sačuva lozinku</translation>
<translation id="3594315078412605236">Upravljanje načinima plaćanja u Jatter-u</translation>
<translation id="3617143087229977194">Otvorite podešavanja podrazumevanih aplikacija u iOS-u, pa dodirnite Browser App (Aplikacija pregledača) i izaberite Jatter.</translation>
<translation id="3634039384458740619">Otvori podešavanja Jatter-a</translation>
<translation id="3639997914391704523">Jatter može da vam proverava lozinke kada se prijavite pomoću Google naloga.</translation>
<translation id="372658070733623520">Da biste koristili i čuvali Jatter podatke na Google nalogu, potvrdite svoj identitet.</translation>
<translation id="3728124580182886854">Povežite Jatter i druge Google usluge radi personalizacije i drugih svrha</translation>
<translation id="377649297473651452">Prošireni prikaz Jatter automatskog popunjavanja</translation>
<translation id="3780779443901618967">Upozorava vas na opasne sajtove, čak i na one za koje Google ranije nije znao, analizirajući više podataka sa sajtova nego standardna zaštita. Možete da izaberete da preskočite upozorenja Jatter-a.</translation>
<translation id="3805899903892079518">Jatter ne može da pristupa slikama ili videima. Omogućite pristup u iOS Settings (Podešavanja iOS-a) &gt; Privacy (Privatnost) &gt; Photos (Slike).</translation>
<translation id="3816686541346279443">Jatter će vam ponuditi da sačuva lozinku.</translation>
<translation id="3827545470516145620">Dobijate standardnu bezbednosnu zaštitu na ovom uređaju</translation>
<translation id="3833326979834193417">Jatter automatski pokreće Proveru bezbednosti svakog dana da bi vas zaštitio od povrede podataka, nebezbednih veb-sajtova i drugog. Više o Proveri bezbednosti možete da pronađete u Podešavanjima.</translation>
<translation id="3837584850181228767">Napomena za Jatter: Poboljšano bezbedno pregledanje</translation>
<translation id="3845223911364528001">Vratite se u Jatter da biste otpremili fajl</translation>
<translation id="3855938650519180865">Šta je novo u Jatter-u</translation>
<translation id="3886689467633467988">Prijavite se na ovaj sajt i u Jatter da bi vam obeleživači i drugi sadržaj bili dostupni na svim uređajima.</translation>
<translation id="3949514465204582407">Savet za Jatter: Pristupajte lozinkama u bilo kojoj aplikaciji</translation>
<translation id="4005283307739974863">Otvara i pokreće Proveru bezbednosti u Jatter-u.</translation>
<translation id="4043291146360695975">Lozinke se čuvaju u Menadžeru lozinki samo na ovom uređaju.</translation>
<translation id="4066426933127344530">Podrazumevano koristi Jatter</translation>
<translation id="4087314024407094071">Otvara Podešavanja u Jatter-u.</translation>
<translation id="4099085513035183040">Nije podržano u verziji Jatter beta</translation>
<translation id="4106512142782407609">Prijavljeni ste kao <ph name="EMAIL" />.

Podaci se šifruju pomoću pristupne fraze. Unesite je da biste koristili i sačuvali Jatter podatke na Google nalogu.</translation>
<translation id="4118287192800900567">Savet za Jatter: Prijavite se u Jatter</translation>
<translation id="4195557071150719219">Pogledajte nedavne kartice Jatter-a</translation>
<translation id="420541179527342563">Da biste onemogućili režim zaključavanja u Jatter-u, isključite ga na iPad-u.</translation>
<translation id="4272892696084633551">Pomozite nam da poboljšamo Jatter-ove funkcije i učinak</translation>
<translation id="4302397443352897529">Podešavanja Jatter-a</translation>
<translation id="4408912345039114853">Pokreni Jatter proveru bezbednosti</translation>
<translation id="4432744876818348753">Prijavite se da biste iskoristili Jatter na najbolji način.</translation>
<translation id="4445228361214254027">Organizacija je isključila mogućnost korišćenja i čuvanja Jatter podataka na Google nalogu. Novi obeleživači, lozinke i drugi sadržaj će se čuvati samo na ovom uređaju.</translation>
<translation id="4498832288620833153">Dodaje unete URL-ove na listu za čitanje u Jatter-u.</translation>
<translation id="4508268628669724828">Vratite se ovde za još korisnih saveta o tome kako da iskoristite Jatter na najbolji način.</translation>
<translation id="452436063477828504">Uverite se da uvek možete da koristite Jatter podatke na Google nalogu</translation>
<translation id="4527452566931097835">Želite da podesite Jatter kao podrazumevani pregledač?</translation>
<translation id="4555020257205549924">Kada je ova funkcija uključena, Jatter će nuditi da prevodi stranice napisane na drugim jezicima pomoću Google prevodioca. <ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Šifrovanje pomoću pristupne fraze ne obuhvata načine plaćanja i adrese.

Da biste promenili ovo podešavanje, <ph name="BEGIN_LINK" />izbrišite Jatter podatke na nalogu<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Jatter savet: Podrazumevano koristite Jatter</translation>
<translation id="458786853569524949">Sada možete da koristite Jatter svaki put kada dodirnete linkove u imejlovima, dokumentima i drugim aplikacijama.</translation>
<translation id="4633738821577273991">Nabavite poboljšano bezbedno pregledanje i za ovaj Jatter profil</translation>
<translation id="4654936625574199632">Jatter šalje podatke o korišćenju i otkazivanju Google-u radi poboljšanja aplikacije. <ph name="BEGIN_LINK" />Upravljajte<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Uključite Jatter skener</translation>
<translation id="4685611756167369067">Otvaranje Jatter kartice bez arhiviranja</translation>
<translation id="4736424910885271643">Nalogom upravlja <ph name="HOSTED_DOMAIN" />, pa će se Jatter podaci obrisati sa ovog uređaja</translation>
<translation id="4790638144988730920">Nastavite da koristite Jatter podatke na Google nalogu.</translation>
<translation id="4828317641996116749">Jatter nije uspeo da proveri sve lozinke. Probajte ponovo kasnije.</translation>
<translation id="4856138222358683580">Jatter radnje</translation>
<translation id="4904452304169763785">Obaveštenja o svim problemima u vezi sa privatnošću ili bezbednošću koje Jatter otkrije za vas.</translation>
<translation id="4908570938463711775">Saznajte korisne osnove Jatter-a da biste započeli</translation>
<translation id="4962295957157529683">Završite ono što ste radili u drugom otvorenom Jatter prozoru.</translation>
<translation id="4985291216379576555">Oflajn ste. Jatter ne može da traži ažuriranja.</translation>
<translation id="4996471330284142407">Uradite više pomoću još jednostavnijeg, bezbednijeg i bržeg Jatter-a.</translation>
<translation id="4999538639245140991">Odjavljujete se sa naloga kojim upravlja <ph name="SIGNOUT_MANAGED_DOMAIN" />, što će izbrisati Jatter podatke sa ovog uređaja. Podaci će ostati na Google nalogu.</translation>
<translation id="5042011327527167688">Dodirnite Prikaži pomoću Google mapa u Jatter-u.</translation>
<translation id="5044871537677053278">Jatter otkriva adrese i koristi Google mape da bi vam pružao uputstva i lokalne informacije.</translation>
<translation id="5048140766121299007">U podešavanjima <ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" /> uključite Jatter</translation>
<translation id="5053429694249468757">Brišu se Jatter podaci…</translation>
<translation id="5071749685031362629">Jatter za iOS</translation>
<translation id="5124429847818367226">Sada možete da koristite Jatter svaki put kada pregledate ili dodirnete linkove u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="5131565040785979529">Vaša organizacija, <ph name="DOMAIN" />, upravlja nalogom na koji ste prijavljeni i načinom na koji se Jatter koristi.</translation>
<translation id="5134464247000681876">Otvara linkove iz Gmail-a, Mapa, YouTube-a i drugih aplikacija u Jatter-u</translation>
<translation id="5203244847421322551">Sačuvaj i automatski popunjavaj lozinke u Jatter-u</translation>
