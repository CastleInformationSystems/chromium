<translation id="8390323835464055390">ለራስ-ሙላ Jatter በመጠቀም በእርስዎ የተቀመጡ የይለፍ ቃላት እና የይለፍ ቁልፎች ከማንኛውም መተግበሪያ በመለያ ይግቡ</translation>
<translation id="8409374867500149834">ከጎጂ ድር ጣቢያዎች የሚከላከል የJatter በጣም ጠንካራ ጥበቃ አለዎት</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{ይህ የሚሆነው Jatter ለ{THRESHOLD} ደቂቃ ስራ ላይ ሳይውል ሲቀር ነው። በመለያ ገብተው ሳለ በዚህ መሣሪያ ላይ የተቀመጠ ውሂብ ብቻ ይሰረዛል። ይህ ታሪክን እና የይለፍ ቃላትን ሊያካትት ይችላል።}one{ይህ የሚሆነው Jatter ለ{THRESHOLD} ደቂቃ ስራ ላይ ሳይውል ሲቀር ነው። በመለያ ገብተው ሳለ በዚህ መሣሪያ ላይ የተቀመጠ ውሂብ ብቻ ይሰረዛል። ይህ ታሪክን እና የይለፍ ቃላትን ሊያካትት ይችላል።}other{ይህ የሚሆነው Jatter ለ{THRESHOLD} ደቂቃዎች ስራ ላይ ሳይውል ሲቀር ነው። በመለያ ገብተው ሳለ በዚህ መሣሪያ ላይ የተቀመጠ ውሂብ ብቻ ይሰረዛል። ይህ ታሪክን እና የይለፍ ቃላትን ሊያካትት ይችላል።}}</translation>
<translation id="8586442755830160949">የቅጂ መብት <ph name="YEAR" /> የJatter ደራሲያን። ሁሉም መብቶች የተጠበቁ ናቸው።</translation>
<translation id="8602103377623855616">የJatter ገፅ</translation>
<translation id="865600487977764604">በJatter ላይ ደህንነትዎን ይጠብቃል እና በመለያ በገቡባቸው ሌሎች የGoogle መተግበሪያዎች ላይ ደህንነትዎን ለማሻሻል ሥራ ላይ ሊውል ይችላል።</translation>
<translation id="8663480472502753423">Jatterን እንደተዘመነ ያቆዩ</translation>
<translation id="8685813584220679697">ወደዚህ ጣቢያ እና Jatter ይግቡ።</translation>
<translation id="8698780336333802489">ወደ Jatter አምጣ</translation>
<translation id="8730503818204408000">Jatterን እንደ ነባሪ አሳሸ ለማቀናበር የJatter ቅንብርን ይከፍታል።</translation>
<translation id="8754966941001340678">Jatter የላቀ ጥበቃን ይመክራል</translation>
<translation id="8759037115129007407">በአሁኑ ጊዜ የቤተሰብ አባልዎ የይለፍ ቃሎችን መቀበል አይችሉም። Jatter እንዲያዘምኑ እና የይለፍ ቃላቸውን እንዲያሰምሩ ይጠይቋቸው። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">የእርስዎን Jatter ይዘው ይሂዱ</translation>
<translation id="8776843108004031667">ይህ መለያ እና ማንኛውም ያልተቀመጠ ውሂብ ከJatter ይወገዳል።</translation>
<translation id="8793333988063379360">የJatter ቅንብሮችን እና ሌሎችን እዚህ ማግኘት ይችላሉ</translation>
<translation id="8805148242934787134">Jatter እንደ ነባሪ አሳሸ ያቀናብሩ</translation>
<translation id="8826789549860004832">አሳሽዎን ማቀናበር በመቀጠል ከJatter ማግኘት የሚችሉትን ሁሉ ያግኙ።</translation>
<translation id="88376265765385899">የJatter እልባቶችን ይከፍታል።</translation>
<translation id="8860548555286245440">የማይታወቁ ዩአርኤልዎችን በማንነት የማያሳውቅ Jatter ይክፈቱ</translation>
<translation id="8880024619507699923">Jatter ለመጠቀም የእርስዎ ድርጅት እርስዎ በመለያ እንዲገቡ ይጠይቃል። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">የJatter ጠንካራ ደህንነትን ያግኙ</translation>
<translation id="8908791447256515663">ከእርስዎ iPad መትከያ ላይ Jatterን ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="8925569192291721236">የዋጋ ክትትል ዝማኔዎችን እና የJatter ጠቃሚ ምክሮችን ይከታተሉ።</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{ይህ የሚሆነው Jatter ለ{THRESHOLD} ደቂቃ ጥቅም ላይ ሳይውል ሲቀር ነው}one{ይህ የሚሆነው Jatter ለ{THRESHOLD} ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር ነው}other{ይህ የሚሆነው Jatter ለ{THRESHOLD} ደቂቃዎች ጥቅም ላይ ሳይውል ሲቀር ነው}}</translation>
<translation id="8963279154877372067">የዋጋ ቅናሽ ማንቂያዎችን ለማግኘት የJatter ማሳወቂያዎችን ይፍቀዱ</translation>
<translation id="8975812008711371178">በJatter ውስጥ በድምፅ ይፈልጉ</translation>
<translation id="900560297598578021">እንደ <ph name="EMAIL" /> ሆነው ገብተዋል።

<ph name="TIME" /> ላይ ውሂብዎ በይለፍ ሐረግዎ የተመሰጠረ ሆኗል። የJatter ውሂብን በGoogle መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="9031260906956926157">አንዳንድ የJatter ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም።
ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="9050790730841755540">በሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞች ላይ መታ በሚያደርጉበት ማንኛውም ጊዜ Jatterን ይጠቀሙ።</translation>
<translation id="9059693977935746710">ይህን የይለፍ ቃል ማስታወስ አያስፈልገዎትም። ለ<ph name="EMAIL" /> በይለፍ ቃል አስተዳዳሪ ላይ ይቀመጣል</translation>
<translation id="9089354809943900324">Jatter ጊዜው አልፎበታል</translation>
<translation id="9105645282262300612">የJatter ጠቃሚ ምክር፦ የሚመለከቱትን ይፈልጉ</translation>
<translation id="9152995302810511799">የJatter ጠቃሚ ምክር፦ የJatterን ጠንካራ ደህንነት ያግኙ</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />። Jatter ይተዳደራል።</translation>
<translation id="921174536258924340">Jatter ሁሉንም የይለፍ ቃሎች ማረጋገጥ አልቻለም። ነገ እንደገና ይሞክሩ ወይም <ph name="BEGIN_LINK" />የGoogle መለያዎን ይለፍ ቃላት ይፈትሹ።<ph name="END_LINK" /></translation>
<translation id="924957577793602335">Jatterን የራስዎ ያድርጉት</translation>
<translation id="981812233959540767">የJatter Dino ጨዋታን ይጫወቱ</translation>
<translation id="985602178874221306">የJatter ደራሲዎች</translation>
<translation id="986520777495807752">Jatterን እንደ ነባሪ ያቀናብሩ</translation>
</translationbundle>