<translation id="3581385059720151202">በJatter ውስጥ የሚታዩ ነገሮችን ይፈልጉ።</translation>
<translation id="3582640969619785896">Jatter የይለፍ ቃልዎን ለማስቀመጥ ጥያቄ ያቀርባል</translation>
<translation id="3594315078412605236">በJatter ውስጥ የመክፈያ ዘዴዎችን ያስተዳድሩ</translation>
<translation id="3600428265489994557">Jatter ውስጥ ይግቡ</translation>
<translation id="3617143087229977194">ነባሪ መተግበሪያዎች ቅንብሮችን iOS ውስጥ ይክፈቱ፣ ከዚያ «አሳሽ መተግበሪያ» ላይ መታ ያድርጉ እና Jatterን ይምረጡ።</translation>
<translation id="3634039384458740619">የJatter ቅንብሮችን ይክፈቱ</translation>
<translation id="3639997914391704523">Jatter በእርስዎ የGoogle መለያ በሚገቡበት ጊዜ የእርስዎን የይለፍ ቃላትን ሊፈትሽ ይችላል።</translation>
<translation id="372658070733623520">በGoogle መለያዎ ውስጥ የJatter ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ።</translation>
<translation id="3728124580182886854">Jatterን እና ሌሎች የGoogle አገልግሎቶችን ግላዊነት ለማላበስ እና ለሌሎች ዓላማዎች ያገናኟቸው</translation>
<translation id="377649297473651452">Jatter ራስ-ሙላ የተዘረጋ ዕይታ</translation>
<translation id="3780779443901618967">ከመደበኛ ጥበቃ በላይ ተጨማሪ ውሂብ ከጣቢያዎች ትንታኔ በመስጠት Google እንኳን በፊት ስላላወቃቸው አደገኛ ጣቢያዎች ያስጠነቅቅዎታል። የJatter ማስጠንቀቂያዎችን ለመዝለል መምረጥ ይችላሉ።</translation>
<translation id="3805899903892079518">Jatter የእርስዎ ፎቶዎች ወይም ቪዲዮዎች መዳረሻ የለውም። በiOS ቅንብሮች &gt; ግላዊነት &gt; ፎቶዎች ውስጥ መዳረሻን ያንቁ።</translation>
<translation id="3816686541346279443">Jatter የይለፍ ቃልዎን ለማስቀመጥ ጥያቄ ያቀርባል።</translation>
<translation id="3827545470516145620">እርስዎ በዚህ መሣሪያ ላይ መደበኛ የደህንነት ጥበቃ እያገኙ ነው</translation>
<translation id="3833326979834193417">Jatter እርስዎን ከውሂብ ጥሰቶች፣ ደህንነታቸው ካልተጠበቁ ድር ጣቢያዎች እና ሌሎችም ደህንነትዎ እንደተጠበቀ ለማቆየት በየቀኑ የደህንነት ፍተሻን በራስ-ሰር ያሄዳል። ስለ የደህንነት ፍተሻ በቅንብሮች ውስጥ የበለጠ ማግኘት ይችላሉ።</translation>
<translation id="3837584850181228767">የJatter ጠቃሚ ምክር፦ የተሻሻለ የደህንነት አሰሳ</translation>
<translation id="3845223911364528001">ፋይልዎን ለመስቀል ወደ Jatter ይመለሱ</translation>
<translation id="3855938650519180865">በJatter ውስጥ ምን አዲስ ነገር አለ</translation>
<translation id="3886689467633467988">በሁሉም መሣሪያዎችዎ ላይ የእርስዎን ዕልባቶች እና ሌሎችም ለማግኘት ወደዚህ ጣቢያ እና Jatter ይግቡ።</translation>
<translation id="3949514465204582407">Jatter ጠቃሚ ምክር፦ በማንኛውም መተግበሪያ ውስጥ የይለፍ ቃላትዎን ያግኙ</translation>
<translation id="4005283307739974863">በJatter ውስጥ የደህንነት ፍተሻን ይከፍታል እና ያሄዳል።</translation>
<translation id="4043291146360695975">የይለፍ ቃላት የሚቀመጡት በዚህ መሣሪያ ላይ ብቻ ባለው የይለፍ ቃል አስተዳዳሪ ላይ ነው።</translation>
<translation id="4066426933127344530">በነባሪ Jatter ይጠቀሙ</translation>
<translation id="4087314024407094071">በJatter ውስጥ ቅንብሮቹን ይከፍታል።</translation>
<translation id="4099085513035183040">በJatter ቅድመ-ይሁንታ ላይ አይደገፍም</translation>
<translation id="4106512142782407609">እንደ <ph name="EMAIL" /> ሆነው ገብተዋል።

የእርስዎ ውሂብ በእርስዎ የይለፍ ሐረግ የተመሰጠረ ነው። የJatter ውሂብን በGoogle መለያዎ ውስጥ ለመጠቀም እና ለማስቀመጥ እሱን ያስገቡ።</translation>
<translation id="4118287192800900567">የJatter ጠቃሚ ምክር፦ ወደ Jatter ይግቡ</translation>
<translation id="4195557071150719219">የJatter የቅርብ ጊዜ ትሮችን ይመልከቱ</translation>
<translation id="420541179527342563">በJatter ውስጥ የመቆለፊያ ሁነታን ለማሰናከል iPadዎን ያጥፉት።</translation>
<translation id="4272892696084633551">የJatter ባህሪያት እና አፈጻጸም እንዲሻሻል ያግዙ</translation>
<translation id="4302397443352897529">የJatter ቅንብሮች</translation>
<translation id="4304713468139749426">የይለፍ ቃል አስተዳዳሪ</translation>
<translation id="4408912345039114853">Jatter የደህንነት ፍተሻን ያሂዱ</translation>
<translation id="4432744876818348753">ከJatter የሚችሉትን ሁሉ ለማግኘት በመለያ ይግቡ።</translation>
<translation id="4445228361214254027">ድርጅትዎ በእርስዎ የGoogle መለያ ውስጥ Jatter ውሂብ የመጠቀም እና የማስቀመጥ አቅምን አጥፍቷል። አዳዲስ ዕልባቶች፣ የይለፍ ቃላት እና ሌሎችም በዚህ መሣሪያ ላይ ብቻ ይቀመጣሉ።</translation>
<translation id="4498832288620833153">የገባውን ዩአርኤል በ Jatter ውስጥ ባለው የንባብ ዝርዝር ውስጥ ያክላል።</translation>
<translation id="4508268628669724828">ከJatter ምርጡን ለማግኘት ለተጨማሪ ጠቃሚ ምክሮች ተመልሰው እዚህ ይምጡ።</translation>
<translation id="452436063477828504">በGoogle መለያዎ ውስጥ በማንኛውም ጊዜ የJatter ውሂብን መጠቀም መቻልዎን ያረጋግጡ</translation>
<translation id="4527452566931097835">Jatter እንደ ነባሪ ይቀናበር?</translation>
<translation id="4555020257205549924">ይህ ባህሪ ሲበራ Jatter በሌሎች ቋንቋዎች የተጻፉ ገጾች Google ትርጉምን በመጠቀም እንዲተረጎምልዎ ይጠይቀዎታል። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">የይለፍ ሐረግ ምስጠራ የመክፈያ ዘዴዎችን እና አድራሻዎችን አያካትትም።

ይህን ቅንብር ለመለወጥ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የJatter ውሂብ ይሰርዙ<ph name="END_LINK" />።</translation>
<translation id="4578500311756617174">የJatter ጠቃሚ ምክር፦ Jatter በነባሪ ይጠቀሙ</translation>
<translation id="458786853569524949">አገናኞችን በኢሜይሎች፣ በሰነዶች እና በሌሎች መተግበሪያዎች ውስጥ መታ በሚያደርጉበት ጊዜ ሁሉ Jatterን አሁን መጠቀም ይችላሉ።</translation>
<translation id="4633738821577273991">ለዚህ የJatter መገለጫ የተሻሻለ የደህንነት አሰሳንም ያግኙ</translation>
<translation id="4654936625574199632">መተግበሪያውን ለማሻሻል ለማገዝ Jatter የአጠቃቀም እና የስንክል ውሂብን ወደ Google ይልካል። <ph name="BEGIN_LINK" />አቀናብር<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">የJatter ቃኚን ያብሩ</translation>
<translation id="4685611756167369067">የJatter ማንነት የማያሳውቅ ትርን ይክፈቱ</translation>
<translation id="4736424910885271643">የእርስዎ መለያ በ<ph name="HOSTED_DOMAIN" /> የሚተዳደር ነው፣ ስለሆነም የእርስዎ የJatter ውሂብ ከዚህ መሣሪያ ይጸዳል</translation>
<translation id="4790638144988730920">በGoogle መለያዎ ውስጥ የJatter ውሂብን መጠቀምዎን ይቀጥሉ።</translation>
<translation id="4828317641996116749">Jatter ሁሉንም የይለፍ ቃላት ማረጋገጥ አልቻለም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="4856138222358683580">የJatter እርምጃዎች</translation>
<translation id="4869706986935301458">በእርስዎ iPhone ላይ ሲሆኑ Jatterን በቅጽበት ይክፈቱ</translation>
<translation id="4904452304169763785">Jatter ለእርስዎ በሚያገኛቸው ማናቸውም የግላዊነት ወይም የደህንነት ችግሮች ላይ ያሉ ማንቂያዎች።</translation>
<translation id="4908570938463711775">ለመጀመር አጋዥ የሆኑትን የJatter መሠረታዊ ነገሮች ይወቁ</translation>
<translation id="4962295957157529683">በእርስዎ ሌላኛው ክፍት የJatter መስኮት ላይ እያደረጉ ያሉትን ነገር ያጠናቅቁ።</translation>
<translation id="4985291216379576555">ከመስመር ውጭ፣ Jatter ዝማኔዎች ካሉ መፈተሽ አልቻለም</translation>
<translation id="4996471330284142407">ከመቼውም ጊዜ በበለጠ ቀላል፣ ደህንነቱ በተጠበቀ እና ፈጣን በሆነ Jatter አማካኝነት ተጨማሪ ነገሮችን ያከናውኑ።</translation>
<translation id="4999538639245140991">በ<ph name="SIGNOUT_MANAGED_DOMAIN" /> ከሚተዳደር መለያ ዘግተው እየወጡ ስለሆነ የእርስዎ Jatter ውሂብ ከዚህ መሣሪያ ላይ ይሰረዛል። የእርስዎ ውሂብ በGoogle መለያዎ ውስጥ ይቆያል።</translation>
<translation id="5042011327527167688">«በJatter ላይ በGoogle ካርታዎች ይመልከቱ» የሚለው ላይ መታ ያድርጉ።</translation>
<translation id="5044871537677053278">Jatter አድራሻዎችን ያገኛል እና ለእርስዎ አቅጣጫዎችን እና አካባቢያዊ መረጃ ለመስጠት Google ካርታዎችን ይጠቀማል።</translation>
<translation id="5048140766121299007">ከ«<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />» ቅንብሮች «Jatter»ን ያብሩ</translation>
<translation id="5053429694249468757">የJatter ውሂብን በመሰረዝ ላይ…</translation>
<translation id="5071749685031362629">Jatter ለiOS</translation>
<translation id="5124429847818367226">አሁን በሚያስሱበት ወይም በመልዕክቶች ውስጥ አገናኞችን መታ በሚያደርጉበት በማንኛውም ጊዜ Jatter እና ሌሎች መተግበሪያዎችን መጠቀም ይችላሉ።</translation>
