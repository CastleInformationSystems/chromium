<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="1000436330784933699">ሌንስ እዚህ መክፈት ይችላሉ።</translation>
<translation id="1042296835509784301">በJatter ውስጥ የሚስጥር ቁልፍ አስተዳዳሪውን ይከፍታል።</translation>
<translation id="1047130070405668746">Jatterን ይምረጡ</translation>
<translation id="1091252999271033193">ይህ ማለት Jatter የተንቀሳቃሽ ስልክ ጣቢያውን በእያንዳንዱ ጊዜ ይጠይቃል ማለት ነው።</translation>
<translation id="1115463765356382667">ከJatter ላይ ምርጡን ለማግኘት ከታች ያሉትን እነዚህን የተጠቆሙ እርምጃዎች ያጠናቅቁ።</translation>
<translation id="1185134272377778587">ስለJatter</translation>
<translation id="119044033865561140">በእርስዎ iPad ላይ ሲሆኑ Jatterን በቅጽበት ይክፈቱ</translation>
<translation id="1211450393895337634">በእርስዎ iPad ላይ ለማሰስ ዝግጁ ሲሆኑ Jatterን ይበልጥ በፍጥነት ይክፈቱ።</translation>
<translation id="1229234641991056119">የእርስዎን Safari የይለፍ ቃላት፣ ዕልባቶች እና ክሬዲት ካርዶች Jatter ውስጥ ይጠቀሙ</translation>
<translation id="1257458525759135959">ምስሎችን ለማስቀመጥ፣ Jatter ወደ የእርስዎ ፎቶዎች ማከል እንዲችል ለማድረግ ቅንብሮች ላይ መታ ያድርጉ</translation>
<translation id="1260702988262336471">የJatter ምናሌውን ይክፈቱ</translation>
<translation id="12739128458173458">ይህን ትር ወደ ሌላ መሣሪያ ለመላክ፣ በሁለቱም መሣሪያዎች ላይ ወደ Jatter ይግቡ።</translation>
<translation id="1279797561821266129">ከመትከያዎ Jatterን በፍጥነት ይድረሱበት</translation>
<translation id="1361748954329991663">Jatter ጊዜው አልፎበታል። በ<ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> ውስጥ ምንም ዝማኔ ከሌለ የእርስዎ መሣሪያ አዲስ የJatter ስሪቶችን ከእንግዲህ ላይደግፍ ይችላል።</translation>
<translation id="1383876407941801731">ፍለጋ </translation>
<translation id="1423007117030725713">በአዲስ የJatter ትር ውስጥ ፍለጋ ጀምር።</translation>
<translation id="1431818719585918472">Jatter የእርስዎን ማንነት የማያሳውቁ ትሮች እንዲቆልፍ ይፍቀዱለት።</translation>
<translation id="1451665391191990528">Jatterን ለቀው ሲወጡ የተከፈቱ ማንነት የማያሳውቁ ትሮችን ይደብቁ</translation>
<translation id="146407871188825689">Jatterን በiPad ላይ በነባሪ ተጠቀም</translation>
<translation id="1471084500615228555">በJatter ውስጥ የአሰሳ ውሂብን ሰርዝ</translation>
<translation id="1472013873724362412">የእርስዎ መለያ በJatter ላይ አይሠራም። እባክዎ የእርስዎን የጎራ አስተዳዳሪ ያነጋግሩ ወይም ለመግባት መደበኛ Google መለያ ይጠቀሙ።</translation>
<translation id="148576268809812097">የይለፍ ቃላትዎን Jatter ውስጥ ያስቀምጡ</translation>
<translation id="1501302548410882220">በሁሉም ቦታ Jatter ይጠቀሙ</translation>
<translation id="1502360822835740515">Jatterን የእርስዎ ነባሪ አሳሽ ያድርጉ</translation>
<translation id="1503199973012840174">የእርስዎ Jatter ጊዜው አልፎበታል። ደህንነትዎን ለመጠበቅ ያዘምኑት።</translation>
<translation id="1515748263297244785">Jatter ለiPad በነባሪ ይጠቀሙ</translation>
<translation id="1530961174488670696">Jatter ዝማኔዎች መኖራቸውን መፈተሽ አልቻለም። ቆይተው እንደገና ይሞክሩ።</translation>
<translation id="1531155317299575425">ወደ Jatter የመግባት ጥያቄዎችን ያሳያል።</translation>
<translation id="1553657876656159572">ለእርስዎ የተሠራ ብጁ ምግብ። ዜና፣ ስፖርት እና የአየር ሁኔታን ጨምሮ።</translation>
<translation id="1561849081734670621">የመቆለፊያ ሁነታን ለማሰናከል በJatter ውስጥ በእርስዎ iPhone ላይ ያጥፉት።</translation>
<translation id="1569258826720962327">በiOS ላይ Jatter እርምጃዎችን ይጠቀሙ</translation>
<translation id="1573441572176948907">Jatterን ወደ መትከያዎ ያንቀሳቅሱ</translation>
<translation id="159029779861043703">Jatter አደጋ ሊያስከትል የሚችል ውሂብዎን በፊት መታወቂያ ደህንነቱን ይጠብቃል።</translation>
<translation id="1591119736686995611">የJatter ትር ፍርግርግን ይከፍታል።</translation>
<translation id="16001233025397167">የደህንነት ፍተሻ እርስዎን ከውሂብ ጥሰቶች፣ ደህንነታቸው ካልተጠበቁ ድር ጣቢያዎች እና ከተጨማሪ ነገሮች ይጠብቅዎታል። Jatter ለእርስዎ በሚያገኛቸው ማናቸውም የግላዊነት ወይም የደህንነት ችግሮች ላይ ማንቂያዎችን ይቀበሉ።</translation>
<translation id="1614362805233822594">ለሚታዩት ጣቢያዎች የይለፍ ቃል አስተዳዳሪ ውስጥ አስቀድመው የይለፍ ቃሎች ወይም የይለፍ ቁልፎች አሉዎት። የሚታየውን የመግቢያ መረጃ ለማቆየት መለያ ይምረጡ፣ ይህም በይለፍ ቃል አስተዳዳሪ ውስጥ ያለውን ይተካል።</translation>
<translation id="1617663976202781617">ከJatter ስምረት የመጣ ውሂብ</translation>
<translation id="164952285225495380">ይህ ጥቅል አስቀድሞ Jatter ላይ ክትትል ተደርጎበታል።</translation>
<translation id="1703338211136118534">የሚከተሉት የይለፍ ቃላት ወደ የይለፍ ቃል አስተዳዳሪ አልመጡም፣ ምክንያቱም ከመስፈርቶቹ ጋር አይዛመዱም።</translation>
<translation id="1707458603865303524">በመልዕክቶች ወይም በሌሎች መተግበሪያዎች ውስጥ ያሉ አገናኞችን መታ በሚያደርጉበት ማንኛውም ጊዜ Jatterን ይጠቀሙ።</translation>
<translation id="1722370509450468186">የይለፍ ቃልዎ በመለያዎ (<ph name="EMAIL" />) ላይ ይቀመጣል።</translation>
<translation id="1747088204252710672">ለእርስዎ የተሰራ ብጁ ምግብ</translation>
<translation id="1761196287436320018">የJatterን የ<ph name="LIMIT" /> እልባቶች ገደብ ላይ ደርሰዋል፣ ስለዚህ የተወሰኑ እልባቶችዎ እስካሁን በGoogle መለያዎ ውስጥ አልተቀመጡም።

የተወሰነ እስኪሰርዙ ድረስ አዲስ እልባቶች በመለያዎ ውስጥ መቀመጥ አይችሉም። አሁን ዘግተው ከወጡ፣ ያልተቀመጡ እልባቶች ይሰረዛሉ።</translation>
<translation id="1811860791247653035">ግላዊነት ማላበስን እና ሌሎች ባህሪያትን ለማግኘት Jatterን በ<ph name="FEATURE_NAME_1" /> እና <ph name="FEATURE_NAME_2" /> ውስጥ ያካትቱ</translation>
<translation id="1838412507805038478">Jatter የዚህ ድር ጣቢያ እውቅና ማረጋገጫ ያወጣው <ph name="ISSUER" /> መሆኑን አረጋግጧል።</translation>
<translation id="1839447949248872139">አገናኞችን በነባሪ Jatter ውስጥ ይክፈቱ</translation>
<translation id="1843424232666537147">Jatter እርስዎ የበይነመረብ ውሂብዎን እና ድረ-ገጾችን በምን ያህል ፍጥነት መጫን እንደሚችሉ እንዲያቀናብሩ የሚያስችሉዎት ባህሪያት አሉት። <ph name="BEGIN_LINK" />የበለጠ ለመረዳት<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">በJatter ውስጥ ያሉ ካርታዎች</translation>
<translation id="1867772173333403444">4. Jatterን ይምረጡ</translation>
<translation id="1965068424387304464">የJatter ጠቃሚ ምክር፦ የተቀመጡ የይለፍ ቃላት</translation>
<translation id="1992653360331625459">ቀድሞውኑ በእርስዎ የይለፍ ቃል አስተዳዳሪ ውስጥ ለእነዚህ መለያዎች የይለፍ ቃላት አሉዎት። ከታች ካሉት የይለፍ ቃላት አንዱን ለማስመጣት ከመረጡ እሱ ነባሩን ይተካል።</translation>
<translation id="2006345422933397527">Jatter ዝማኔዎች ካሉ መፈተሽ አልቻለም። የበይነመረብ ግንኙነትዎን ለመፈተሽ ይሞክሩ።</translation>
<translation id="2042889939382983733">የእርስዎን የJatter ታሪክ ይመልከቱ</translation>
<translation id="2052320862053429062">Jatter በየጊዜው የእርስዎን የይለፍ ቃላት መስመር ላይ ከታተሙ ዝርዝሮች ጋር እያነጻጸረ ይፈትሻል። ይህን በሚያደርግበት ጊዜ የእርስዎ የይለፍ ቃላት እና የተጠቃሚ ስሞች Googleን ጨምሮ በሌላ ማንም ወገን እንዳይነበቡ ይመሠጠራሉ።</translation>
<translation id="2059365270911640413">Jatter ማዋቀርን ያጠናቅቁ</translation>
<translation id="2168108852149185974">አንዳንድ ተጨማሪዎች Jatter እንዲበላሽ ያደርጋሉ። እባክዎ የሚከተለውን ያራግፉ፦</translation>
<translation id="2168593389981132306">Jatter የተሻለ ያድርጉት</translation>
<translation id="2178608107313874732">Jatter አሁን ካሜራዎን መጠቀም አይችልም</translation>
<translation id="2195025571279539885">Jatter በሚቀጥለው ጊዜ ከዚህ ጣቢያ የመጡ የ<ph name="LANGUAGE_NAME" /> ገጾችን እንዲተረጎምልዎ ይፈልጋሉ?</translation>
<translation id="22313767259766852">ይህ አድራሻ በአሁኑ ጊዜ Jatter ላይ ተቀምጧል። በሁሉም የGoogle ምርቶች ላይ እሱን ለመጠቀም በGoogle መለያዎ <ph name="USER_EMAIL" /> ውስጥ ያስቀምጡት።</translation>
<translation id="2236584955986023187">ይህ ማለት Jatter የዴስክቶፕ ጣቢያውን በእያንዳንዱ ጊዜ ይጠይቃል ማለት ነው።</translation>
<translation id="2245694534483711162">Gemini ቀድሞውኑ ለJatter በሰጡት ፈቃድ መሠረት የእርስዎን ትክክለኛ አካባቢ ሊጠቀም ይችላል</translation>
<translation id="2270466829363945454">ይግዙ</translation>
<translation id="2313870531055795960">በJatter ላይ በተከማቹ ደህንነታቸው ያልተጠበቁ ጣቢያዎች ዝርዝር ጋር ዩአርኤሎችን ይፈትሻል። አንድ ጣቢያ የእርስዎን የይለፍ ቃል ለመስረቅ ከሞከረ ወይም ጎጂ ፋይል ሲያወርዱ Jatter እንዲሁም የገጽ ይዘት ቢትስንም ጨምሮ ዩአርኤሎችን ወደ የጥንቃቄ አሰሳ ሊልክ ይችላል።</translation>
<translation id="2314220608288760290">Jatter የYouTube ማንነት የማያሳውቁ አገናኞችን በራስ-ሰር በማንነት የማያሳውቅ ይከፍታል።</translation>
<translation id="231828342043114302">በፍላጎቶችዎ ላይ የተመሠረተ ግላዊነት የተላበሰ ይዘትን ለመቀበል ወደ Jatter ይግቡ።</translation>
<translation id="2326738825692478496">አንዳንድ የJatter ውሂብዎ በGoogle መለያዎ ውስጥ ገና አልተቀመጠም።

ዘግተው ከመውጣትዎ በፊት ጥቂት ደቂቃዎች ለመጠበቅ ይሞክሩ። አሁን ዘግተው ከወጡ ይህ ውሂብ ይሰረዛል።</translation>
<translation id="2334943301233020675">የሚከተሉት የይለፍ ቁልፎች ወደ የይለፍ ቃል አስተዳዳሪ አልመጡም፣ ምክንያቱም ከመስፈርቶቹ ጋር አይዛመዱም።</translation>
<translation id="2337722506862731008">Jatter ያጋሩ</translation>
<translation id="2340423701577464731">የንባብ ዝርዝር ንጥልን ወደ Jatter ያክሉ</translation>
<translation id="2374627437126809292">Jatter በታወቁ አድራሻዎች ላይ አቅጣጫዎችን እና አካባቢያዊ መረጃ ለእርስዎ ለመስጠት Google ካርታዎችን ይጠቀማል።</translation>
<translation id="2386292341327187942">በምግብሮች ፈልግ ሳጥን ውስጥ Jatterን ያስገቡ</translation>
<translation id="2389827884654658221">ከእርስዎ iPad መነሻ ማያ ገጽ ላይ Jatter ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="2426113998523353159">Jatterን ለመጠቀም የእርስዎ ድርጅት እርስዎ በመለያ እንዲገቡ ይጠይቃል።</translation>
<translation id="2450140762465183767">አገናኞችን በመልዕክቶች፣ በሰነዶች እና በሌሎች መተግበሪያዎች ውስጥ መታ በሚያደርጉበት ጊዜ ሁሉ Jatterን አሁን መጠቀም ይችላሉ።</translation>
<translation id="2459183986985456602">በJatter ውስጥ የእኔ የቅርብ ጊዜ ትርን ክፈት።</translation>
<translation id="2476409803017965813">ምርጫዎችዎን በማንኛውም ጊዜ በJatter ቅንብሮች ውስጥ ማዘመን ይችላሉ።</translation>
