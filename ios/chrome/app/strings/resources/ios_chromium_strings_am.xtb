<translation id="2485774047568879945">አገናኞችን በቀላሉ ለማጋራት እና ለመክፈት Jatterን እንደ ነባሪ አሳሽዎ ያቀናብሩ</translation>
<translation id="2512597191798760956">የJatter አዶውን ተጭነው ይያዙ እና «የመነሻ ማያ ገፅን አርትዕ» ላይ ጠቅ ያድርጉ</translation>
<translation id="2517624234762908348">የJatter ውሂብዎን ያሳምሩ</translation>
<translation id="2575968074225731646">ከእርስዎ iPhone መትከያ ላይ Jatterን ይበልጥ በፍጥነት ይድረሱ።</translation>
<translation id="2592940277904433508">Jatterን መጠቀምዎን ይቀጥሉ</translation>
<translation id="2601766165676560303">የJatter ገጽታ ለiPhone እና iPad</translation>
<translation id="2607609479243848905">የይለፍ ሐረግዎን ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK" />በመለያዎ ውስጥ ያለውን የJatter ውሂብ ይሰርዙ<ph name="END_LINK" />።</translation>
<translation id="2640367368802736659">የJatter ጠቃሚ ምክር፦ በGoogle ሌንስ የሚያዩትን ይፈልጉ</translation>
<translation id="2650312721222849884">Jatterን ከሚጠቀሙበት የትኛዉም ቦታ ትሮችን ለማየት ስምረትን ያብሩ</translation>
<translation id="2684230048001240293">በሁሉም መሣሪያዎችዎ ላይ ትሮችዎን፣ የይለፍ ቃላትዎን እና የክፍያ መረጃዎን ለማስመር Jatterን እንደ ነባሪ ያዘጋጁ</translation>
<translation id="2729836253097154631">ነገሮችዎን ለማግኘት ወደ Jatter በመለያ ይግቡ</translation>
<translation id="2730884209570016437">ሌላ መተግበሪያ ካሜራዎን እየተጠቀመበት ስለሆነ Jatter ካሜራዎን መጠቀም አይችልም</translation>
