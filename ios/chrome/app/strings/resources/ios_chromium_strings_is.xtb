<!DOCTYPE translationbundle>
<translationbundle lang="is">
<translation id="1000436330784933699">Hér geturðu opnað Linsu.</translation>
<translation id="1042296835509784301">Opnar Aðgangsorðastjórnun í Jatter.</translation>
<translation id="1047130070405668746">Veldu Jatter</translation>
<translation id="1091252999271033193">Þetta þýðir að Jatter biður alltaf um snjalltækjaútgáfu vefsvæðis.</translation>
<translation id="1115463765356382667">Ljúktu ráðlögðu aðgerðunum hér að neðan til að nýta Jatter sem best.</translation>
<translation id="1185134272377778587">Um Jatter</translation>
<translation id="1211450393895337634">Opnaðu Jatter hraðar þegar þú ert tilbúin(n) að vafra í iPad.</translation>
<translation id="1229234641991056119">Notaðu aðgangsorðin þín, feril, bókamerki og kreditkort í Safar í Jatter</translation>
<translation id="1257458525759135959">Til að vista myndir og láta Jatter bæta við myndirnar þínar skaltu ýta á Stillingar</translation>
<translation id="1260702988262336471">Opnaðu valmynd Jatter</translation>
<translation id="12739128458173458">Til að senda þennan flipa í annað tæki þarftu að skrá þig inn í Jatter í báðum tækjum.</translation>
<translation id="1361748954329991663">Jatter er úrelt. Ef engin uppfærsla er til staðar í <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> getur verið að tækið þitt styðji ekki lengur nýjar útgáfur af Jatter.</translation>
<translation id="1383876407941801731">Leita</translation>
<translation id="1423007117030725713">Hefja leit í nýjum flipa í Jatter.</translation>
<translation id="1431818719585918472">Leyfa Jatter að læsa huliðsflipunum þínum.</translation>
<translation id="1451665391191990528">Fela opna huliðsflipa þegar þú lokar Jatter</translation>
<translation id="146407871188825689">Nota Jatter sjálfgefið í iPad</translation>
<translation id="1471084500615228555">Eyða vefskoðunargögnum í Jatter</translation>
<translation id="1472013873724362412">Reikningurinn þinn virkar ekki í Jatter. Hafðu samband við stjórnanda lénsins eða notaðu venjulegan Google-reikning til að skrá þig inn.</translation>
<translation id="148576268809812097">Vistaðu aðgangsorðin þín í Jatter</translation>
<translation id="1501302548410882220">Notaðu Jatter hvar sem er</translation>
<translation id="1502360822835740515">Gera Jatter að sjálfgefnum vafra</translation>
<translation id="1503199973012840174">Jatter-útgáfan þín er úrelt. Uppfærðu hana til að gæta að öryggi þínu.</translation>
<translation id="1515748263297244785">Notaðu Jatter sem sjálfgefinn vafra í iPad</translation>
<translation id="1531155317299575425">Sýna innskráningartilkynningar í Jatter.</translation>
<translation id="1553657876656159572">Sérsniðinn straumur fyrir þig. Inniheldur m.a. fréttir, íþróttir og veður.</translation>
<translation id="1561849081734670621">Til að slökkva á Lockdown Mode í Jatter þarftu að slökkva á því í iPhone-símanum þínum.</translation>
<translation id="1569258826720962327">Notaðu Jatter-aðgerðir í iOS</translation>
<translation id="1573441572176948907">Færðu Jatter í dokkuna</translation>
<translation id="159029779861043703">Jatter notar andlitskennsl til að halda viðkvæmu upplýsingunum þínum öruggum.</translation>
<translation id="1591119736686995611">Opnar flipayfirlit Jatter.</translation>
<translation id="16001233025397167">Öryggisathugun veitir þér vernd gegn öryggisbrotum, hættulegum vefsvæðum og fleira. Fáðu viðvaranir varðandi öll persónuverndar- eða öryggismál sem Jatter greinir fyrir þig.</translation>
<translation id="1617663976202781617">Gögn úr Jatter samstillingu</translation>
<translation id="164952285225495380">Þegar er búið að rekja þennan pakka í Jatter.</translation>
<translation id="1707458603865303524">Notaðu Jatter þegar þú ýtir á tengla í skilaboðum eða öðrum forritum.</translation>
<translation id="1722370509450468186">Aðgangsorðið þitt verður vistað á reikningnum þínum (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Sérsniðinn straumur, búinn til fyrir þig</translation>
<translation id="1811860791247653035">Hafðu Jatter með í <ph name="FEATURE_NAME_1" /> og <ph name="FEATURE_NAME_2" /> til að fá aðgang að sérsniði og öðrum eiginleikum</translation>
<translation id="1838412507805038478">Jatter staðfesti að <ph name="ISSUER" /> gaf út vottorð þessa vefsvæðis.</translation>
<translation id="1839447949248872139">Opnaðu tengla sjálfkrafa í Jatter</translation>
<translation id="1843424232666537147">Í Jatter eru eiginleikar sem aðstoða þig við að hafa umsjón með gögnum á netinu og hversu fljótlega þú hleður vefsíðum niður.
<ph name="BEGIN_LINK" />Frekari upplýsingar<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Kort í Jatter</translation>
<translation id="1867772173333403444">4. Veldu Jatter</translation>
<translation id="1965068424387304464">Jatter-ráð: Vistaðu aðgangsorð</translation>
<translation id="2006345422933397527">Jatter gat ekki leitað að uppfærslum. Athugaðu nettenginguna þína.</translation>
<translation id="2042889939382983733">Skoða Jatter-ferilinn þinn</translation>
<translation id="2052320862053429062">Jatter athugar aðgangsorðin þín reglulega og ber þau saman við lista sem hafa verið birtir á netinu. Meðan á þessu stendur eru aðgangsorðin þín og notandanöfnin dulkóðuð svo enginn geti lesið þau, þ.m.t. Google.</translation>
<translation id="2059365270911640413">Ljúktu við uppsetningu Jatter</translation>
<translation id="2168108852149185974">Einhverjar viðbætur valda því að Jatter hrynur. Fjarlægðu:</translation>
<translation id="2168593389981132306">Fáðu enn meira út úr Jatter</translation>
<translation id="2178608107313874732">Jatter getur ekki notað myndavélina sem stendur</translation>
<translation id="2195025571279539885">Viltu að Jatter bjóðist næst til að þýða síður á <ph name="LANGUAGE_NAME" /> á þessu vefsvæði?</translation>
<translation id="22313767259766852">Þetta heimilisfang er vistað á Jatter eins og stendur. Til að nota það í Google-vörum skaltu vista það á Google-reikningnum þínum: <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Þetta þýðir að Jatter biður alltaf um skjáborðsútgáfu vefsvæðis.</translation>
<translation id="2245694534483711162">Gemini kann að nota nákvæma staðsetningu þína, eftir því hvaða heimild þú hefur þegar gefið Jatter</translation>
<translation id="2270466829363945454">Verslun</translation>
<translation id="2313870531055795960">Ber vefslóðir saman við lista yfir óörugg vefsvæði sem er vistaður í Jatter. Ef vefsvæði reynir að stela aðgangsorðinu þínu, eða ef þú sækir skaðlega skrá, gæti Jatter einnig sent vefslóðir í Örugga vefskoðun, þar á meðal hluta af innihaldi síðna.</translation>
<translation id="2314220608288760290">Jatter opnar YouTube-huliðstengla sjálfkrafa í huliðsstillingu.</translation>
<translation id="231828342043114302">Til að fá sérsniðið innihald byggt á þínum áhugamálum skaltu skrá þig inn á Jatter.</translation>
<translation id="2326738825692478496">Einhver Jatter-gögn hafa ekki enn verið vistuð á Google-reikningnum þínum.

Prófaðu að bíða í nokkrar mínútur áður en þú skráir þig út. Ef þú skráir þig út núna verður þessum gögnum eytt.</translation>
<translation id="2337722506862731008">Deila Jatter</translation>
<translation id="2340423701577464731">Bæta leslistaatriði við Jatter</translation>
<translation id="2374627437126809292">Jatter notar Google-kort til að sýna þér leiðarlýsingu og staðbundnar upplýsingar um heimilisföng sem greinast.</translation>
<translation id="2386292341327187942">Sláðu inn „Jatter“ í Leitargræjureitinn</translation>
<translation id="2389827884654658221">Hafðu greiðan aðgang að Jatter af stikunni á heimaskjánum í iPad.</translation>
<translation id="2426113998523353159">Fyrirtækið þitt krefst þess að þú skráir þig inn til að nota Jatter.</translation>
<translation id="2450140762465183767">Núna getur þú notað Jatter hvenær sem þú ýtir á tengil í skilaboðum, skjölum og öðrum forritum.</translation>
<translation id="2459183986985456602">Opna síðasta flipa í Jatter.</translation>
<translation id="2476409803017965813">Þú getur uppfært valið þitt hvenær sem er í stillingum Jatter.</translation>
<translation id="2478931088402984578">Veldu <ph name="BEGIN_BOLD" />Jatter<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Stilla Jatter sem sjálfgefinn vafra til að deila og opna tengla á auðveldan hátt</translation>
<translation id="2512597191798760956">Haltu Jatter-tákninu inni og smelltu á „Breyta heimaskjá“</translation>
<translation id="2517624234762908348">Samstilla Jatter gögnin þín</translation>
<translation id="2575968074225731646">Opnaðu Jatter hraðar úr iPhone-dokkunni þinni.</translation>
<translation id="2592940277904433508">Halda áfram að nota Jatter</translation>
<translation id="2607609479243848905">Ef þú gleymdir aðgangsorðinu eða vilt breyta þessari stillingu skaltu <ph name="BEGIN_LINK" />eyða Jatter-gögnunum á reikningnum þínum<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Ábending frá Jatter: Leitaðu að því sem þú sérð með Google-linsu</translation>
<translation id="2650312721222849884">Kveiktu á samstillingu til að sjá flipana þína hvar sem þú notar Jatter</translation>
<translation id="2684230048001240293">Notaðu Jatter sem sjálfgefinn kost til að samstilla flipa, aðgangsorð og greiðsluupplýsingar í öllum tækjunum þínum</translation>
<translation id="2729836253097154631">Skráðu þig inn í Jatter til að fá aðgang að gögnunum þínum</translation>
<translation id="2730884209570016437">Jatter getur ekki notað myndavélina því að annað forrit er að nota hana</translation>
<translation id="2742952311155593352">Þú ert næstum búin(n) að setja upp Jatter!</translation>
<translation id="2798503587425057129">Opnar leslista Jatter.</translation>
<translation id="28276745681323897">Þú getur <ph name="BEGIN_LINK" />stjórnað því hvaða Jatter-gögn eru vistuð<ph name="END_LINK" /> á Google-reikningnum þínum.

Til að skoða fleiri stillingar sem nota gögn til að bæta Jatter-upplifunina þína skaltu fara í <ph name="BEGIN_LINK" />Google-þjónustur<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Leita með röddinni í Jatter.</translation>
<translation id="2843571538056574338">Nota Jatter til sjálfvirkrar útfyllingar</translation>
<translation id="2918709798697875261">Fyrirtækið þitt krefst þess að þú skráir þig ekki inn í Jatter.</translation>
<translation id="2942241131342758843">Notaðu Jatter sem sjálfgefinn valkost til að opna tengla, leita í græjum og til sjálfvirkrar útfyllingar aðgangsorða í öðrum forritum</translation>
<translation id="2977470724722393594">Jatter er uppfært</translation>
<translation id="3044857325852340337">Jatter-gögnum var eytt</translation>
<translation id="3054480780637153380">Opnaðu stillingar Jatter í iOS, ýttu síðan á „Sjálfgefið vafraforrit“ og veldu Jatter.</translation>
<translation id="3115956258722352278">Gera Jatter að sjálfgefnum vafra?</translation>
<translation id="3180939591219927904">Kveiktu á „Læsa huliðsflipum þegar þú lokar Jatter“</translation>
<translation id="328933489847748230">{count,plural, =1{Sýnir 1 Jatter-glugga}one{Sýnir {count} Jatter-glugga}other{Sýnir {count} Jatter-glugga}}</translation>
<translation id="3344973607274501920">Jatter gat ekki athugað aðgangsorðin þín. Athugaðu nettenginguna þína.</translation>
<translation id="3366305173356742781">Jatter-gögn á reikningnum þínum</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Þetta gerist þegar Jatter er ekki í notkun í {THRESHOLD} mín. Þetta getur falið í sér feril og sjálfvirka útfyllingu.}one{Þetta gerist þegar Jatter er ekki í notkun í {THRESHOLD} mín. Þetta getur falið í sér feril og sjálfvirka útfyllingu.}other{Þetta gerist þegar Jatter er ekki í notkun í {THRESHOLD} mín. Þetta getur falið í sér feril og sjálfvirka útfyllingu.}}</translation>
<translation id="3410395242749598859">Einhver Jatter-gögn hafa ekki enn verið vistuð á <ph name="EMAIL" /> þínum.
Prófaðu að bíða í nokkrar mínútur áður en þú skiptir um reikning. Ef þú skiptir um reikning núna verður þessum gögnum eytt.</translation>
<translation id="3420586870838853527">Ábending frá Jatter: Enn öruggari vefskoðun bjargar deginum</translation>
<translation id="3440830787838130530">Þú getur deilt afriti af aðgangsorðinu þínu með fjölskylduhópnum þínum á einfaldan og öruggan hátt í Google-aðgangsorðastjórnun</translation>
<translation id="3472200483164753384">Ekki stutt í Jatter Canary</translation>
<translation id="347967311580159871">Til að skoða fleiri stillingar sem nota gögn til að bæta Jatter-upplifunina þína skaltu fara í <ph name="BEGIN_LINK" />Google-þjónustur<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Aðgangsorðinu var ekki deilt. Athugaðu nettenginguna og gakktu úr skugga um að þú sért skráð(ur) inn á Jatter. Reyndu svo aftur.</translation>
<translation id="3529798650269984835">Kveiktu á „Læsa huliðsflipum þegar þú lokar Jatter“.</translation>
<translation id="3541247799006476453">Fáðu auðveldan aðgang að aðgangsorðunum og aðgangslyklunum þínum með Jatter fyrir sjálfvirka útfyllingu</translation>
<translation id="3567399274263440288">Skráðu þig inn í Jatter með Google reikningnum þínum svo að Jatter nýtist þér sem best.</translation>
<translation id="3581385059720151202">Nota myndaleit í Jatter</translation>
<translation id="3582640969619785896">Jatter býðst til að vista aðgangsorðið þitt</translation>
<translation id="3594315078412605236">Stjórna greiðslumátum í Jatter</translation>
<translation id="3617143087229977194">Opnaðu stillingar fyrir sjálfgefin forrit í iOS, ýttu síðan á „Vafraforrit“ og veldu Jatter.</translation>
<translation id="3634039384458740619">Opna Jatter-stillingar</translation>
<translation id="3639997914391704523">Jatter getur athugað aðgangsorðin þín þegar þú skráir þig inn með Google reikningnum þínum</translation>
<translation id="372658070733623520">Staðfestu að þetta sért þú til að nota og vista Jatter-gögn á Google-reikningnum þínum.</translation>
<translation id="3728124580182886854">Tengdu Jatter við aðrar Google-þjónustur til að sérsníða upplifun þína og fleira</translation>
<translation id="377649297473651452">Stækkað yfirlit yfir sjálfvirka útfyllingu í Jatter</translation>
<translation id="3780779443901618967">Varar þig við hættulegum vefsvæðum, jafnvel þeim sem Google hafði enga vitneskju um, með því að greina fleiri gögn frá vefsvæðum en hefðbundin vörn. Þú getur valið að sleppa Jatter-viðvörunum.</translation>
<translation id="3805899903892079518">Jatter hefur ekki aðgang að myndunum þínum eða myndskeiðum. Veittu aðgang í iOS Settings &gt; Privacy &gt; Photos.</translation>
<translation id="3816686541346279443">Jatter býðst til að vista aðgangsorðið þitt.</translation>
<translation id="3827545470516145620">Þú er með staðlaða öryggisvörn í þessu tæki</translation>
<translation id="3833326979834193417">Jatter keyrir öryggisathugun sjálfkrafa daglega til að verja þig gegn öryggisbrotum, ótraustum vefsvæðum og fleiru. Þú færð frekari upplýsingar um öryggisathugun í stillingunum.</translation>
<translation id="3837584850181228767">Jatter-ráð: Enn öruggari vefskoðun</translation>
<translation id="3845223911364528001">Farðu aftur í Jatter til að hlaða skránni upp</translation>
<translation id="3855938650519180865">Nýjungar í Jatter</translation>
<translation id="3886689467633467988">Skráðu þig inn á þetta vefsvæði og Jatter til að fá bókamerkin þín og fleira í öll tækin þín.</translation>
<translation id="3949514465204582407">Ábending um Jatter: Sjáðu aðgangsorðin þín í hvaða forriti sem er</translation>
<translation id="4005283307739974863">Opnar og keyrir öryggisathugun í Jatter.</translation>
<translation id="4043291146360695975">Aðgangsorð eru aðeins vistuð í aðgangsorðastjórnun í þessu tæki.</translation>
<translation id="4066426933127344530">Notaðu Jatter sem sjálfgefinn vafra</translation>
<translation id="4087314024407094071">Opnar stillingar í Jatter.</translation>
<translation id="4099085513035183040">Ekki stutt í Jatter Beta</translation>
<translation id="4106512142782407609">Skráð(ur) inn sem <ph name="EMAIL" />.

Gögnin þín eru dulkóðuð með aðgangsorði. Sláðu það inn til að nota og vista Jatter-gögn á Google-reikningnum þínum.</translation>
<translation id="4118287192800900567">Jatter-ráð: Skráðu þig inn í Jatter</translation>
<translation id="4195557071150719219">Sjá nýlega flipa í Jatter</translation>
<translation id="420541179527342563">Til að slökkva á Lockdown Mode í Jatter þarftu að slökkva á því í iPad-tækinu þínu.</translation>
<translation id="4272892696084633551">Hjálpaðu til við að bæta eiginleika og afköst Jatter</translation>
<translation id="4302397443352897529">Stillingar Jatter</translation>
<translation id="4408912345039114853">Keyra öryggisathugun Jatter</translation>
<translation id="4432744876818348753">Skráðu þig inn til að fá sem mest út úr Jatter.</translation>
<translation id="4445228361214254027">Fyrirtækið þitt slökkti á möguleikanum á að nota og vista Jatter-gögn á Google-reikningnum þínum. Ný bókamerki, aðgangsorð og fleira verður aðeins vistað í þessu tæki.</translation>
<translation id="4498832288620833153">Bætir innfærðum vefslóðum við leslistann þinn í Jatter.</translation>
<translation id="4508268628669724828">Komdu aftur hingað fyrir nytsamlegri ábendingar um að fá sem mest út úr Jatter.</translation>
<translation id="452436063477828504">Gakktu úr skugga um að þú getir alltaf notað Jatter-gögnin á Google-reikningnum þínum</translation>
<translation id="4527452566931097835">Stilla Jatter sem sjálfgefinn vafra?</translation>
<translation id="4555020257205549924">Þegar þessi eiginleiki er virkur mun Jatter bjóðast til að þýða vefsíður sem eru ritaðar á öðru tungumáli með Google Translate. <ph name="BEGIN_LINK" />Frekari upplýsingar<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Dulkóðun aðgangsorða felur ekki í sér greiðslumáta og vefföng.

Til að breyta þessari stillingu skaltu <ph name="BEGIN_LINK" />eyða Jatter-gögnunum á reikningnum þínum<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Ábending frá Jatter: Notaðu Jatter sem sjálfgefinn vafra</translation>
<translation id="458786853569524949">Núna getur þú notað Jatter hvenær sem þú ýtir á tengil í tölvupóstum, skjölum og öðrum forritum.</translation>
<translation id="4633738821577273991">Fáðu „Enn öruggari vefskoðun“ fyrir þennan Jatter-prófíl líka</translation>
<translation id="4654936625574199632">Jatter sendir notkunar- og hrunskýrslur til Google til að bæta forritið. <ph name="BEGIN_LINK" />Stjórna<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Kveiktu á Jatter skanna</translation>
<translation id="4685611756167369067">Opna huliðsflipa í Jatter</translation>
<translation id="4736424910885271643">Reikningurinn þinn er í umsjón <ph name="HOSTED_DOMAIN" /> og því verður Jatter gögnunum þínum eytt úr þessu tæki</translation>
<translation id="4790638144988730920">Haltu áfram að nota Jatter-gögnin á Google-reikningnum þínum.</translation>
<translation id="4828317641996116749">Jatter gat ekki athugað öll aðgangsorð. Reyndu aftur síðar.</translation>
<translation id="4856138222358683580">Jatter-aðgerðir</translation>
<translation id="4904452304169763785">Viðvaranir varðandi öll persónuverndar- eða öryggismál sem Jatter greinir fyrir þig.</translation>
<translation id="4908570938463711775">Kynntu þér grunnatriði Jatter til að hefjast handa</translation>
<translation id="4962295957157529683">Ljúktu því sem þú ert að gera í öðrum opnum Jatter-glugga.</translation>
<translation id="4985291216379576555">Ótengt, Jatter getur ekki leitað að uppfærslum.</translation>
<translation id="4996471330284142407">Komdu meiru í verk með einfaldari, öruggari og hraðari Jatter.</translation>
