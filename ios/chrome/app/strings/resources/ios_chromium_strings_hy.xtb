<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1000436330784933699">Տեսապակին կարող եք բացել այստեղ։</translation>
<translation id="1042296835509784301">Բացում է Գաղտնաբառերի կառավարիչը Jatter-ում։</translation>
<translation id="1047130070405668746">Ընտրեք Jatter-ը։</translation>
<translation id="1091252999271033193">Սա նշանակում է, որ Jatter-ը միշտ կփորձի բացել կայքի բջջային տարբերակը։</translation>
<translation id="1115463765356382667">Կատարեք այս առաջարկվող գործողությունները՝ Jatter-ի բոլոր հնարավորություններից օգտվելու համար։</translation>
<translation id="1185134272377778587">Jatter-ի մասին</translation>
<translation id="1211450393895337634">Դուք կարող եք ավելի արագ բացել Jatter-ը iPad-ում։</translation>
<translation id="1229234641991056119">Օգտագործեք Safari-ի ձեր գաղտնաբառերը, պատմությունը, էջանիշները և վարկային քարտերը Jatter-ում</translation>
<translation id="1257458525759135959">Պատկերները պահելու համար հպեք Կարգավորումներին և թույլատրեք Jatter-ին ավելացնել դրանք ձեր լուսանկարներին։</translation>
<translation id="1260702988262336471">Բացեք Jatter-ի ընտրացանկը</translation>
<translation id="12739128458173458">Այս ներդիրը մեկ այլ սարք ուղարկելու համար երկու սարքերում մուտք գործեք Jatter։</translation>
<translation id="1361748954329991663">Jatter-ը հնացել է։ Եթե <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" />-ում թարմացում հասանելի չէ, ապա հնարավոր է՝ ձեր սարքը Jatter-ի նոր տարբերակներն այլևս չի աջակցում։</translation>
<translation id="1383876407941801731">Որոնում</translation>
<translation id="1423007117030725713">Սկսեք որոնել Jatter-ի նոր ներդիրում:</translation>
<translation id="1431818719585918472">Թույլ տվեք Jatter-ին կողպել ձեր ինկոգնիտո ներդիրները։</translation>
<translation id="1451665391191990528">Թաքցնել բաց ինկոգնիտո ներդիրները, երբ դուրս գաք Jatter-ից</translation>
<translation id="146407871188825689">Օգտագործեք Jatter-ը որպես կանխադրված դիտարկիչ iPad-ում</translation>
<translation id="1471084500615228555">Ջնջել այցելությունների պատմությունը Jatter-ում</translation>
<translation id="1472013873724362412">Ձեր հաշիվը չի աշխատում Jatter-ում: Մուտք գործելու համար դիմեք ձեր տիրույթի ադմինիստրատորին կամ օգտագործեք սովորական Google հաշիվ:</translation>
<translation id="148576268809812097">Պահեք ձեր գաղտնաբառերը Jatter-ում</translation>
<translation id="1501302548410882220">Օգտագործեք Jatter-ն ամենուրեք</translation>
<translation id="1502360822835740515">Դարձրեք Jatter-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="1503199973012840174">Jatter-ի ձեր տարբերակը հնացած է։ Ձեր տվյալների ապահովության համար թարմացրեք այն։</translation>
<translation id="1515748263297244785">Օգտագործեք Jatter-ը որպես կանխադրված դիտարկիչ iPad-ի համար</translation>
<translation id="1531155317299575425">Ցույց է տալիս հաղորդագրություն Jatter-ում մուտք գործելու համար։</translation>
<translation id="1553657876656159572">Հատուկ ֆիդ՝ ստեղծված ձեզ համար։ Ֆիդը ներառում է լուրեր, սպորտային նորություններ և եղանակի տեսություն։</translation>
<translation id="1561849081734670621">Jatter-ում արգելափակման ռեժիմն անջատելու համար անջատեք այն ձեր iPhone-ում։</translation>
<translation id="1569258826720962327">iOS սարքում ընտրեք «Գործողություններ Jatter-ում»</translation>
<translation id="1573441572176948907">Տեղափոխեք Jatter-ը Dock վահանակ</translation>
<translation id="159029779861043703">Jatter-ը պաշտպանում է ձեր զգայուն տվյալները Face ID-ի միջոցով։</translation>
<translation id="1591119736686995611">Բացում է Jatter-ի ներդիրների ցանցը։</translation>
<translation id="16001233025397167">Անվտանգության ստուգումը պաշտպանում է ձեզ տվյալների արտահոսքից, վտանգավոր կայքերից և այլ խնդիրներից։ Jatter-ը կզգուշացնի գաղտնիության և անվտանգության հետ կապված խնդիրների մասին, որոնք կհայտնաբերի։</translation>
<translation id="1617663976202781617">Տվյալներ Jatter Sync-ից</translation>
<translation id="164952285225495380">Այս առաքանին արդեն հետագծվել է Jatter-ում։</translation>
<translation id="1707458603865303524">Օգտագործեք Jatter-ը ցանկացած ժամանակ, երբ հղումների եք հպում հաղորդագրություններում կամ այլ հավելվածներում։</translation>
<translation id="1722370509450468186">Գաղտնաբառը կպահվի ձեր հաշվում (<ph name="EMAIL" />)։</translation>
<translation id="1747088204252710672">Հատուկ ֆիդ՝ ստեղծված ձեզ համար</translation>
<translation id="1811860791247653035">Անհատականացումը և այլ գործառույթներ կարգավորելու համար ավելացրեք Jatter-ն այստեղ՝ <ph name="FEATURE_NAME_1" /> և <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Jatter-ը հաստատել է, որ <ph name="ISSUER" />-ն է թողարկել վեբկայքի հավաստագիրը:</translation>
<translation id="1839447949248872139">Բացեք հղումները Jatter-ում ըստ կանխադրման</translation>
<translation id="1843424232666537147">Jatter-ի գործառույթները կօգնեն ձեզ կառավարել թրաֆիկի սպառման և էջերի բեռնման արագությունները:
<ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Քարտեզները Jatter-ում</translation>
<translation id="1867772173333403444">4. Ընտրեք Jatter-ը։</translation>
<translation id="1965068424387304464">Jatter-ի հետ աշխատելու խորհուրդ․ պահեք գաղտնաբառերը</translation>
<translation id="2006345422933397527">Jatter-ին չհաջողվեց ստուգել թարմացումների առկայությունը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="2042889939382983733">Դիտել Jatter-ի պատմությունը</translation>
<translation id="2052320862053429062">Jatter-ը պարբերաբար hամեմատում է ձեր գաղտնաբառերը ցուցակների հետ, որոնք հրապարակվել են առցանց։ Այդ ժամանակ ձեր գաղտնաբառերը և օգտանունները գաղտնագրվում են, այնպես որ ոչ ոք, այդ թվում՝ Google-ը, չի կարող կարդալ դրանք։</translation>
<translation id="2059365270911640413">Ավարտեք Jatter-ի կարգավորումը</translation>
<translation id="2168108852149185974">Որոշ հավելումներ առաջացնում են Jatter-ի աշխատանքի խափանում: Հեռացրեք դրանք՝</translation>
<translation id="2168593389981132306">Օգնեք բարելավել Jatter-ի աշխատանքը</translation>
<translation id="2178608107313874732">Այս պահին Jatter-ը չի կարող օգտագործել ձեր ֆոտոխցիկը</translation>
<translation id="2195025571279539885">Ուզո՞ւմ եք, որ Jatter-ն այսուհետ առաջարկի թարգմանել այս կայքի <ph name="LANGUAGE_NAME" /> էջերը:</translation>
<translation id="22313767259766852">Այս հասցեն ներկայումս պահված է Jatter-ում։ Պահեք հասցեն Google հաշվում (<ph name="USER_EMAIL" />), որպեսզի այն օգտագործեք Google-ի տարբեր պրոդուկտներում։</translation>
<translation id="2236584955986023187">Սա նշանակում է, որ Jatter-ը միշտ կփորձի բացել կայքի ամբողջական տարբերակը։</translation>
<translation id="2245694534483711162">Gemini-ը կարող է օգտագործել ձեր ճշգրիտ տեղադրությունը՝ կախված Jatter-ին արդեն տրված թույլտվություններից</translation>
<translation id="2270466829363945454">Խանութ</translation>
<translation id="2313870531055795960">Ստուգում է URL-ները Jatter-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, Jatter-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="2314220608288760290">Jatter-ը ինկոգնիտո ռեժիմում YouTube տեսանյութերի հղումները ավտոմատ բացում է ինկոգնիտո ռեժիմում։</translation>
<translation id="231828342043114302">Ձեր հետաքրքրությունների հիման վրա անհատականացված բովանդակություն ստանալու համար մուտք գործեք Jatter։</translation>
<translation id="2326738825692478496">Ձեր Jatter-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։

Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="2337722506862731008">Կիսվել Jatter-ով</translation>
<translation id="2340423701577464731">Ավելացնել ընթերցանության ցանկին Jatter-ում</translation>
<translation id="2374627437126809292">Jatter-ն օգտագործում է Google Քարտեզները՝ ձեզ գտնված հասցեների մասին տեղեկություններ ցուցադրելու և դեպի այդ վայրեր երթուղիներ գծելու համար։</translation>
<translation id="2386292341327187942">«Որոնման վիջեթներ» դաշտում մուտքագրեք Jatter</translation>
<translation id="2389827884654658221">Ավելի արագ բացեք Jatter-ը ձեր iPad-ի հիմնական էկրանից։</translation>
<translation id="2426113998523353159">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք հաշիվ, որպեսզի կարողանաք օգտագործել Jatter-ը։</translation>
<translation id="2450140762465183767">Այժմ հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումները կարող եք բացել Jatter-ում։</translation>
<translation id="2459183986985456602">Բացել իմ վերջին ներդիրը Jatter-ում։</translation>
<translation id="2476409803017965813">Դուք ցանկացած ժամանակ կարող եք թարմացնել ձեր ընտրությունները Jatter-ի կարգավորումներում։</translation>
<translation id="2478931088402984578">Ընտրեք <ph name="BEGIN_BOLD" />Jatter-ը<ph name="END_BOLD" />։</translation>
<translation id="2485774047568879945">Դարձրեք Jatter-ը ձեր կանխադրված դիտարկիչը՝ հղումներով հեշտությամբ կիսվելու և դրանք բացելու համար</translation>
<translation id="2512597191798760956">Սեղմեք Jatter-ի պատկերակը և պահեք, ապա ընտրեք «Փոփոխել հիմնական էկրանը»</translation>
<translation id="2517624234762908348">Համաժամացնել Jatter-ի տվյալները</translation>
<translation id="2575968074225731646">Ավելի արագ բացեք Jatter-ը ձեր iPhone-ի Dock վահանակից։</translation>
<translation id="2592940277904433508">Շարունակել Jatter-ի օգտագործումը</translation>
<translation id="2607609479243848905">Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Jatter-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="2640367368802736659">Խորհուրդ Jatter-ից․ ձեր տեսածը գտեք Google Տեսապակու օգնությամբ</translation>
<translation id="2650312721222849884">Jatter-ն օգտագործելիս ձեր բոլոր ներդիրները տեսնելու համար միացրեք համաժամացումը։</translation>
<translation id="2684230048001240293">Դարձրեք Jatter-ը ձեր կանխադրված դիտարկիչը՝ ներդիրները, գաղտնաբառերը և վճարային տվյալները ձեր բոլոր սարքերում համաժամացնելու համար</translation>
<translation id="2729836253097154631">Մուտք գործեք Jatter՝ ձեր բովանդակությունն օգտագործելու համար</translation>
<translation id="2730884209570016437">Jatter-ը չի կարող օգտագործել ձեր ֆոտոխցիկը, քանի որ այն օգտագործվում է մեկ այլ հավելվածի կողմից</translation>
<translation id="2742952311155593352">Դուք գրեթե ավարտել եք Jatter-ի կարգավորումը</translation>
<translation id="2798503587425057129">Բացում է Jatter-ի ընթերցանության ցանկը։</translation>
<translation id="28276745681323897">Ձեր Google հաշվում կարող եք <ph name="BEGIN_LINK" />կառավարել, թե Jatter-ի ինչ տվյալներ պահվեն<ph name="END_LINK" />։

Որպեսզի իմանաք ավելին կարգավորումների մասին, որոնք Jatter-ի բարելավման նպատակով տվյալներ են օգտագործում, անցեք <ph name="BEGIN_LINK" />Google-ի ծառայություններ<ph name="END_LINK" />։</translation>
<translation id="2832168932648876507">Որոնել ձայնի միջոցով Jatter-ում։</translation>
<translation id="2843571538056574338">Օգտագործեք Jatter-ը ինքնալրացման համար</translation>
<translation id="2918709798697875261">Ձեր կազմակերպության կանոնների համաձայն՝ մուտքը Jatter արգելվում է։</translation>
<translation id="2942241131342758843">Դարձրեք Jatter-ը ձեր կանխադրված դիտարկիչը՝ հղումներ բացելու, վիջեթներից որոնելու և այլ հավելվածներում գաղտնաբառերի ինքնալրացման համար</translation>
<translation id="2977470724722393594">Jatter-ը թարմացված է</translation>
<translation id="3044857325852340337">Տվյալները ջնջվել են Jatter-ից</translation>
<translation id="3054480780637153380">Բացեք Jatter-ի կարգավորումները iOS-ում, ապա հպեք «Դիտարկիչի կանխադրված հավելված» և ընտրեք Jatter-ը։</translation>
<translation id="3115956258722352278">Դարձնե՞լ Jatter-ը ձեր կանխադրված դիտարկիչը</translation>
<translation id="3180939591219927904">Միացրեք «Կողպեք ինկոգնիտո ներդիրները, երբ փակեք Jatter-ը»</translation>
<translation id="328933489847748230">{count,plural, =1{Այժմ ցուցադրվում է Jatter-ի 1 պատուհան}one{Այժմ ցուցադրվում է Jatter-ի {count} պատուհան}other{Այժմ ցուցադրվում է Jatter-ի {count} պատուհան}}</translation>
<translation id="3344973607274501920">Jatter-ին չհաջողվեց ստուգել ձեր գաղտնաբառերը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="3366305173356742781">Jatter-ի տվյալները ձեր հաշվում</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում։ Դա կարող է ներառել պատմությունը և ինքնալրացված տվյալները։}one{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում։ Դա կարող է ներառել պատմությունը և ինքնալրացված տվյալները։}other{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում։ Դա կարող է ներառել պատմությունը և ինքնալրացված տվյալները։}}</translation>
<translation id="3410395242749598859">Ձեր Jatter-ի որոշ տվյալներ դեռ չեն պահվել <ph name="EMAIL" /> հաշվում։
Նախքան հաշիվները փոխելը մի քանի րոպե սպասեք։ Եթե հաշիվները փոխեք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="3420586870838853527">Խորհուրդ Jatter-ից․ օգտագործեք բարելավված Ապահով դիտարկումը</translation>
<translation id="3440830787838130530">Հեշտությամբ և ապահով կերպով կիսվեք գաղտնաբառի պատճենով ձեր ընտանեկան խմբի հետ Google գաղտնաբառերի կառավարչում</translation>
<translation id="3472200483164753384">Չի աջակցվում Jatter Canary-ում</translation>
<translation id="347967311580159871">Որպեսզի իմանաք ավելին կարգավորումների մասին, որոնք Jatter-ի բարելավման նպատակով օգտագործում են տվյալներ, անցեք <ph name="BEGIN_LINK" />Google-ի ծառայություններ<ph name="END_LINK" />։</translation>
<translation id="3512168799938877162">Ձեր գաղտնաբառը չի փոխանցվել։ Ստուգեք ինտերնետ կապը և համոզվեք, որ մուտք եք գործել Jatter։ Այնուհետև նորից փորձեք։</translation>
<translation id="3529798650269984835">Միացրեք «Կողպել ինկոգնիտո ներդիրները, երբ փակում եք Jatter-ը» գործառույթը։</translation>
<translation id="3541247799006476453">Ինքնալրացման համար Jatter-ի միջոցով հեշտությամբ մուտք գործեք ձեր գաղտնաբառեր և մուտքի բանալիներ</translation>
<translation id="3567399274263440288">Jatter-ի բոլոր գործառույթներն օգտագործելու համար մտեք ձեր Google հաշիվ։</translation>
<translation id="3581385059720151202">Որոնել պատկերներ Jatter-ում</translation>
<translation id="3582640969619785896">Jatter-ը կառաջարկի պահել ձեր գաղտնաբառը</translation>
<translation id="3594315078412605236">Կառավարել վճարման եղանակները Jatter-ում</translation>
<translation id="3617143087229977194">Բացեք կանխադրված հավելվածների կարգավորումները iOS-ում, ապա հպեք «Դիտարկիչի հավելված» և ընտրեք Jatter-ը։</translation>
<translation id="3634039384458740619">Բացել Jatter-ի կարգավորումները</translation>
<translation id="3639997914391704523">Jatter-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ մտնեք Google հաշիվ։</translation>
<translation id="372658070733623520">Jatter-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար հաստատեք ձեր ինքնությունը։</translation>
<translation id="3728124580182886854">Կապեք Jatter-ը Google-ի մյուս ծառայությունների հետ՝ անհատականացման և այլ գործընթացների համար</translation>
<translation id="377649297473651452">Ինքնալրացման ծավալված դիտակերպ Jatter-ում</translation>
<translation id="3780779443901618967">Զգուշացնում է ձեզ վտանգավոր, այդ թվում՝ Google-ին նախկինում անհայտ կայքերի մասին, քանի որ ավելի շատ տվյալներ է վերլուծում կայքերում՝ համեմատած ստանդարտ պաշտպանության հետ։ Դուք կարող եք բաց թողնել Jatter-ի նախազգուշացումները։</translation>
<translation id="3805899903892079518">Jatter-ին հասանելի չեն ձեր լուսանկարները կամ տեսանյութերը: Անցեք iOS Կարգավորումներ &gt; Գաղտնիություն &gt; Լուսանկարներ (Settings &gt; Privacy &gt; Photos) և միացրեք մուտքի թույլտվությունը:</translation>
<translation id="3816686541346279443">Jatter-ը կառաջարկի պահել ձեր գաղտնաբառը։</translation>
<translation id="3827545470516145620">Այս սարքում միացված է անվտանգության ստանդարտ ռեժիմը</translation>
<translation id="3833326979834193417">Jatter-ն ամեն օր ավտոմատ գործարկում է անվտանգության ստուգումը, որպեսզի պաշտպանի ձեզ տվյալների արտահոսքից, վտանգավոր կայքերից և այլն։ Անվտանգության ստուգման մասին կարող եք ավելին իմանալ Կարգավորումներում։</translation>
<translation id="3837584850181228767">Jatter-ի հետ աշխատելու խորհուրդ․ օգտագործեք բարելավված Ապահով դիտարկումը</translation>
<translation id="3845223911364528001">Վերադարձեք Jatter՝ ձեր ֆայլը վերբեռնելու համար</translation>
<translation id="3855938650519180865">Ինչ նոր բան կա Jatter-ում</translation>
<translation id="3886689467633467988">Մտեք հաշիվ այս կայքում և Jatter-ում՝ ձեր էջանիշները և մյուս տվյալները ձեր բոլոր սարքերում օգտագործելու համար։</translation>
<translation id="3949514465204582407">Խորհուրդ Jatter-ից. մուտքագրեք ձեր գաղտնաբառերը ցանկացած հավելվածում</translation>
<translation id="4005283307739974863">Բացում և գործարկում է անվտանգության ստուգումը Jatter-ում։</translation>
<translation id="4043291146360695975">Գաղտնաբառերը պահվում են միայն այս սարքի Գաղտնաբառերի կառավարիչում</translation>
<translation id="4066426933127344530">Օգտագործեք Jatter-ն ըստ կանխադրման</translation>
<translation id="4087314024407094071">Բացում է կարգավորումները Jatter-ում։</translation>
<translation id="4099085513035183040">Չի աջակցվում Jatter-ի բետա տարբերակում</translation>
<translation id="4106512142782407609">Դուք մուտք եք գործել որպես <ph name="EMAIL" />։

Ձեր տվյալները գաղտնագրված են անցաբառով։ Jatter-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="4118287192800900567">Jatter-ի հուշում․ մուտք գործեք Jatter-ում</translation>
<translation id="4195557071150719219">Տեսնել Jatter-ի վերջին բացած ներդիրները</translation>
<translation id="420541179527342563">Jatter-ում արգելափակման ռեժիմն անջատելու համար անջատեք այն ձեր iPad-ում։</translation>
<translation id="4272892696084633551">Օգնեք բարելավել Jatter-ի գործառույթներն ու աշխատանքը</translation>
<translation id="4302397443352897529">Jatter-ի կարգավորումներ</translation>
<translation id="4408912345039114853">Գործարկել Jatter-ի անվտանգության ստուգումը</translation>
<translation id="4432744876818348753">Մտեք հաշիվ՝ Jatter-ի բոլոր գործառույթներից օգտվելու համար։</translation>
<translation id="4445228361214254027">Ձեր կազմակերպությունն անջատել է Jatter-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու հնարավորությունը։ Նոր էջանիշները, գաղտնաբառերը և այլ տվյալներ կպահվեն միայն այս սարքում։</translation>
<translation id="4498832288620833153">Ավելացնում է մուտքագրված URL-ը ձեր ընթերցանության ցանկին Jatter-ում։</translation>
<translation id="4508268628669724828">Վերադարձեք այստեղ, որպեսզի լրացուցիչ խորհուրդներ ստանաք՝ Jatter-ն ավելի արդյունավետ օգտագործելու համար։</translation>
<translation id="452436063477828504">Համոզվեք, որ միշտ կարող եք օգտվել Jatter-ի տվյալներից ձեր Google հաշվում</translation>
<translation id="4527452566931097835">Դարձնե՞լ Jatter-ը կանխադրված դիտարկիչ</translation>
<translation id="4555020257205549924">Եթե միացնեք այս գործառույթը, Jatter-ը կառաջարկի թարգմանել այլ լեզուներով ներկայացված էջերը Google Translate-ի միջոցով: <ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Անցաբառով գաղտնագրումը չի կիրառվում վճարման եղանակների և հասցեների համար։

Այս կարգավորումը փոխելու համար <ph name="BEGIN_LINK" />ջնջեք Jatter-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="4578500311756617174">Խորհուրդ Jatter-ից․ օգտագործեք Jatter-ն ըստ կանխադրման</translation>
<translation id="458786853569524949">Այժմ էլ․ նամակներում, փաստաթղթերում և այլ հավելվածներում առկա հղումները կարող եք բացել Jatter-ում։</translation>
<translation id="4633738821577273991">Կիրառեք նաև բարելավված Ապահով դիտարկումն այս Jatter պրոֆիլի համար</translation>
<translation id="4654936625574199632">Հավելվածը բարելավելու նպատակով Jatter-ը ուղարկում է օգտագործման և խափանումների մասին տվյալները Google-ին։ <ph name="BEGIN_LINK" />Կառավարել<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Միացրեք Jatter-ի սկաները</translation>
<translation id="4685611756167369067">Բացել ինկոգնիտո ներդիր Jatter-ում</translation>
<translation id="4736424910885271643">Jatter-ում պահվող ձեր բոլոր տվյալները կջնջվեն այս սարքից, քանի որ ձեր հաշիվը կառավարվում է <ph name="HOSTED_DOMAIN" /> տիրույթի կողմից</translation>
<translation id="4790638144988730920">Շարունակեք օգտագործել Jatter-ի տվյալները ձեր Google հաշվում։</translation>
<translation id="4828317641996116749">Jatter-ին չհաջողվեց ստուգել բոլոր գաղտնաբառերը։ Փորձեք ավելի ուշ։</translation>
<translation id="4856138222358683580">Գործողություններ Jatter-ում</translation>
<translation id="4904452304169763785">Զգուշացումներ Jatter-ից՝ գաղտնիության և անվտանգության հետ կապված խնդիրների մասին, որոնք կհայտնաբերի։</translation>
<translation id="4908570938463711775">Jatter-ով աշխատանքը սկսելու համար ծանոթացեք հիմնական օգտակար տեղեկություններին</translation>
<translation id="4962295957157529683">Ավարտեք աշխատանքը Jatter-ի մյուս բացված պատուհանում։</translation>
<translation id="4985291216379576555">Կապ չկա, Jatter-ը չի կարող ստուգել թարմացումների առկայությունը</translation>
<translation id="4996471330284142407">Դուք կարող եք ավելի արդյունավետ աշխատել պարզ, ապահով և արագագործ Jatter դիտարկիչի օգնությամբ։</translation>
<translation id="4999538639245140991">Դուք դուրս եք գալիս <ph name="SIGNOUT_MANAGED_DOMAIN" /> տիրույթի ադմինիստրատորի կողմից կառավարվող հաշվից: Նկատի առեք, որ Jatter-ի տվյալները սարքից կհեռացվեն, սակայն կմնան ձեր Google հաշվում:</translation>
<translation id="5042011327527167688">Հպեք «Դիտել Google Քարտեզների Jatter-ում»։</translation>
<translation id="5044871537677053278">Jatter-ը գտնում է հասցեները և օգտագործում Google Քարտեզները՝ երթուղիներ գծելու և տեղական տեղեկություններ տրամադրելու համար։</translation>
<translation id="5048140766121299007">«<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />» կարգավորումներից միացրեք «Jatter»-ը</translation>
<translation id="5053429694249468757">Jatter-ի տվյալները ջնջվում են…</translation>
<translation id="5071749685031362629">Jatter՝ iOS-ի համար</translation>
<translation id="5124429847818367226">Այժմ հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում առկա հղումները կարող եք բացել Jatter-ում։</translation>
<translation id="5131565040785979529">Ձեր կազմակերպությունը (<ph name="DOMAIN" />) կառավարում է ձեր մտած հաշիվը և այն, թե ինչպես է Jatter-ն օգտագործվում։</translation>
<translation id="5134464247000681876">Բացեք հղումներ Gmail-ից, Քարտեզներից, YouTube-ից և այլ հավելվածներից Jatter-ում</translation>
<translation id="5203244847421322551">Պահեք և ավտոմատ լրացրեք գաղտնաբառերը Jatter-ում</translation>
<translation id="5218806323985098884">Իմացեք, թե ինչ նոր բան կա Jatter-ում</translation>
<translation id="5224391634244552924">Պահված գաղտնաբառեր չկան։ Jatter-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք։</translation>
<translation id="5259423875997548710">Պատկերների որոնում Jatter-ում։</translation>
<translation id="5284913972719948193">Ներմուծեք ձեր գաղտնաբառերը, որոնման պատմությունը, էջանիշները և վարկային քարտի տվյալները Jatter</translation>
<translation id="5308226104666789935">Jatter-ին չհաջողվեց ստուգել թարմացումների առկայությունը</translation>
<translation id="5311557153294205270">Ավելացնում է մուտքագրված URL-ները Jatter-ի ձեր էջանիշներում։</translation>
<translation id="5383251701169024761">Պահված գաղտնաբառերն այլ հավելվածներում հեշտությամբ մուտքագրելու համար ընտրեք ինքնալրացման գործառույթը Jatter-ում։</translation>
<translation id="538767207339317086">Թույլատրել մուտքը Jatter-ում</translation>
<translation id="5389058611415066188">Եղեք պաշտպանված Jatter-ի հետ</translation>
<translation id="5414059596208264343">Խորհուրդ Jatter-ից․ ստացեք ձեր գաղտնաբառերի հասանելիություն</translation>
<translation id="5415273218238091735">Խորհուրդ Jatter-ից</translation>
<translation id="5427571867875391349">Դարձնել Jatter-ը կանխադրված դիտարկիչը</translation>
<translation id="5434562575369834882">Բացել Jatter-ի ինկոգնիտո ներդիրում</translation>
<translation id="5453478652154926037">Jatter-ը չի կարող ստուգել ձեր գաղտնաբառերը։</translation>
<translation id="5479292367402350143">Jatter-ը ձեր կանխադրված դիտարկիչը դարձնելու համար՝
1. Բացեք կարգավորումները։
2. Հպեք «Դիտարկիչի կանխադրված հավելված»։
3. Ընտրեք Jatter-ը։</translation>
<translation id="5482686278086727777">Jatter-ից ներդիրների մասին հիշեցումներ ստանալու համար iOS-ի կարգավորումներում միացրեք ծանուցումները։</translation>
<translation id="5521125884468363740">Jatter-ն օգտագործելիս ձեր բոլոր ներդիրները տեսնելու համար մտեք հաշիվ և միացրեք համաժամացումը։</translation>
<translation id="5534584691915394889">Սա կօգտագործվի՝ ձեր Apple Calendar-ում Jatter-ից և Google Տեսապակուց միջոցառումներ ստեղծելու համար։</translation>
<translation id="5571094606370987472">Բացում է Jatter-ի վերջերս բեռնած ներդիրների ցանկը։</translation>
<translation id="5596644122344097310">Հպեք այստեղ՝ ձեր iPhone-ում Jatter-ի բոլոր հնարավորություններից օգտվելու համար։</translation>
<translation id="5603085937604338780">chromium</translation>
<translation id="5657280937522795751">Անցեք Jatter-ին</translation>
<translation id="5664395081284292058">Բացել իմ վերջին ներդիրը Jatter-ում</translation>
<translation id="5671188105328420281">Jatter-ին վերաբերող խորհուրդներ</translation>
<translation id="5688047395118852662">Այս քարտում ցուցադրված են հուշումներ, թե ինչպես օգտվել Jatter-ի բոլոր հնարավորություններից։</translation>
<translation id="5700709190537129682">Jatter-ը չի կարող ստուգել ձեր գաղտնաբառերը</translation>
<translation id="5731004036450828399">Ձեր մուտքի բանալիներն անվտանգ պահելու համար նախ պետք է ստեղծեք վերականգնման PIN կոդ։

        Մուտքի բանալիները պահվում են Գաղտնաբառերի կառավարչում, որը թույլ է տալիս օգտագործել դրանք Jatter-ի միջոցով ցանկացած սարքում։</translation>
<translation id="584550191241316896">Դուք մուտք եք գործել Jatter-ում</translation>
<translation id="5862307444128926510">Բարի գալուստ Jatter</translation>
<translation id="5889847953983052353">Երբ գործառույթը միացված է.
<ph name="BEGIN_INDENT" />  • Օգնեք ավելի լավը դարձնել Jatter-ը ձեզ նման օգտատերերի համար։<ph name="END_INDENT" />

Ինչ է պետք հաշվի առնել.
<ph name="BEGIN_INDENT" />  • Google-ին տեղեկություններ են ուղարկվում Jatter-ի օգտագործման մասին, սակայն դրանք կապված չեն ձեզ հետ։

  • Եթե Jatter-ը խափանվում է, խափանման մասին մանրամասները կարող են ներառել որոշ անձնական տեղեկություններ։

  • Եթե համաժամացնեք ձեր պատմությունը ձեր Google հաշվի հետ, ցուցանիշները կարող են ներառել նաև տեղեկություններ ձեր այցելած էջերի մասին։<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Ջնջել այցելությունների պատմությունը Jatter-ում։</translation>
<translation id="593808800391107017">Jatter-ը կզգուշացնի գաղտնիության և անվտանգության հետ կապված խնդիրների մասին, որոնք ավտոմատ կհայտնաբերի։</translation>
<translation id="5951593919357934226">Օգտվեք Jatter-ի բոլոր հնարավորություններից։</translation>
<translation id="5985254578475526217">Jatter-ից ծանուցումներ ստանալու համար ձեր iOS-ի կարգավորումներում միացրեք ծանուցումները։</translation>
<translation id="6041226255405329731">Մուտք գործեք Jatter՝ ներդիրների խմբերով կիսվելու, դրանց միանալու կամ դրանցում նույն գաղափարների շուրջ միասին աշխատելու համար</translation>
<translation id="6104024151682120539">Բացել Jatter-ում</translation>
<translation id="61109258320235597">Jatter-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="6132149203299792222">Մուտք գործեք Google հաշիվ՝ ձեր գաղտնաբառերը, էջանիշները և այլ տվյալներ համաժամացնելու համար։</translation>
<translation id="6148377327556085395">Ավելացնել էջանիշներ Jatter-ում</translation>
<translation id="6154098560469640583">Օգտագործեք Jatter-ը ցանկացած ժամանակ, երբ հղումների եք հպում հաղորդագրություններում, փաստաթղթերում և այլ հավելվածներում։</translation>
<translation id="6157162508956739031">Արագ մուտք գործեք հավելվածներ և կայքեր՝ ավտոմատ լրացնելով ձեր գաղտնաբառերն ու մուտքի բանալիները Jatter-ից</translation>
<translation id="6170619162539716595">Թույլատրեք Jatter-ին օգտագործել Google Քարտեզները՝ ձեզ գտնված հասցեների մասին տեղեկություններ ցուցադրելու և դեպի այդ վայրեր երթուղիներ գծելու համար։</translation>
<translation id="6247557882553405851">Google գաղտնաբառերի կառավարիչ</translation>
<translation id="6268381023930128611">Դուրս գա՞լ Jatter-ից:</translation>
<translation id="6301717043141881464">Պահված գաղտնաբառերն այլ հավելվածներում հեշտությամբ մուտքագրելու համար ընտրեք ինքնալրացման գործառույթը Jatter-ում</translation>
<translation id="6324041800010509197">Այցելել ներդիրների ցանց Jatter-ում</translation>
<translation id="6325378625795868881">Օգտագործեք Jatter-ը ցանկացած ժամանակ, երբ հղումների եք հպում հաղորդագրություններում և այլ հավելվածներում։</translation>
<translation id="6387994184698195448">Ստացեք Jatter-ի վերաբերյալ խորհուրդներ և այլ օգտակար տեղեկություններ։</translation>
<translation id="6424492062988593837">Jatter-ը կատարելագործվել է: Մատչելի է նոր տարբերակ:</translation>
<translation id="6433172051771630690">Խորհուրդներ, թե ինչպես օգտվել Jatter-ի բոլոր հնարավորություններից։</translation>
<translation id="65045991564554105">Jatter-ի էջանիշների դիտում</translation>
<translation id="6519797228806907665">Ավելի արագ բացեք Jatter-ը ձեր iPhone-ի հիմնական էկրանից։</translation>
<translation id="6538713818758208754">Բացում է վճարման եղանակների կարգավորման էջը Jatter-ում։</translation>
<translation id="6540186279384079894">Բացել նոր ներդիր Jatter-ում</translation>
<translation id="6563921047760808519">Իմացեք ավելին, թե <ph name="BEGIN_LINK" />ինչպես է Jatter-ը պահպանում ձեր տվյալների գաղտնիությունը<ph name="END_LINK" /></translation>
<translation id="6564769014061914792">Հպեք այստեղ՝ ձեր iPad-ում Jatter-ի բոլոր հնարավորություններից օգտվելու համար։</translation>
<translation id="6566303693324540692">Խորհուրդ Jatter-ից․ ավելացրեք Jatter-ը հիմնական էկրանին</translation>
<translation id="6574750762636192517">Գաղտնաբառերի կառավարում Jatter-ում</translation>
<translation id="6590232959690355435">Բացում է Jatter-ի պատմության էջը։</translation>
<translation id="6649269674808477353">Դուք կարող եք ավելի արագ բացել Jatter-ը iPhone-ում։</translation>
<translation id="6674470628873622334">Բացում է նոր ինկոգնիտո ներդիր Jatter-ում։</translation>
<translation id="6680609900732453726">Ձեր դիտարկումը գաղտնի պահեք սարքի իսկորոշման միջոցով, երբ փակեք Jatter-ը</translation>
<translation id="6752854822223394465">Ձեր կազմակերպությունը կարգավորում է Jatter-ը…</translation>
<translation id="6794054469102824109">Բացում է Jatter Dino խաղը։</translation>
<translation id="6820823224820483452">Jatter-ին չհաջողվեց ստուգել բոլոր գաղտնաբառերը։ Վաղը նորից փորձեք։</translation>
<translation id="6830782797004194206">Ավելի արագ մտեք հաշիվ Jatter-ի ավտոմատ լրացման միջոցով</translation>
<translation id="6831043979455480757">Թարգմանել</translation>
<translation id="6852419005633611413">Ավելի արագ բացեք Jatter-ը հիմնական էկրանի Dock վահանակից</translation>
<translation id="6852799557929001644">Օգտագործեք Jatter-ում և այլ հավելվածներում պահված ձեր գաղտնաբառերն ու ավելին այս սարքում։</translation>
<translation id="6887138405044152640">Այս ներդիրը մեկ այլ սարք ուղարկելու համար մուտք գործեք Jatter այդ սարքում։</translation>
<translation id="6911341667534646387">Շարունակեք օգտագործել Jatter-ի տվյալները ձեր Google հաշվում</translation>
<translation id="7018284295775193585">Չհաջողվեց թարմացնել Jatter-ը</translation>
<translation id="7055269218854630176">Ձեր կազմակերպությունը (<ph name="DOMAIN" />) կառավարում է ձեր մտած հաշիվը և այն, թե ինչպես կարող է Jatter-ն օգտագործվել։ Ձեր ադմինիստրատորը կարող է կարգավորել և սահմանափակել որոշակի գործառույթներ։</translation>
<translation id="7099326575020694068">Jatter-ը չի կարող օգտագործել ֆոտոխցիկը տրոհված տեսքի ռեժիմում</translation>
<translation id="7165402419892018581">«Ինքնալրացում» պարամետրի համար ընտրեք Jatter-ը</translation>
<translation id="7175400662502680481">Տվյալների արտահոսքի արդյունքում ձեր գաղտնաբառը հայտնի է դարձել կողմնակի անձանց։ Գաղտնաբառերի կառավարիչը խորհուրդ է տալիս անհապաղ փոխել այն։</translation>
<translation id="7185731475720473450">Վճարման եղանակները և հասցեները չեն գաղտնագրվի։ Jatter-ի այցելությունների պատմությունը չի համաժամացվի։

Միայն ձեր անցաբառն ունեցող մարդիկ կարող են կարդալ ձեր գաղտնագրված տվյալները։ Անցաբառը չի ուղարկվում Google-ին կամ պահվում նրա կողմից։ Եթե մոռացել եք ձեր անցաբառը կամ ուզում եք փոխել այս կարգավորումը, <ph name="BEGIN_LINK" />ջնջեք Jatter-ի տվյալները ձեր հաշվում<ph name="END_LINK" />։</translation>
<translation id="7192111075364461693">Jatter-ի ծանուցումներն այս պահին անջատված են սարքի կարգավորումներում։</translation>
<translation id="7195217321165708458">Gemini-ը Jatter</translation>
<translation id="7219205286115692265">Ավելի արագ բացեք Jatter-ը ձեր iPad-ի հիմնական էկրանի Dock վահանակից։</translation>
<translation id="7222001353246886083">Որոնեք ${searchPhrase} Jatter-ում</translation>
<translation id="7228180817326917122">Խորհուրդ Jatter-ից․ ընտրեք հասցեագոտու դիրքը</translation>
<translation id="725427773388857052">Jatter-ը կարող է պաշտպանել տվյալների արտահոսքից, վտանգավոր կայքերից և այլ խնդիրներից</translation>
<translation id="7269362888766543920">Որոշ հավելումներ առաջացնում են Jatter-ի աշխատանքի խափանում: Փորձեք հեռացնել դրանք:</translation>
<translation id="7285031092584344905">Օգտագործեք Jatter-ում պահված ձեր գաղտնաբառերը և ավելին այլ հավելվածներում։</translation>
<translation id="7337881442233988129">Jatter</translation>
<translation id="7395825497086981028">Գաղտնաբառը կպահվի <ph name="EMAIL" /> հաշվի Գաղտնաբառերի կառավարիչում։</translation>
<translation id="7434848749522628428">Այս մուտքի բանալին կպահվի <ph name="USER_EMAIL" /> հաշվի Գաղտնաբառերի կառավարչում</translation>
<translation id="7504829997542308412">Բացեք Jatter-ը</translation>
<translation id="7531461704633548377">Jatter-ից</translation>
<translation id="7554983317097061001">Խորհուրդ Jatter-ից․ տեղափոխեք Jatter-ը Dock վահանակ</translation>
<translation id="7576863740961052505">Jatter-ի կարգավորումների կառավարում</translation>
<translation id="7674213385180944843">Անցեք Կարգավորումներ &gt; Գաղտնիություն &gt; Տեսախցիկ &gt; Jatter և միացրեք ֆոտոխցիկը:</translation>
<translation id="7733418656985455268">Խորհուրդ Jatter-ից․ որոնեք Տեսապակու միջոցով</translation>
<translation id="7747820849741499258">Որոնում Jatter-ում</translation>
<translation id="7753923083404296545">Բացված է Jatter-ի ինկոգնիտո ներդիրում</translation>
<translation id="7762622637388462191">Կողպեք ձեր ինկոգնիտո ներդիրները, երբ դուրս եք գալիս Jatter-ից կամ անցնում այլ հավելված։</translation>
<translation id="7763454117143368771">Դարձրեք Jatter-ը ձեր կանխադրված դիտարկիչը՝ վտանգավոր կայքերից պաշտպանվելու և ձեր գաղտնաբառերն ապահով պահելու համար</translation>
<translation id="7784950022329154821">Կողպել ինկոգնիտո ներդիրները, երբ փակում եք Jatter-ը</translation>
<translation id="78025249032851484">Jatter-ի ձեր տարբերակը հնացած է։</translation>
<translation id="7859018312476869945">Երբ դուք տեքստ եք մուտքագրում հասցեագոտում կամ որոնման դաշտում, Jatter-ը ձեր հարցումն ուղարկում է կանխադրված որոնողական համակարգին՝ ավելի լավ առաջարկներ ստանալու համար։ Այս գործառույթն անջատված է ինկոգնիտո ռեժիմում։</translation>
<translation id="7890287942691234100">Ինչպես օգտագործել Jatter-ի սկաները</translation>
<translation id="7905064834449738336">Երբ գաղտնաբառ եք օգտագործում, Jatter-ը զգուշացնում է ձեզ, եթե այն հրապարակվել է համացանցում։ Այդ ժամանակ ձեր գաղտնաբառերը և օգտանունները գաղտնագրվում են, այնպես որ ոչ ոք, այդ թվում՝ Google-ը, չի կարող կարդալ դրանք։</translation>
<translation id="7928628054454574139">Բացեք Jatter-ն ամեն անգամ, երբ այլ հավելվածներում հպում եք հղումների</translation>
<translation id="7934404985878918282">Դիտել Jatter-ի ընթերցանության ցանկը</translation>
<translation id="7935734571048689933">Jatter-ը կառավարվում է</translation>
<translation id="7951793218148208717">Բացում է նոր ներդիր Jatter-ում։</translation>
<translation id="7957726318578167662">Օգտագործեք Jatter-ը՝ հաղորդագրություններում կամ այլ հավելվածներում առկա հղումները հեշտությամբ բացելու համար։</translation>
<translation id="7980860476903281594">Jatter-ը կիսվում է ձեր տեղադրության տվյալներով այն կայքերի հետ, որոնց համար տվել եք թույլտվություն։</translation>
<translation id="7994322153108931467">Jatter-ի վերաբերյալ օգտակար խորհուրդներ ստանալու համար iOS-ի կարգավորումներում միացրեք ծանուցումները։</translation>
<translation id="7997159823054171568">Դարձնել Jatter-ը կանխադրված դիտարկիչ</translation>
<translation id="800380310260616129">Ներբեռնեք Jatter-ը այստեղ։</translation>
<translation id="8013573822802650211">Jatter-ն օգտագործելիս ձեր բոլոր ներդիրները տեսնելու համար մտեք հաշիվ բոլոր սարքերում։</translation>
<translation id="8014091604604659473">Դուք դուրս եք եկել Jatter-ից</translation>
<translation id="8104697640054703121">Առավելագույնս պաշտպանվեք վտանգավոր կայքերից Jatter-ում</translation>
<translation id="8119542592987737574">Ավելի արագ բացեք Jatter-ը ձեր iPhone-ի հիմնական էկրանի Dock վահանակից։</translation>
<translation id="8164086860209325020">Բացեք Jatter-ի կարգավորումները</translation>
<translation id="8197822717502700527">Այժմ դուք կարող եք օգտվել Jatter-ի բոլոր հնարավորություններից</translation>
<translation id="8240981428553046115">Jatter-ին չհաջողվեց ստուգել թարմացումների առկայությունը։ Փորձեք ավելի ուշ։</translation>
<translation id="8254729934443216898">Ուսումնասիրեք նոր գործառույթները, որոնք օգնում են առավելագույն արդյունավետությամբ օգտագործել Jatter-ը։</translation>
<translation id="8293572045658095405">Դուք Jatter-ի ինկոգնիտո ռեժիմում եք</translation>
<translation id="830951810931292870">Մուտքագրված URL-ները բացվում են Jatter-ի ինկոգնիտո ներդիրում։</translation>
<translation id="8385503371191508165">Պահեք մուտքի բանալիները Գաղտնաբառերի կառավարչում</translation>
<translation id="8390323835464055390">Մուտք գործեք ձեր պահպանված գաղտնաբառերով և մուտքի բանալիներով ցանկացած հավելվածից՝ օգտագործելով Jatter-ը ավտոմատ լրացման համար</translation>
<translation id="8409374867500149834">Jatter-ի ամենահուսալի անվտանգության համակարգը պաշտպանում է ձեզ վնասաբեր կայքերից</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում։ Տվյալները, որոնք պահվել են այս սարքում ձեր մուտք գործած ժամանակ, կջնջվեն։ Դա կարող է ներառել պատմությունը և գաղտնաբառերը։}one{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում։ Տվյալները, որոնք պահվել են այս սարքում ձեր մուտք գործած ժամանակ, կջնջվեն։ Դա կարող է ներառել պատմությունը և գաղտնաբառերը։}other{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում։ Տվյալները, որոնք պահվել են այս սարքում ձեր մուտք գործած ժամանակ, կջնջվեն։ Դա կարող է ներառել պատմությունը և գաղտնաբառերը։}}</translation>
<translation id="8586442755830160949">© <ph name="YEAR" /> The Jatter Authors: Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8602103377623855616">Jatter-ի էջ</translation>
<translation id="865600487977764604">Ապահովում է ձեր անվտանգությունը Jatter-ում և Google հավելվածներում, երբ դուք գտնվում եք ձեր հաշվում։</translation>
<translation id="8663480472502753423">Jatter-ը թարմացված պահեք</translation>
<translation id="8685813584220679697">Մուտք գործեք այս կայք և Jatter։</translation>
<translation id="8698780336333802489">Ներմուծել Jatter</translation>
<translation id="8730503818204408000">Բացում է կարգավորումները, որտեղ կարելի է Jatter-ը դարձնել կանխադրված դիտարկիչ։</translation>
<translation id="8754966941001340678">Բարելավված պաշտպանությունը խորհուրդ է տրվում Jatter-ի կողմից</translation>
<translation id="8759037115129007407">Ձեր ընտանիքի անդամն այս պահին չի կարող գաղտնաբառեր ստանալ։ Խնդրեք նրան թարմացնել Jatter-ը և համաժամացնել իր գաղտնաբառերը։ <ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">Jatter-ը ամենուր ձեզ հետ է</translation>
<translation id="8776843108004031667">Այս հաշիվը և բոլոր չպահված տվյալները կհեռացվեն Jatter-ից։</translation>
<translation id="8793333988063379360">Այստեղ կարող եք գտնել Jatter-ի կարգավորումները և ոչ միայն</translation>
<translation id="8805148242934787134">Դարձնել Jatter-ը կանխադրված դիտարկիչ</translation>
<translation id="8826789549860004832">Օգտվեք Jatter-ի բոլոր հնարավորություններից՝ շարունակելով կարգավորել ձեր դիտարկիչը։</translation>
<translation id="88376265765385899">Բացում է Jatter-ի էջանիշները։</translation>
<translation id="8860548555286245440">Բացեք URL-ները Jatter-ի ինկոգնիտո ներդիրում</translation>
<translation id="8880024619507699923">Ձեր կազմակերպության կանոնների համաձայն՝ դուք պետք է մուտք գործեք հաշիվ, որպեսզի կարողանաք օգտագործել Jatter-ը։ <ph name="BEGIN_LINK" />Իմանալ ավելին<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">Ուժեղացրեք Jatter-ի անվտանգությունը</translation>
<translation id="8908791447256515663">Ավելի արագ բացեք Jatter-ը ձեր iPad-ի Dock վահանակից։</translation>
<translation id="8925569192291721236">Ստացեք գների հետագծման թարմացումներ և Jatter-ի վերաբերյալ խորհուրդներ։</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում}one{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում}other{Սա տեղի է ունենում, երբ Jatter-ը {THRESHOLD} րոպե չի օգտագործվում}}</translation>
<translation id="8963279154877372067">Թույլատրեք Jatter-ին ուղարկել ծանուցումներ, որպեսզի տեղեկանաք գների իջեցման մասին</translation>
<translation id="8975812008711371178">Ձայնի միջոցով որոնում Jatter-ում</translation>
<translation id="900560297598578021">Դուք մուտք եք գործել որպես <ph name="EMAIL" />։

Ձեր տվյալները գաղտնագրվել են ձեր անցաբառով <ph name="TIME" />։ Jatter-ի տվյալները ձեր Google հաշվում օգտագործելու և պահելու համար մուտքագրեք ձեր անցաբառը։</translation>
<translation id="9022552996538154597">Մուտք գործել Jatter</translation>
<translation id="9031260906956926157">Ձեր Jatter-ի որոշ տվյալներ դեռ չեն պահվել ձեր Google հաշվում։
Նախքան դուրս գալը մի քանի րոպե սպասեք։ Եթե դուրս գաք հիմա, այս տվյալները կջնջվեն։</translation>
<translation id="9050790730841755540">Օգտագործեք Jatter-ը ցանկացած ժամանակ, երբ հղումների եք հպում այլ հավելվածներում։</translation>
<translation id="9059693977935746710">Այս գաղտնաբառը հիշելու կարիք չկա։ Այն կպահվի <ph name="EMAIL" /> հաշվի Գաղտնաբառերի կառավարիչում։</translation>
<translation id="9089354809943900324">Jatter-ը հնացել է</translation>
<translation id="9105645282262300612">Jatter-ի խորհուրդ․ որոնեք այն, ինչ տեսնում եք</translation>
<translation id="9152995302810511799">Խորհուրդ Jatter-ից․ ստացեք Jatter-ի ամենահուսալի պաշտպանությունը</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />։ Jatter-ը կառավարվում է։</translation>
<translation id="921174536258924340">Jatter-ին չհաջողվեց ստուգել բոլոր գաղտնաբառերը։ Վաղը նորից փորձեք կամ <ph name="BEGIN_LINK" />գաղտնաբառերը ստուգեք ձեր Google հաշվում<ph name="END_LINK" />։</translation>
<translation id="924957577793602335">Անհատականացրեք Jatter-ը</translation>
