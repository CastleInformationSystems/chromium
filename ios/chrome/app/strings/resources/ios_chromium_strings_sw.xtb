<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="1000436330784933699">Unaweza kufungua Lenzi hapa.</translation>
<translation id="1042296835509784301">Hufungua Kidhibiti cha Manenosiri kwenye Jatter.</translation>
<translation id="1047130070405668746">Chagua Jatter</translation>
<translation id="1091252999271033193">Hii inamaanisha kwamba Jatter itahitaji tovuti ya kifaa cha mkononi kila wakati.</translation>
<translation id="1115463765356382667">Kamilisha vitendo hivi vilivyopendekezwa hapa chini ili unufaike zaidi na Jatter.</translation>
<translation id="1185134272377778587">Kuhusu Jatter</translation>
<translation id="1211450393895337634">Fungua Jatter kwa haraka zaidi ukiwa tayari kuvinjari kwenye iPad yako.</translation>
<translation id="1229234641991056119">Tumia manenosiri, historia, alamisho na kadi zako za mikopo za Safari kwenye Jatter</translation>
<translation id="1257458525759135959">Ili uhifadhi picha, gusa Mipangilio ili uruhusu Jatter iweke kwenye picha zako</translation>
<translation id="1260702988262336471">Fungua menyu ya Jatter</translation>
<translation id="12739128458173458">Ili utume kichupo hiki kwenye kifaa kingine, ingia katika akaunti kwenye Jatter katika vifaa vyote viwili.</translation>
<translation id="1361748954329991663">Toleo hili la Jatter limepitwa na wakati. Iwapo hakuna sasisho kwenye <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" />, kuna uwezekano kuwa kifaa chako hakitumii tena matoleo mapya ya Jatter.</translation>
<translation id="1383876407941801731">Tafuta</translation>
<translation id="1423007117030725713">Anza kutafuta ukitumia kichupo kipya cha Jatter.</translation>
<translation id="1431818719585918472">Ruhusu Jatter ifunge vichupo vyako Fiche.</translation>
<translation id="1451665391191990528">Ficha Vichupo vya faragha ulivyofungua unapoondoka kwenye Jatter</translation>
<translation id="146407871188825689">Kutumia Jatter kwenye iPad kwa Chaguomsingi</translation>
<translation id="1471084500615228555">Futa data ya kuvinjari kwenye Jatter</translation>
<translation id="1472013873724362412">Akaunti yako haifanyi kazi kwenye Jatter. Tafadhali wasiliana na msimamizi wako wa kikoa au utumie Akaunti ya kawaida ya Google kuingia.</translation>
<translation id="148576268809812097">Hifadhi Manenosiri Yako katika Jatter</translation>
<translation id="1501302548410882220">Kutumia Jatter kila mahali</translation>
<translation id="1502360822835740515">Fanya Jatter iwe kivinjari chako chaguomsingi</translation>
<translation id="1503199973012840174">Toleo lako la Jatter limepitwa na wakati. Lisasishe ili uimarishe usalama.</translation>
<translation id="1515748263297244785">Tumia Jatter kwa chaguomsingi kwenye iPad</translation>
<translation id="1531155317299575425">Huonyesha vidokezo vya kuingia katika akaunti kwenye Jatter.</translation>
<translation id="1553657876656159572">Mipasho maalum tuliyokuandalia. Ikiwa ni pamoja na habari, spoti na hali ya hewa.</translation>
<translation id="1561849081734670621">Ili uzime Hali ya Kufunga katika Jatter, izime kwenye iPhone yako.</translation>
<translation id="1569258826720962327">Tumia vitendo vya Jatter kwenye iOS</translation>
<translation id="1573441572176948907">Hamishia Jatter kwenye sehemu yako ya kupachika</translation>
<translation id="159029779861043703">Jatter huweka data yako nyeti salama kwa kutumia Face ID.</translation>
<translation id="1591119736686995611">Hufungua Gridi ya Kichupo cha Jatter.</translation>
<translation id="16001233025397167">Kipengele cha Ukaguzi wa Usalama hukulinda dhidi ya ufichuzi haramu wa data, tovuti zisizo salama na zaidi. Pokea arifa kuhusu matatizo yoyote ya faragha au ya usalama ambayo Jatter itatambua kuwa yanakuathiri.</translation>
<translation id="1617663976202781617">Data kutoka usawazishaji wa Jatter</translation>
<translation id="164952285225495380">Kifurushi hiki tayari kimefuatiliwa kwenye Jatter.</translation>
<translation id="1707458603865303524">Tumia Jatter wakati wowote unapogusa viungo kwenye ujumbe au programu nyingine.</translation>
<translation id="1722370509450468186">Nenosiri lako litahifadhiwa katika Akaunti yako (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Mipasho maalum tuliyokuandalia</translation>
<translation id="1811860791247653035">Ili upate mapendeleo na vipengele vingine, jumuisha Jatter kwenye <ph name="FEATURE_NAME_1" /> pamoja na <ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">Jatter imethibitisha kuwa <ph name="ISSUER" /> ndiye mtoa cheti cha tovuti hii.</translation>
<translation id="1839447949248872139">Fungua viungo katika Jatter kwa Chaguomsingi</translation>
<translation id="1843424232666537147">Jatter ina vipengele vinavyokusaidia kudhibiti data yako ya intaneti na kasi unayoweza kupakia nayo kurasa za wavuti.
<ph name="BEGIN_LINK" />Pata maelezo zaidi<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Ramani katika Jatter</translation>
<translation id="1867772173333403444">4. Chagua Jatter</translation>
<translation id="1965068424387304464">Kidokezo cha Jatter: Hifadhi Manenosiri</translation>
<translation id="2006345422933397527">Jatter imeshindwa kukagua kama kuna masasisho. Jaribu kuangalia muunganisho wako wa Intaneti.</translation>
<translation id="2042889939382983733">Kuangalia Historia Yako ya Jatter</translation>
<translation id="2052320862053429062">Jatter hukagua mara kwa mara manenosiri yako ikilinganisha na orodha ambazo zimechapishwa mtandaoni. Wakati inafanya hivyo, manenosiri na majina yako ya mtumiaji huwa yamesimbwa kwa njia fiche, kwa hivyo hayawezi kusomwa na mtu mwingine, ikiwemo Google.</translation>
<translation id="2059365270911640413">Maliza kuweka mipangilio ya Jatter</translation>
<translation id="2168108852149185974">Baadhi ya programu jalizi husababisha Jatter iache kufanya kazi. Tafadhali ondoa:</translation>
<translation id="2168593389981132306">Boresha Jatter</translation>
<translation id="2178608107313874732">Jatter haiwezi kutumia kamera yako hivi sasa</translation>
<translation id="2195025571279539885">Je, ungependa Jatter ijitolee kutafsiri kurasa za <ph name="LANGUAGE_NAME" /> kwenye tovuti hii wakati ujao?</translation>
<translation id="22313767259766852">Anwani hii kwa sasa imehifadhiwa kwenye Jatter. Ili uitumie kwenye bidhaa mbalimbali za Google, ihifadhi kwenye Akaunti yako ya Google, <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Hii inamaanisha kwamba Jatter itahitaji tovuti ya kompyuta kila wakati.</translation>
<translation id="2245694534483711162">Gemini inaweza kutumia eneo mahususi uliko, kulingana na ruhusa ambazo tayari umeipa Jatter</translation>
<translation id="2270466829363945454">Kununua</translation>
<translation id="2313870531055795960">Hukagua URL ili kuona iwapo zipo kwenye orodha ya tovuti zisizo salama zilizohifadhiwa katika Jatter. Ikiwa tovuti inajaribu kuiba nenosiri lako au unapopakua faili hatari, Jatter inaweza pia kutuma URL, ikiwa ni pamoja na sehemu za maudhui ya ukurasa, kwa kipengele cha Kuvinjari Salama.</translation>
<translation id="2314220608288760290">Jatter hufungua kiotomatiki viungo vya Faraghani vya YouTube katika hali ya Faraghani.</translation>
<translation id="231828342043114302">Ili upokee maudhui yaliyowekewa mapendeleo kulingana na mambo yanayokuvutia, ingia katika akaunti kwenye Jatter.</translation>
<translation id="2326738825692478496">Baadhi ya data yako ya Jatter bado haijahifadhiwa kwenye Akaunti yako ya Google.

Jaribu kusubiri kwa dakika chache kabla ya kuondoka kwenye akaunti. Ukiondoka kwenye akaunti sasa, data hii itafutwa.</translation>
<translation id="2337722506862731008">Tuma Jatter</translation>
<translation id="2340423701577464731">Weka kipengee cha orodha ya kusoma kwenye Jatter</translation>
<translation id="2374627437126809292">Jatter hutumia Ramani za Google kukupatia maelekezo na maelezo ya eneo husika kwenye anwani zilizotambuliwa.</translation>
<translation id="2386292341327187942">Kwenye kisanduku cha Wijeti za Utafutaji, weka Jatter</translation>
<translation id="2389827884654658221">Fikia Jatter kwa haraka zaidi katika Skrini ya Kwanza ya iPad yako.</translation>
<translation id="2426113998523353159">Shirika lako linahitaji uingie katika akaunti ili uweze kutumia Jatter.</translation>
<translation id="2450140762465183767">Sasa unaweza kutumia Jatter wakati wowote unapogusa viungo katika ujumbe, hati na programu zingine.</translation>
<translation id="2459183986985456602">Fungua kichupo changu kipya zaidi kwenye Jatter.</translation>
<translation id="2476409803017965813">Unaweza kusasisha chaguo zako wakati wowote katika mipangilio ya Jatter.</translation>
<translation id="2478931088402984578">Chagua <ph name="BEGIN_BOLD" />Jatter<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Weka Jatter iwe kivinjari chako chaguomsingi ili utume na ufungue viungo kwa urahisi</translation>
<translation id="2512597191798760956">Bonyeza na ushikilie aikoni ya Jatter kisha ubofye "Badilisha skrini ya kwanza"</translation>
<translation id="2517624234762908348">Sawazisha data yako kwenye Jatter</translation>
<translation id="2575968074225731646">Fikia Jatter kwa haraka zaidi katika Sehemu ya kupachika kwenye iPhone yako.</translation>
<translation id="2592940277904433508">Endelea kutumia Jatter</translation>
<translation id="2607609479243848905">Ikiwa ulisahau kauli yako ya siri au ungependa kubadilisha mipangilio hii, <ph name="BEGIN_LINK" />futa data ya Jatter kwenye akaunti yako<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Kidokezo cha Jatter: Tafuta unachokiona ukitumia Lenzi ya Google</translation>
<translation id="2650312721222849884">Ili uone vichupo vyako kwenye kifaa chochote unakotumia Jatter, washa kipengele cha kusawazisha</translation>
<translation id="2684230048001240293">Weka Jatter iwe kivinjari chaguomsingi cha kusawazisha vichupo, manenosiri na maelezo yako ya malipo kwenye vifaa vyako vyote</translation>
<translation id="2729836253097154631">Ingia katika Jatter ili upate vipengee vyako</translation>
<translation id="2730884209570016437">Jatter imeshindwa kutumia kamera yako kwa sababu inatumiwa na programu nyingine</translation>
<translation id="2742952311155593352">Unakaribia kumaliza kuweka mipangilio ya Jatter!</translation>
<translation id="2798503587425057129">Hufungua Orodha ya Kusoma ya Jatter.</translation>
<translation id="28276745681323897">Unaweza <ph name="BEGIN_LINK" />kudhibiti data ya Jatter inayohifadhiwa<ph name="END_LINK" /> katika Akaunti yako ya Google.

Kwa mipangilio zaidi inayotumia data kuboresha hali yako ya utumiaji wa Jatter, nenda kwenye <ph name="BEGIN_LINK" />Huduma za Google<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Tafuta ukitumia sauti kwenye Jatter.</translation>
<translation id="2843571538056574338">Tumia Jatter ili Ujaze kiotomatiki</translation>
<translation id="2918709798697875261">Shirika lako linahitaji usiingie katika akaunti kwenye Jatter.</translation>
<translation id="2942241131342758843">Tumia Jatter kwa chaguomsingi kufungua viungo, kutafuta kwenye wijeti na kujaza manenosiri kiotomatiki katika programu zingine</translation>
<translation id="2977470724722393594">Jatter imesasishwa</translation>
<translation id="3044857325852340337">Umefuta data kwenye Jatter</translation>
<translation id="3054480780637153380">Fungua mipangilio ya Jatter kwenye iOS, kisha uguse "Programu Chaguomsingi ya Kivinjari" na uchague Jatter.</translation>
<translation id="3115956258722352278">Je ungependa kufanya Jatter iwe kivinjari chako chaguomsingi?</translation>
<translation id="3180939591219927904">Washa "Funga Vichupo vya Faragha unapofunga Jatter"</translation>
<translation id="328933489847748230">{count,plural, =1{Sasa inaonyesha dirisha 1 la Jatter}other{Sasa inaonyesha madirisha {count} ya Jatter}}</translation>
<translation id="3344973607274501920">Jatter imeshindwa kukagua manenosiri yako. Jaribu kuangalia muunganisho wako wa Intaneti.</translation>
<translation id="3366305173356742781">Data ya Jatter kwenye akaunti yako</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Hali hii hutokea wakati hujatumia Jatter kwa dakika {THRESHOLD}. Data hii inaweza kujumuisha historia na matukio ya kujaza kiotomatiki.}other{Hali hii hutokea wakati hujatumia Jatter kwa dakika {THRESHOLD}. Data hii inaweza kujumuisha historia na matukio ya kujaza kiotomatiki.}}</translation>
<translation id="3410395242749598859">Baadhi ya data yako ya Jatter bado haijahifadhiwa kwenye <ph name="EMAIL" />.
Jaribu kusubiri dakika chache kabla ya kubadilisha akaunti. Ukibadilisha akaunti sasa, data hii itafutwa.</translation>
<translation id="3420586870838853527">Kidokezo cha Jatter: Kipengele cha kuvinjari salama kilichoboreshwa kitakusaidia</translation>
<translation id="3440830787838130530">Tuma nakala ya nenosiri kwenye kikundi cha familia yako kwa njia salama na rahisi katika Kidhibiti cha Manenosiri cha Google</translation>
<translation id="3472200483164753384">Haitumiki kwenye Jatter Canary (toleo la jaribio)</translation>
<translation id="347967311580159871">Kwa mipangilio zaidi inayotumia data kuboresha hali yako ya utumiaji wa Jatter, nenda kwenye <ph name="BEGIN_LINK" />Huduma za Google<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Nenosiri lako halikutumwa. Kagua muunganisho wako wa intaneti na uhakikishe umeingia katika akaunti ya Jatter. Kisha, jaribu tena.</translation>
<translation id="3529798650269984835">Washa kipengele cha “Funga Vichupo vya Faragha unapofunga Jatter.”</translation>
<translation id="3541247799006476453">Pata uwezo wa kufikia funguo za siri na manenosiri yako kwa urahisi ukitumia Jatter ili Ujaze Kiotomatiki</translation>
<translation id="3567399274263440288">Ili unufaike zaidi na Jatter, ingia kwenye Jatter ukitumia Akaunti yako ya Google.</translation>
<translation id="3581385059720151202">Tafuta vipengele vinavyoonekana kwenye Jatter</translation>
<translation id="3582640969619785896">Jatter itakuomba kuhifadhi nenosiri lako</translation>
<translation id="3594315078412605236">Kudhibiti njia za kulipa kwenye Jatter</translation>
<translation id="3617143087229977194">Fungua mipangilio ya Programu Chaguomsingi katika iOS, kisha uguse "Programu ya Kivinjari" na uchague Jatter.</translation>
<translation id="3634039384458740619">Fungua Mipangilio ya Jatter</translation>
<translation id="3639997914391704523">Jatter inaweza kukagua manenosiri yako unapoingia ukitumia Akaunti ya Google.</translation>
<translation id="372658070733623520">Ili utumie na uhifadhi data ya Jatter katika Akaunti yako ya Google, thibitisha kuwa ni wewe.</translation>
<translation id="3728124580182886854">Unganisha Jatter na huduma nyingine za Google ili upate mapendeleo na madhumuni mengine</translation>
<translation id="377649297473651452">Mwonekano uliopanuliwa wa Kipengele cha Kujaza Kiotomatiki cha Jatter</translation>
<translation id="3780779443901618967">Hukutahadharisha kuhusu tovuti hatari, hata zile ambazo hazikutambuliwa na Google hapo awali, kwa kuchambua data zaidi kutoka kwenye tovuti kuliko ulinzi wa kawaida. Unaweza kuchagua kuruka tahadhari za Jatter.</translation>
<translation id="3805899903892079518">Jatter haina uwezo wa kufikia picha au video zako. Washa uwezo wa kufikia katika Mipangilio ya iOS &gt; Faragha &gt; Picha.</translation>
<translation id="3816686541346279443">Jatter itakuomba kuhifadhi nenosiri lako.</translation>
<translation id="3827545470516145620">Unapata ulinzi wa kawaida kwenye kifaa hiki</translation>
<translation id="3833326979834193417">Jatter hutekeleza kiotomatiki Ukaguzi wa Usalama kila siku ili kukulinda dhidi ya ufichuzi haramu wa data, tovuti zisizo salama na mengine. Unaweza kupata maelezo zaidi kuhusu Ukaguzi wa Usalama kwenye Mipangilio.</translation>
<translation id="3837584850181228767">Kidokezo cha Jatter: Kipengele cha Kuvinjari Salama Kilichoboreshwa</translation>
<translation id="3845223911364528001">Rudi kwenye Jatter ili upakie faili yako</translation>
<translation id="3855938650519180865">Mapya katika Jatter</translation>
<translation id="3886689467633467988">Ingia katika tovuti hii na Jatter ili upate alamisho zako na zaidi kwenye vifaa vyako vyote.</translation>
<translation id="3949514465204582407">Kidokezo cha Jatter: Pata manenosiri yako kwenye programu yoyote</translation>
<translation id="4005283307739974863">Hufungua na Kufanya Ukaguzi wa Usalama kwenye Jatter.</translation>
<translation id="4043291146360695975">Manenosiri huhifadhiwa kwenye Kidhibiti cha Manenosiri kwenye kifaa hiki tu.</translation>
<translation id="4066426933127344530">Tumia Jatter kwa chaguomsingi</translation>
<translation id="4087314024407094071">Hufungua mipangilio kwenye Jatter.</translation>
<translation id="4099085513035183040">Haitumiki kwenye toleo la Beta la Jatter</translation>
<translation id="4106512142782407609">Umeingia katika akaunti ukitumia <ph name="EMAIL" />.

Data yako imesimbwa kwa njia fiche kwa kutumia kauli yako ya siri. Iweke ili utumie na kuhifadhi data ya Jatter kwenye Akaunti yako ya Google.</translation>
<translation id="4118287192800900567">Kidokezo cha Jatter: Kuingia katika akaunti kwenye Jatter</translation>
<translation id="4195557071150719219">Angalia Vichupo vya Hivi Karibuni vya Jatter</translation>
<translation id="420541179527342563">Ili uzime Hali ya Kufunga katika Jatter, izime kwenye iPad yako.</translation>
<translation id="4272892696084633551">Tusaidie kuboresha utendaji na vipengele vya Jatter</translation>
<translation id="4302397443352897529">Mipangilio ya Jatter</translation>
<translation id="4408912345039114853">Kufanya Ukaguzi wa Usalama kwenye Jatter</translation>
<translation id="4432744876818348753">Ingia katika akaunti ili unufaike zaidi na Jatter.</translation>
<translation id="4445228361214254027">Shirika lako limezima kipengele cha kutumia na kuhifadhi data ya Jatter kwenye Akaunti yako ya Google. Alamisho, manenosiri mapya na zaidi yatahifadhiwa tu katika kifaa hiki.</translation>
<translation id="4498832288620833153">Huweka URL zilizowekwa kwenye orodha yako ya kusoma katika Jatter.</translation>
<translation id="4508268628669724828">Angalia hapa tena ili upate vidokezo muhimu zaidi na unufaike zaidi kutokana na Jatter.</translation>
<translation id="452436063477828504">Hakikisha kuwa unaweza kutumia data ya Jatter katika Akaunti yako ya Google kila wakati</translation>
<translation id="4527452566931097835">Ungependa Kuweka Jatter iwe kivinjari chaguomsingi?</translation>
<translation id="4555020257205549924">Kipengele hiki kikiwashwa, Jatter itatafsiri kurasa zilizoandikwa kwa lugha nyingine kwa kutumia Google Tafsiri. <ph name="BEGIN_LINK" />Pata maelezo zaidi<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Usimbaji fiche wa kauli ya siri haujumuishi anwani na njia za kulipa.

Ili ubadilishe mipangilio hii, <ph name="BEGIN_LINK" />futa data ya Jatter kwenye akaunti yako<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Kidokezo cha Jatter: tumia Jatter kwa chaguomsingi</translation>
<translation id="458786853569524949">Sasa unaweza kutumia Jatter wakati wowote unapogusa viungo katika barua pepe, hati na programu zingine.</translation>
<translation id="4633738821577273991">Pia, pata Kipengele cha Kuvinjari Salama Kilichoboreshwa kwenye wasifu huu wa Jatter</translation>
<translation id="4654936625574199632">Ili kusaidia kuboresha programu hii, Jatter hutuma takwimu ya matumizi na ripoti ya kuacha kufanya kazi kwenda Google. <ph name="BEGIN_LINK" />Dhibiti<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Washa kichanganuzi cha Jatter</translation>
<translation id="4685611756167369067">Kufungua Kichupo cha Faragha cha Jatter</translation>
<translation id="4736424910885271643">Akaunti yako inadhibitiwa na <ph name="HOSTED_DOMAIN" />, kwa hivyo data yako ya Jatter itafutwa kwenye kifaa hiki</translation>
<translation id="4790638144988730920">Endelea kutumia data ya Jatter katika Akaunti yako ya Google.</translation>
<translation id="4828317641996116749">Jatter imeshindwa kukagua manenosiri yote. Jaribu tena baadaye.</translation>
<translation id="4856138222358683580">Vitendo vya Jatter</translation>
<translation id="4904452304169763785">Arifa kuhusu matatizo yoyote ya faragha au ya usalama ambayo Jatter itatambua kuwa yanakuathiri.</translation>
<translation id="4908570938463711775">Fahamu mambo ya msingi yanayofaa kuhusu Jatter ili uanze</translation>
<translation id="4962295957157529683">Kamilisha ulichokuwa ukifanya kwenye dirisha jingine ulilofungua la Jatter.</translation>
<translation id="4985291216379576555">Nje ya mtandao, Jatter imeshindwa kukagua kama kuna masasisho</translation>
<translation id="4996471330284142407">Fanya mengi zaidi kwa kutumia Jatter ambayo ni rahisi, salama na yenye kasi zaidi.</translation>
<translation id="4999538639245140991">Kwa sababu unaondoka kwenye akaunti inayodhibitiwa na <ph name="SIGNOUT_MANAGED_DOMAIN" />, data yako ya Jatter itafutwa kwenye kifaa hiki, lakini itasalia katika Akaunti yako ya Google.</translation>
<translation id="5042011327527167688">Gusa “Angalia kwa kutumia Ramani za Google kwenye Jatter.”</translation>
<translation id="5044871537677053278">Jatter hutambua anwani na hutumia huduma ya Ramani za Google kukupatia maelekezo na taarifa za eneo husika.</translation>
<translation id="5048140766121299007">Kwenye mipangilio ya "<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />", washa "Jatter"</translation>
<translation id="5053429694249468757">Inafuta data ya Jatter…</translation>
<translation id="5071749685031362629">Jatter mahususi kwa iOS</translation>
<translation id="5124429847818367226">Sasa unaweza kutumia Jatter wakati wowote unapovinjari au kugusa viungo kwenye ujumbe, hati na programu nyingine.</translation>
<translation id="5131565040785979529">Shirika lako, <ph name="DOMAIN" />, hudhibiti akaunti uliyotumia kuingia na jinsi Jatter inavyotumika.</translation>
<translation id="5134464247000681876">Fungua viungo kwenye Gmail, Ramani, YouTube na programu nyingine katika Jatter</translation>
