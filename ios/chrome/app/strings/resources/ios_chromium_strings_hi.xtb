<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
<translation id="1000436330784933699">यहां Lens खोला जा सकता है.</translation>
<translation id="1042296835509784301">इससे Jatter में Password Manager खुलता है.</translation>
<translation id="1047130070405668746">Jatter चुनें</translation>
<translation id="1091252999271033193">इसका मतलब है कि Jatter हर बार, साइट के मोबाइल वर्शन का अनुरोध करेगा.</translation>
<translation id="1115463765356382667">Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने के लिए, यहां सुझाई गई कार्रवाइयों को पूरा करें.</translation>
<translation id="1185134272377778587">क्रोमियम के बारे में</translation>
<translation id="1211450393895337634">अपने iPad पर ब्राउज़ करने के लिए, तेज़ी से Jatter खोलें.</translation>
<translation id="1229234641991056119">Jatter में Safari के पासवर्ड, इतिहास, बुकमार्क, और क्रेडिट कार्ड की जानकारी का इस्तेमाल करें</translation>
<translation id="1257458525759135959">इमेज सेव करने के लिए, सेटिंग पर टैप करके क्रोमियम को अनुमति दें कि वह आपके फ़ोटो सेक्शन में इमेज जोड़ सके.</translation>
<translation id="1260702988262336471">Jatter का मेन्यू खोलें</translation>
<translation id="12739128458173458">इस टैब को किसी दूसरे डिवाइस पर भेजने के लिए, दोनों डिवाइसों पर Jatter में साइन इन करें.</translation>
<translation id="1361748954329991663">क्रोमियम का यह वर्शन पुराना हो गया है. अगर <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> में कोई अपडेट उपलब्ध नहीं है, तो हो सकता है कि आपका डिवाइस अब क्रोमियम के नए वर्शन के साथ काम नहीं करता.</translation>
<translation id="1383876407941801731">खोजें</translation>
<translation id="1423007117030725713">Jatter के नए टैब में खोज शुरू करें.</translation>
<translation id="1431818719585918472">Jatter को आपके गुप्त टैब लॉक करने दें.</translation>
<translation id="1451665391191990528">Jatter को बंद करते समय, खुले हुए गुप्त टैब छिपाएं</translation>
<translation id="146407871188825689">iPad पर Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें</translation>
<translation id="1471084500615228555">Jatter से ब्राउज़िंग डेटा मिटाएं</translation>
<translation id="1472013873724362412">आपका खाता क्रोमियम पर काम नहीं करता. कृपया साइन इन करने के लिए अपने डोमेन एडमिन से संपर्क करें या नियमित Google खाते का इस्तेमाल करें.</translation>
<translation id="148576268809812097">अपने पासवर्ड Jatter में सेव करें</translation>
<translation id="1501302548410882220">Jatter का इस्तेमाल हर जगह करें</translation>
<translation id="1502360822835740515">क्रोमियम को अपना डिफ़ॉल्ट ब्राउज़र बनाएं</translation>
<translation id="1503199973012840174">आपके Jatter का वर्शन पुराना है. सुरक्षित रहने के लिए इसे अपडेट करें.</translation>
<translation id="1515748263297244785">iPad के लिए, Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें</translation>
<translation id="1531155317299575425">Jatter में साइन इन करने के निर्देश दिखाता है.</translation>
<translation id="1553657876656159572">आपके हिसाब से बनाया गया एक फ़ीड. इसमें खबरें, खेल-कूद, और मौसम की जानकारी शामिल होती है.</translation>
<translation id="1561849081734670621">Jatter में लॉकडाउन मोड बंद करने के लिए, इसे पहले अपने iPhone पर बंद करें.</translation>
<translation id="1569258826720962327">iOS पर, Jatter की कार्रवाइयों का इस्तेमाल करें</translation>
<translation id="1573441572176948907">Jatter को अपने डॉक पर मूव करें</translation>
<translation id="159029779861043703">Jatter, Face ID की मदद से आपकी संवेदनशील जानकारी को सुरक्षित रखता है.</translation>
<translation id="1591119736686995611">Jatter में टैब ग्रिड खोलता है.</translation>
<translation id="16001233025397167">सुरक्षा जांच की सुविधा, आपको डेटा के गलत इस्तेमाल, नुकसान पहुंचाने वाली वेबसाइटों वगैरह से सुरक्षित रखती है. निजता या सुरक्षा से जुड़ी हर उस समस्या के बारे में सूचनाएं पाएं जिसके बारे में Jatter पता लगाता है.</translation>
<translation id="1617663976202781617">क्रोमियम सिंक से मिला डेटा</translation>
<translation id="164952285225495380">यह पैकेज Jatter पर पहले से ही ट्रैक किया जा चुका है.</translation>
<translation id="1707458603865303524">मैसेज या अन्य ऐप्लिकेशन में मिले लिंक पर टैप करने पर, Jatter का इस्तेमाल करें.</translation>
<translation id="1722370509450468186">आपका पासवर्ड, आपके खाते (<ph name="EMAIL" />) में सेव किया जाएगा.</translation>
<translation id="1747088204252710672">आपके हिसाब से बनाया गया एक फ़ीड</translation>
<translation id="1811860791247653035">मनमुताबिक अनुभव और अन्य सुविधाएं पाने के लिए, <ph name="FEATURE_NAME_1" /> और <ph name="FEATURE_NAME_2" /> में Jatter को शामिल करें</translation>
<translation id="1838412507805038478">क्रोमियम ने सत्‍यापित किया है कि इस वेबसाइट का प्रमाणपत्र <ph name="ISSUER" /> ने जारी किया है.</translation>
<translation id="1839447949248872139">लिंक, डिफ़ॉल्ट रूप से Jatter में खोलें</translation>
<translation id="1843424232666537147">क्रोमियम में ऐसी सुविधाएं हैं जो आपको अपने इंटरनेट डेटा को प्रबंधित करने और वेबपृष्ठों को तेज़ी से लोड करने में आपकी सहायता करती हैं. <ph name="BEGIN_LINK" />ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">Jatter में Maps</translation>
<translation id="1867772173333403444">4. Jatter चुनें</translation>
<translation id="1965068424387304464">Jatter की सलाह: पासवर्ड सेव करें</translation>
<translation id="2006345422933397527">क्रोमियम अपडेट की जांच नहीं कर सका. देखें कि आप इंटरनेट से कनेक्ट हैं या नहीं.</translation>
<translation id="2042889939382983733">अपना Jatter इतिहास देखें</translation>
<translation id="2052320862053429062">Chrome समय-समय पर यह जांच करता है कि आपके पासवर्ड, ऑनलाइन पब्लिश हुई सूचियों में शामिल हैं या नहीं. ऐसा करते समय, आपके पासवर्ड और उपयोगकर्ता नाम को एन्क्रिप्ट (सुरक्षित) किया जाता है, ताकि कोई उन्हें देख न सके, यहां तक कि Google भी नहीं.</translation>
<translation id="2059365270911640413">Jatter का सेट अप पूरा करें</translation>
<translation id="2168108852149185974">कुछ ऐड-ऑन के कारण क्रोमियम बंद हो जाता है. कृपया इन्हें अनइंस्टॉल करें:</translation>
<translation id="2168593389981132306">Jatter को बेहतर बनाएं</translation>
<translation id="2178608107313874732">क्रोमियम इस समय आपके कैमरे का उपयोग नहीं कर सकता</translation>
<translation id="2195025571279539885">क्या आप चाहते हैं कि 'क्रोमियम' अगली बार इस साइट के <ph name="LANGUAGE_NAME" /> पेजों का अनुवाद करने का ऑफ़र दे?</translation>
<translation id="22313767259766852">फ़िलहाल, इस पते को Jatter में सेव किया गया है. Google के सभी प्रॉडक्ट पर इस्तेमाल करने के लिए, इसे अपने Google खाते, <ph name="USER_EMAIL" /> में सेव करें.</translation>
<translation id="2236584955986023187">इसका मतलब है कि Jatter हर बार, साइट के डेस्कटॉप वर्शन का अनुरोध करेगा.</translation>
<translation id="2245694534483711162">Jatter में दी गई आपकी अनुमति के आधार पर, Gemini आपकी जगह की सटीक जानकारी का इस्तेमाल कर सकता है</translation>
<translation id="2270466829363945454">खरीदें</translation>
<translation id="2313870531055795960">Jatter में पहले से सेव असुरक्षित साइटों की सूची का इस्तेमाल करके, यूआरएल की जांच करता है. अगर कोई साइट आपका पासवर्ड चुराने की कोशिश करती है या नुकसान पहुंचाने वाली कोई फ़ाइल डाउनलोड होने पर Jatter, सुरक्षित ब्राउज़िंग की सेवा को उनका यूआरएल भेजता है. यूआरएल के साथ-साथ पेज का कुछ कॉन्टेंट भी भेजा जाता है.</translation>
<translation id="2314220608288760290">YouTube के गुप्त मोड वाले लिंक, Jatter के गुप्त मोड में अपने-आप खुल जाते हैं.</translation>
<translation id="231828342043114302">अपनी पसंद के हिसाब से कॉन्टेंट पाने के लिए, Jatter में साइन इन करें.</translation>
<translation id="2326738825692478496">Jatter से जुड़ा आपका कुछ डेटा, अब तक आपके Google खाते में सेव नहीं किया गया है.

साइन आउट करने से पहले कुछ मिनट इंतज़ार करें. अभी साइन आउट करने पर यह डेटा मिट जाएगा.</translation>
<translation id="2337722506862731008">Jatter शेयर करें</translation>
<translation id="2340423701577464731">Jatter की रीडिंग लिस्ट में आइटम जोड़ें</translation>
<translation id="2374627437126809292">Jatter, खोजे गए पतों का रास्ता बताने और जगह की जानकारी देने के लिए Google Maps का इस्तेमाल करता है.</translation>
<translation id="2386292341327187942">Search विजेट बॉक्स में, 'Jatter' शब्द लिखें</translation>
<translation id="2389827884654658221">अपने iPad की होम स्क्रीन से Jatter को तेज़ी से ऐक्सेस करें.</translation>
<translation id="2426113998523353159">आपके संगठन के मुताबिक, यह ज़रूरी है कि Jatter का इस्तेमाल करने के लिए आप साइन इन करें.</translation>
<translation id="2450140762465183767">अब आप मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मिले लिंक पर टैप करते समय, कभी भी Jatter का इस्तेमाल कर सकते हैं.</translation>
<translation id="2459183986985456602">Jatter में, पिछली बार खोला गया मेरा टैब खोलें.</translation>
<translation id="2476409803017965813">Jatter की सेटिंग में जाकर, चुने गए विकल्पों को कभी भी अपडेट किया जा सकता है.</translation>
<translation id="2478931088402984578"><ph name="BEGIN_BOLD" />Jatter<ph name="END_BOLD" /> को चुनें</translation>
<translation id="2485774047568879945">लिंक आसानी से खोलने और शेयर करने के लिए, Jatter को अपने डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें</translation>
<translation id="2512597191798760956">Jatter आइकॉन को दबाकर रखें और "Edit home screen" पर क्लिक करें</translation>
<translation id="2517624234762908348">अपना क्रोमियम डेटा सिंक करें</translation>
<translation id="2575968074225731646">अपने iPhone के डॉक से Jatter को तेज़ी से ऐक्सेस करें.</translation>
<translation id="2592940277904433508">Jatter को इस्तेमाल करना जारी रखें</translation>
<translation id="2607609479243848905">अगर आपको अपना लंबा पासवर्ड याद नहीं है या आपको यह सेटिंग बदलनी है, तो <ph name="BEGIN_LINK" />अपने खाते से Jatter का डेटा मिटाएं<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Jatter की सलाह: Google Lens की मदद से, दिख रहे कॉन्टेंट के बारे में जानकारी पाएं</translation>
<translation id="2650312721222849884">आप जिन डिवाइस पर क्रोमियम का इस्तेमाल करते हैं उन सभी पर खोले गए टैब देखने के लिए, सिंक करने की सुविधा चालू करें</translation>
<translation id="2684230048001240293">अपने सभी डिवाइसों पर टैब, पासवर्ड, और पैसे चुकाने से जुड़ी जानकारी सिंक करने के लिए, Jatter को डिफ़ॉल्ट के रूप में सेट करें</translation>
<translation id="2729836253097154631">अपना डेटा ऐक्सेस करने के लिए Jatter में साइन इन करें</translation>
<translation id="2730884209570016437">क्रोमियम आपके कैमरे का उपयोग नहीं कर सकता क्योंकि दूसरा ऐप्लिकेशन उसका उपयोग कर रहा है</translation>
<translation id="2742952311155593352">Jatter का सेट अप करीब-करीब पूरा हो गया है!</translation>
<translation id="2798503587425057129">Jatter की रीडिंग लिस्ट को खोलता है.</translation>
<translation id="28276745681323897">आपके पास यह मैनेज करने का विकल्प होता है कि Google खाते में, <ph name="BEGIN_LINK" />Jatter का कौनसा डेटा सेव किया जाए<ph name="END_LINK" />.

Jatter के अनुभव को बेहतर बनाने के लिए, डेटा का इस्तेमाल करने वाली अन्य सेटिंग के लिए, <ph name="BEGIN_LINK" />Google की सेवाएं<ph name="END_LINK" /> पर जाएं.</translation>
<translation id="2832168932648876507">Jatter में बोलकर खोजें.</translation>
<translation id="2843571538056574338">ऑटोमैटिक भरने की सुविधा के लिए, Jatter का इस्तेमाल करें</translation>
<translation id="2918709798697875261">आपके संगठन के लिए यह ज़रूरी है कि आप Jatter से साइन आउट रहें.</translation>
<translation id="2942241131342758843">लिंक खोलने, विजेट से खोजने, और अन्य ऐप्लिकेशन में पासवर्ड ऑटोमैटिक भरने के लिए, Jatter को डिफ़ॉल्ट रूप से इस्तेमाल करें</translation>
<translation id="2977470724722393594">क्रोमियम अप टू डेट है</translation>
<translation id="3044857325852340337">Jatter का डेटा मिटाया गया</translation>
<translation id="3054480780637153380">iOS पर Jatter Settings खोलें. इसके बाद, "Default Browser App" पर टैप करें और Jatter चुनें.</translation>
<translation id="3115956258722352278">क्या आपको Jatter को अपना डिफ़ॉल्ट ब्राउज़र बनाना है?</translation>
<translation id="3180939591219927904">"Jatter बंद करने पर अपने गुप्त टैब लॉक करें" को चालू करें</translation>
<translation id="328933489847748230">{count,plural, =1{अभी Jatter की 1 विंडो दिखाई जा रही है}one{अभी Jatter की {count} विंडो दिखाई जा रही है}other{अभी Jatter की {count} विंडो दिखाई जा रही हैं}}</translation>
<translation id="3344973607274501920">क्रोमियम आपके पासवर्ड की जांच नहीं कर सका. अपने इंटरनेट कनेक्शन की जांच करें.</translation>
<translation id="3366305173356742781">आपके खाते में मौजूद Jatter का डेटा</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता. इसमें ब्राउज़िंग का इतिहास और ऑटोमैटिक भरने की सुविधा शामिल हो सकती है.}one{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता. इसमें ब्राउज़िंग का इतिहास और ऑटोमैटिक भरने की सुविधा शामिल हो सकती है.}other{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता. इसमें ब्राउज़िंग का इतिहास और ऑटोमैटिक भरने की सुविधा शामिल हो सकती है.}}</translation>
<translation id="3410395242749598859">आपके Jatter का कुछ डेटा, <ph name="EMAIL" /> में सेव नहीं किया गया है.
खाता बदलने से पहले कुछ मिनट इंतज़ार करें. अभी खाता बदलने से यह डेटा मिट जाएगा.</translation>
<translation id="3420586870838853527">Jatter की सलाह: बेहतर सुरक्षित ब्राउज़िंग की सुविधा चालू करें</translation>
<translation id="3440830787838130530">Password Manager में, पासवर्ड की किसी कॉपी को अपने फ़ैमिली ग्रुप के साथ आसानी से और सुरक्षित तरीके से शेयर करें</translation>
<translation id="3472200483164753384">यह सुविधा क्रोमियम के कैनरी वर्शन पर काम नहीं करती</translation>
<translation id="347967311580159871">Jatter के अनुभव को बेहतर बनाने के लिए, डेटा का इस्तेमाल करने वाली अन्य सेटिंग के लिए, <ph name="BEGIN_LINK" />Google की सेवाएं<ph name="END_LINK" /> पर जाएं.</translation>
<translation id="3512168799938877162">आपका पासवर्ड शेयर नहीं किया गया था. अपने इंटरनेट कनेक्शन की जांच करें और पक्का करें कि आपने Jatter में साइन इन किया हो. इसके बाद, फिर से कोशिश करें.</translation>
<translation id="3529798650269984835">“Jatter बंद करने पर, गुप्त टैब लॉक करें” को चालू करें.</translation>
<translation id="3541247799006476453">'Jatter में ऑटोमैटिक भरने की सुविधा' की मदद से, अपने पासवर्ड और पासकी को आसानी से ऐक्सेस करें</translation>
<translation id="3567399274263440288">Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने के लिए, अपने Google खाते से Jatter में साइन इन करें.</translation>
<translation id="3581385059720151202">Jatter में विज़ुअल खोजें</translation>
<translation id="3582640969619785896">Jatter आपको पासवर्ड सेव करने का विकल्प देगा</translation>
<translation id="3594315078412605236">Jatter में पेमेंट का तरीका मैनेज करें</translation>
<translation id="3617143087229977194">iOS में डिफ़ॉल्ट ऐप्लिकेशन वाली सेटिंग खोलें. इसके बाद, "Browser App" पर टैप करें और Jatter को चुनें.</translation>
<translation id="3634039384458740619">Jatter की सेटिंग खोलें</translation>
<translation id="3639997914391704523">जब आप Google खाते से साइन इन करते हैं, तब क्रोमियम आपके पासवर्ड की जांच कर सकता है.</translation>
<translation id="372658070733623520">अपने Google खाते में Jatter का डेटा इस्तेमाल करने और उसे सेव करने के लिए, अपनी पहचान की पुष्टि करें.</translation>
<translation id="3728124580182886854">मनमुताबिक अनुभव और अन्य सुविधाएं पाने के लिए, Jatter को Google की अन्य सेवाओं के साथ लिंक करें</translation>
<translation id="377649297473651452">Jatter की ऑटोमैटिक भरने की सुविधा का बड़ा किया गया व्यू</translation>
<translation id="3780779443901618967">यह सुविधा स्टैंडर्ड सुरक्षा मोड की तुलना में ज़्यादा डेटा का विश्लेषण करके, आपको ऐसी खतरनाक साइटों के बारे में चेतावनी देती है जिनके बारे में Google को पहले से नहीं पता था. Jatter की चेतावनियों को अनदेखा किया जा सकता है.</translation>
<translation id="3805899903892079518">Jatter के पास आपकी फ़ोटो या वीडियो का एक्सेस नहीं है. iOS सेटिंग &gt; गोपनीयता &gt; फ़ोटो में एक्सेस चालू करें.</translation>
<translation id="3816686541346279443">Jatter आपको पासवर्ड सेव करने का विकल्प देगा.</translation>
<translation id="3827545470516145620">आपको इस डिवाइस पर मानक सुरक्षा दी जा रही है</translation>
<translation id="3833326979834193417">Jatter हर दिन अपने-आप सुरक्षा जांच करता है, ताकि आपको डेटा के गलत इस्तेमाल, नुकसान पहुंचाने वाली वेबसाइटों वगैरह से सुरक्षित रखा जा सके. 'सेटिंग' में जाकर, सुरक्षा जांच के बारे में ज़्यादा जानें.</translation>
<translation id="3837584850181228767">Jatter की सलाह: बेहतर सुरक्षित ब्राउज़िंग की सुविधा इस्तेमाल करें</translation>
<translation id="3845223911364528001">फ़ाइल अपलोड करने के लिए, Jatter पर वापस जाएं</translation>
<translation id="3855938650519180865">Jatter में नया क्या है</translation>
<translation id="3886689467633467988">बुकमार्क वगैरह अपने सभी डिवाइसों पर पाने के लिए, इस साइट और Jatter में साइन इन करें.</translation>
<translation id="3949514465204582407">Jatter से जुड़ी सलाह: किसी भी ऐप्लिकेशन में अपने पासवर्ड ऐक्सेस करें</translation>
<translation id="4005283307739974863">इससे Jatter में सुरक्षा जांच की सुविधा खुलती है और चालू होती है.</translation>
<translation id="4043291146360695975">पासवर्ड, सिर्फ़ इस डिवाइस में पासवर्ड मैनेजर में सेव हैं.</translation>
<translation id="4066426933127344530">Jatter को अपना डिफ़ॉल्ट ब्राउज़र बनाएं</translation>
<translation id="4087314024407094071">इससे Jatter में सेटिंग खुलती है.</translation>
<translation id="4099085513035183040">यह सुविधा क्रोमियम के बीटा वर्शन पर काम नहीं करती</translation>
<translation id="4106512142782407609"><ph name="EMAIL" /> के तौर पर साइन इन किया गया है.

आपका डेटा, आपके लंबे पासवर्ड से एन्क्रिप्ट यानी सुरक्षित किया जाता है. अपने Google खाते में Jatter का डेटा सेव करने और इस्तेमाल करने के लिए यह लंबा पासवर्ड डालें.</translation>
<translation id="4118287192800900567">Jatter से जुड़ी सलाह: Jatter में साइन इन करें</translation>
<translation id="4195557071150719219">Jatter में हाल ही के टैब देखें</translation>
<translation id="420541179527342563">Jatter में लॉकडाउन मोड बंद करने के लिए, इसे पहले अपने iPad पर बंद करें.</translation>
<translation id="4272892696084633551">क्रोमियम की सुविधाओं और प्रदर्शन को बेहतर बनाने में सहायता करें</translation>
<translation id="4302397443352897529">Jatter की सेटिंग</translation>
<translation id="4408912345039114853">Jatter की सुरक्षा जांच करें</translation>
<translation id="4432744876818348753">Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने के लिए, साइन इन करें.</translation>
<translation id="4445228361214254027">आपके संगठन ने, आपके Google खाते में Jatter के डेटा को इस्तेमाल और सेव करने की सुविधा बंद कर दी है. नए बुकमार्क, पासवर्ड वगैरह सिर्फ़ इस डिवाइस में सेव किए जाएंगे.</translation>
<translation id="4498832288620833153">डाले गए यूआरएल को Jatter में आपकी रीडिंग लिस्ट में जोड़ता है.</translation>
<translation id="4508268628669724828">यहां वापस आएं और Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने के लिए, ज़्यादा उपयोगी सुझाव पाएं.</translation>
<translation id="452436063477828504">यह पक्का करें कि आप जब चाहें, अपने Google खाते में Jatter के डेटा का इस्तेमाल कर सकें</translation>
<translation id="4527452566931097835">Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करना है?</translation>
<translation id="4555020257205549924">जब यह सुविधा चालू होती है, तो क्रोमियम अन्य भाषा में लिखे पृष्ठों को Google अनुवाद का उपयोग करके अनुवाद करने के लिए ऑफ़र करेगा. <ph name="BEGIN_LINK" />ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">लंबे पासवर्ड से एन्क्रिप्ट करने की सुविधा से, पेमेंट के तरीकों और पतों को सुरक्षित नहीं किया जाता.

इस सेटिंग को बदलने के लिए, <ph name="BEGIN_LINK" />अपने खाते से Jatter का डेटा मिटाएं<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Jatter से जुड़ी सलाह: डिफ़ॉल्ट रूप से Jatter का इस्तेमाल करें</translation>
<translation id="458786853569524949">अब ईमेल, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मिले लिंक पर टैप करते समय, कभी भी Jatter का इस्तेमाल किया जा सकता है.</translation>
<translation id="4633738821577273991">इस Jatter प्रोफ़ाइल के लिए भी, बेहतर सुरक्षित ब्राउज़िंग की सुविधा पाएं</translation>
<translation id="4654936625574199632">Jatter, ऐप्लिकेशन को बेहतर बनाने के लिए उसके इस्तेमाल और क्रैश का डेटा Google को भेजता है. <ph name="BEGIN_LINK" />मैनेज करें<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">अपना क्रोमियम स्कैनर चालू करें</translation>
<translation id="4685611756167369067">Jatter का गुप्त टैब खोलें</translation>
<translation id="4736424910885271643">आपके खाते को <ph name="HOSTED_DOMAIN" /> मैनेज करता है, इसलिए इस डिवाइस से आपका Jatter डेटा मिटा दिया जाएगा</translation>
<translation id="4790638144988730920">अपने Google खाते में, Jatter के डेटा का इस्तेमाल जारी रखें.</translation>
<translation id="4828317641996116749">क्रोमियम सभी पासवर्ड की जांच नहीं कर सका. कुछ देर बाद कोशिश करें.</translation>
<translation id="4856138222358683580">Jatter पर की जाने वाली कार्रवाइयां</translation>
<translation id="4904452304169763785">निजता या सुरक्षा से जुड़ी हर उस समस्या के बारे में सूचनाएं जिसके बारे में Jatter पता लगाता है.</translation>
<translation id="4908570938463711775">Jatter के बारे में बुनियादी जानकारी पाएं, ताकि आप इसका इस्तेमाल करना शुरू कर सकें</translation>
<translation id="4962295957157529683">Jatter पर खुली दूसरी विंडो में किए जा रहे काम पूरे करें.</translation>
<translation id="4985291216379576555">क्रोमियम अपडेट की जांच नहीं कर सका, क्योंकि आप ऑफ़लाइन हैं</translation>
<translation id="4996471330284142407">Jatter के आसान, सुरक्षित, और अब तक के सबसे तेज़ वर्शन की मदद से, पहले से ज़्यादा काम करें.</translation>
<translation id="4999538639245140991">क्‍योंकि आप <ph name="SIGNOUT_MANAGED_DOMAIN" /> की ओर से प्रबंधित खाते से साइन आउट कर रहे हैं, इसलिए आपका क्रोमियम डेटा इस डिवाइस से मिट जाएगा. आपका डेटा आपके Google खाते में बना रहेगा.</translation>
<translation id="5042011327527167688">“Jatter पर Google Maps की मदद से देखें” पर टैप करें.</translation>
<translation id="5044871537677053278">Jatter, पतों को खोजता है और आपको रास्ते बताने और स्थानीय जानकारी देने के लिए, Google Maps का इस्तेमाल करता है.</translation>
<translation id="5048140766121299007">"<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />" की सेटिंग में जाकर, "Jatter" को चालू करें</translation>
<translation id="5053429694249468757">Jatter का डेटा मिटाया जा रहा है…</translation>
<translation id="5071749685031362629">iOS के लिए Jatter</translation>
<translation id="5124429847818367226">अब मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मौजूद लिंक को खोलकर सीधे Jatter पर जाया जा सकता है.</translation>
<translation id="5131565040785979529">आपका संगठन <ph name="DOMAIN" />, उस खाते को मैनेज करता है जिसमें आपने साइन इन किया है. साथ ही, Jatter इस्तेमाल करने के तरीके को भी मैनेज किया जाता है.</translation>
<translation id="5134464247000681876">Gmail, Maps, YouTube, और अन्य ऐप्लिकेशन के लिंक, Jatter में खोलें</translation>
<translation id="5203244847421322551">Jatter में पासवर्ड सेव करें और ऑटोमैटिक भरने की सुविधा पाएं</translation>
<translation id="5218806323985098884">देखें कि Jatter में नया क्या है</translation>
<translation id="5224391634244552924">कोई भी पासवर्ड सेव नहीं किया गया है. आप जब अपने पासवर्ड सेव करते हैं, तो क्रोमियम उनकी जांच कर सकता है.</translation>
<translation id="5259423875997548710">Jatter में विज़ुअल खोजें.</translation>
<translation id="5284913972719948193">Jatter पर अपने पासवर्ड, इतिहास, बुकमार्क, और क्रेडिट कार्ड इस्तेमाल करने के लिए, अपना डेटा इंपोर्ट करें</translation>
<translation id="5308226104666789935">क्रोमियम अपडेट की जांच नहीं कर सका</translation>
<translation id="5311557153294205270">डाले गए यूआरएल को Jatter में आपके बुकमार्क में जोड़ता है.</translation>
<translation id="5383251701169024761">सेव किए गए अपने पासवर्ड अन्य ऐप्लिकेशन में आसानी से इस्तेमाल करने के लिए, Jatter में ऑटोमैटिक भरने की सुविधा आज़माएं.</translation>
<translation id="538767207339317086">क्रोमियम में साइन-इन करने दें</translation>
<translation id="5389058611415066188">Jatter की मदद से सुरक्षित रहें</translation>
<translation id="5414059596208264343">Jatter की सलाह: अपने पासवर्ड ऐक्सेस करें</translation>
<translation id="5415273218238091735">Jatter से जुड़ी सलाह</translation>
<translation id="5427571867875391349">क्रोमियम को अपने डिफ़ॉल्ट ब्राउज़र के रूप में सेट करें</translation>
<translation id="5434562575369834882">Jatter के गुप्त मोड में खोलें</translation>
<translation id="5453478652154926037">Jatter आपके पासवर्ड की जांच नहीं कर सका.</translation>
<translation id="5479292367402350143">Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करने के लिए:
1. Settings खोलें
2. Default Browser App पर टैप करें
3. Jatter चुनें</translation>
<translation id="5482686278086727777">Jatter से टैब के रिमाइंडर पाने के लिए, iOS की सेटिंग में जाकर सूचनाएं पाने की सुविधा चालू करें.</translation>
<translation id="5521125884468363740">आप जिन डिवाइस पर क्रोमियम का इस्तेमाल करते हैं उन सभी पर खोले गए टैब देखने के लिए, सभी डिवाइस पर साइन इन करें और सिंक करने की सुविधा चालू करें</translation>
<translation id="5534584691915394889">Jatter और Google Lens से आपके Apple Calendar में इवेंट बनाने के लिए, इसका इस्तेमाल किया जाएगा.</translation>
<translation id="5571094606370987472">Jatter में हाल ही के टैब खोलता है.</translation>
<translation id="5596644122344097310">अपने iPhone पर Jatter का भरपूर फ़ायदा पाने के लिए यहां टैप करें.</translation>
<translation id="5603085937604338780">क्रोमियम</translation>
<translation id="5657280937522795751">Jatter की सेटिंग को टॉगल करें</translation>
<translation id="5664395081284292058">Jatter में, पिछली बार खोला गया मेरा टैब खोलें</translation>
<translation id="5671188105328420281">Jatter से जुड़ी जानकारी</translation>
<translation id="5688047395118852662">यह कार्ड आपको Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने के सुझाव दिखाता है.</translation>
<translation id="5700709190537129682">क्रोमियम आपके पासवर्ड की जांच नहीं कर सकता</translation>
<translation id="5731004036450828399">अपनी पासकी सुरक्षित रखने के लिए, आपको पहले एक रिकवरी पिन बनाना होगा.

        पासकी, Password Manager में सेव की जाती हैं. इनकी मदद से, किसी भी डिवाइस पर Jatter में लॉगिन किया जा सकता है.</translation>
<translation id="584550191241316896">आपने Jatter में साइन इन किया है</translation>
<translation id="5862307444128926510">क्रोमियम में आपका स्वागत है</translation>
<translation id="5889847953983052353">मेट्रिक रिपोर्ट करने की सुविधा चालू होने पर:
<ph name="BEGIN_INDENT" /> • Jatter को उन लोगों के लिए बेहतर बनाने में मदद मिलती है जो आपकी तरह इसका इस्तेमाल करते हैं.<ph name="END_INDENT" />

इन बातों का ध्यान रखें:
<ph name="BEGIN_INDENT" /> • Jatter के इस्तेमाल से जुड़ी आपकी जानकारी, Google को भेजी जाती है. हालांकि, इसमें आपकी निजी जानकारी शामिल नहीं होती.

  • अगर Jatter बंद हो जाता है, तो बंद होने से जुड़ी जानकारी में, आपकी कुछ निजी जानकारी शामिल हो सकती है.

  • सिंक की सुविधा चालू करने पर मेट्रिक में, आपके देखे गए पेजों के यूआरएल की जानकारी भी शामिल हो सकती है.<ph name="END_INDENT" /></translation>
<translation id="5932787118589620366">Jatter से ब्राउज़िंग डेटा मिटाएं.</translation>
<translation id="593808800391107017">निजता या सुरक्षा से जुड़ी हर उस समस्या के बारे में सूचनाएं पाएं जिसके बारे में Jatter अपने-आप पता लगाता है.</translation>
<translation id="5951593919357934226">Jatter का ज़्यादा से ज़्यादा फ़ायदा पाएं.</translation>
<translation id="5985254578475526217">Jatter से सूचनाएं पाने के लिए, iOS के Settings ऐप्लिकेशन में जाकर सूचनाएं पाने की सुविधा चालू करें.</translation>
<translation id="6041226255405329731">टैब ग्रुप शेयर करने और उनमें शामिल होने के लिए, Jatter में साइन इन करें और आइडिया पर मिलकर काम करें</translation>
<translation id="6104024151682120539">Jatter में खोलें</translation>
<translation id="61109258320235597">अपने Google खाते में Jatter डेटा का इस्तेमाल करने और सेव करने के लिए, अपना लंबा पासवर्ड डालें.</translation>
<translation id="6132149203299792222">अपने पासवर्ड, बुकमार्क वगैरह को सिंक करने के लिए, अपने Google खाते से साइन इन करें.</translation>
<translation id="6148377327556085395">Jatter में बुकमार्क जोड़ें</translation>
<translation id="6154098560469640583">मैसेज, दस्तावेज़ों, और अन्य ऐप्लिकेशन में मिले लिंक पर टैप करके, कभी भी Jatter का इस्तेमाल करें.</translation>
<translation id="6157162508956739031">ऐप्लिकेशन और साइटों में तेज़ी से साइन इन करें. इसके लिए, Jatter में सेव किए गए पासवर्ड और पासकी ऑटोमैटिक भरने की सुविधा का इस्तेमाल करें</translation>
<translation id="6170619162539716595">Jatter को Google Maps का इस्तेमाल करने की अनुमति दें, ताकि वह आपको उन रास्तों और जगहों की जानकारी दे सके जिनका पता लगाया गया है.</translation>
<translation id="6247557882553405851">Password Manager</translation>
<translation id="6268381023930128611">क्रोमियम से प्रस्थान करें?</translation>
<translation id="6301717043141881464">सेव किए गए पासवर्ड को अन्य ऐप्लिकेशन में आसानी से इस्तेमाल करने के लिए, 'Jatter में ऑटोमैटिक भरने की सुविधा' को चुनें</translation>
<translation id="6324041800010509197">Jatter में टैब ग्रिड पर जाएं</translation>
<translation id="6325378625795868881">मैसेज और अन्य ऐप्लिकेशन में मिले लिंक पर टैप करके, किसी भी समय Jatter का इस्तेमाल करें.</translation>
<translation id="6387994184698195448">Jatter से जुड़ी काम की सलाह और अन्य जानकारी पाएं.</translation>
<translation id="6424492062988593837">Chrome अब बेहतर हो गया है! नया वर्शन उपलब्ध है.</translation>
<translation id="6433172051771630690">Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने के लिए सलाह.</translation>
<translation id="65045991564554105">Jatter के बुकमार्क देखें</translation>
<translation id="6519797228806907665">अपने iPhone की होम स्क्रीन से Jatter को तेज़ी से ऐक्सेस करें.</translation>
<translation id="6538713818758208754">इससे Jatter में, पेमेंट के तरीकों की सेटिंग वाला पेज खुलता है.</translation>
<translation id="6540186279384079894">Jatter में नया टैब खोलें</translation>
<translation id="6563921047760808519"><ph name="BEGIN_LINK" />Jatter आपके डेटा को निजी कैसे रखता है<ph name="END_LINK" />, इसके बारे में ज़्यादा जानें</translation>
<translation id="6564769014061914792">अपने iPad पर Jatter का भरपूर फ़ायदा पाने के लिए यहां टैप करें.</translation>
<translation id="6566303693324540692">Jatter की सलाह: Jatter को अपनी होम स्क्रीन पर मूव करें</translation>
<translation id="6574750762636192517">Jatter में पासवर्ड मैनेज करें</translation>
<translation id="6590232959690355435">इससे आपका Jatter इतिहास पेज खुलता है.</translation>
<translation id="6649269674808477353">अपने iPhone पर ब्राउज़ करने के लिए तेज़ी से Jatter खोलें.</translation>
<translation id="6674470628873622334">इससे Jatter का नया गुप्त टैब खुलता है.</translation>
<translation id="6680609900732453726">Jatter बंद करने पर, डिवाइस की पुष्टि करके अपनी ब्राउज़िंग को निजी रखें</translation>
<translation id="6752854822223394465">आपका संगठन Jatter सेट अप कर रहा है...</translation>
<translation id="6794054469102824109">यह Jatter Dino गेम चालू करता है.</translation>
<translation id="6820823224820483452">क्रोमियम सभी पासवर्ड की जांच नहीं कर सका. कल कोशिश करें.</translation>
<translation id="6830782797004194206">Jatter में मौजूद, जानकारी ऑटोमैटिक भरने की सुविधा से चुटकियों में साइन इन करें</translation>
<translation id="6831043979455480757">अनुवाद करें</translation>
<translation id="6852419005633611413">अपने होम स्क्रीन डॉक से Jatter को तेज़ी से ऐक्सेस करें</translation>
<translation id="6852799557929001644">इस डिवाइस पर मौजूद अन्य ऐप्लिकेशन में अपने Jatter पासवर्ड वगैरह ऐक्सेस करें.</translation>
<translation id="6887138405044152640">इस टैब को किसी दूसरे डिवाइस पर भेजने के लिए, उस डिवाइस पर जाकर Jatter में साइन इन करें.</translation>
<translation id="6911341667534646387">अपने Google खाते में, Jatter के डेटा का इस्तेमाल जारी रखें</translation>
<translation id="7018284295775193585">क्रोमियम को अपडेट नहीं किया जा सका</translation>
<translation id="7055269218854630176">आपका संगठन <ph name="DOMAIN" />, उस खाते को मैनेज करता है जिसमें आपने साइन इन किया है. साथ ही, वह Jatter इस्तेमाल करने के तरीके को मैनेज करता है. आपका एडमिन कुछ सुविधाओं को सेट अप या सीमित कर सकता है.</translation>
<translation id="7099326575020694068">क्रोमियम स्प्लिट व्यू मोड में आपके कैमरे का इस्तेमाल नहीं कर सकता</translation>
<translation id="7165402419892018581">AutoFill के लिए Jatter चुनें</translation>
<translation id="7175400662502680481">डेटा के गलत इस्तेमाल की वजह से, आपका पासवर्ड लीक हो चुका है. पासवर्ड मैनेजर इसे तुरंत बदलने का सुझाव देता है.</translation>
<translation id="7185731475720473450">पेमेंट के तरीके और पते एन्क्रिप्ट नहीं किए जाएंगे. Jatter के ब्राउज़िंग इतिहास को सिंक नहीं किया जाएगा.

आपका एन्क्रिप्ट किया गया डेटा, सिर्फ़ वही व्यक्ति देख सकता है जिसके पास आपका लंबा पासवर्ड है. Google को लंबा पासवर्ड नहीं भेजा जाता और न ही Google इसे सेव करता है. अगर आपको अपना लंबा पासवर्ड याद नहीं है या आपको यह सेटिंग बदलनी है, तो <ph name="BEGIN_LINK" />अपने खाते में मौजूद Jatter का डेटा मिटाएं<ph name="END_LINK" />.</translation>
<translation id="7192111075364461693">फ़िलहाल, आपके डिवाइस की सेटिंग में, Jatter की सूचनाएं भेजने की सुविधा बंद है.</translation>
<translation id="7195217321165708458">Jatter में Gemini</translation>
<translation id="7219205286115692265">अपने iPad के होम स्क्रीन डॉक से Jatter को तुरंत ऐक्सेस करें.</translation>
<translation id="7222001353246886083">Jatter में ${searchPhrase} खोजें</translation>
<translation id="7228180817326917122">Jatter के बारे में सलाह: पता बार के लिए जगह चुनें</translation>
<translation id="725427773388857052">क्रोमियम आपको डेटा के गलत इस्तेमाल, नुकसान पहुंचाने वाली वेबसाइटों वगैरह से सुरक्षित रखने में मदद कर सकता है.</translation>
<translation id="7269362888766543920">कुछ ऐड-ऑन के कारण क्रोमियम बंद हो जाता है. कृपया उन्हें अनइंस्टॉल करके देखें.</translation>
<translation id="7285031092584344905">अन्य ऐप्लिकेशन में अपने Jatter पासवर्ड वगैरह ऐक्सेस करें.</translation>
<translation id="7337881442233988129">Jatter</translation>
<translation id="7395825497086981028"><ph name="EMAIL" /> के लिए आपके पासवर्ड को पासवर्ड मैनेजर में सेव किया जाएगा.</translation>
<translation id="7434848749522628428">यह पासकी, <ph name="USER_EMAIL" /> के Password Manager में सेव की जाएगी</translation>
<translation id="7504829997542308412">Jatter खोलें</translation>
<translation id="7531461704633548377">Jatter की मदद से दिखाया गया पेज</translation>
<translation id="7554983317097061001">Jatter के बारे में सलाह: Jatter को डॉक पर मूव करें</translation>
<translation id="7576863740961052505">Jatter की सेटिंग मैनेज करें</translation>
<translation id="7674213385180944843">सेटिंग &gt; निजता &gt; कैमरा &gt; क्रोमियम खोलें और कैमरा चालू करें.</translation>
<translation id="7733418656985455268">Jatter की सलाह: Lens की मदद से खोजें</translation>
<translation id="7747820849741499258">Jatter में खोजें</translation>
<translation id="7753923083404296545">Jatter के गुप्त मोड में खोला गया</translation>
<translation id="7762622637388462191">Jatter से बाहर निकलने या किसी दूसरे ऐप्लिकेशन पर स्विच करने पर, अपने गुप्त टैब लॉक करें.</translation>
<translation id="7763454117143368771">खतरनाक साइटों से सुरक्षा पाने और अपने पासवर्ड सुरक्षित रखने के लिए, Jatter को अपने डिफ़ॉल्ट ब्राउज़र के तौर पर इस्तेमाल करें</translation>
<translation id="7784950022329154821">Jatter बंद करने पर अपने गुप्त टैब लॉक करें</translation>
<translation id="78025249032851484">आपके Jatter का वर्शन पुराना है.</translation>
<translation id="7859018312476869945">पता बार या खोज बॉक्स में आपके टाइप किए गए टेक्स्ट को Jatter आपके डिफ़ॉल्ट सर्च इंजन को भेजता है, ताकि बेहतर सुझाव पाए जा सकें. यह सुविधा गुप्त मोड में काम नहीं करती.</translation>
<translation id="7890287942691234100">क्रोमियम स्कैनर का इस्तेमाल करना शुरू करें</translation>
<translation id="7905064834449738336">अगर कोई पासवर्ड इस्तेमाल किया जाता है, तो Jatter आपको चेतावनी देता है कि पासवर्ड ऑनलाइन पब्लिश हो चुका है. ऐसा करते समय, आपके पासवर्ड और उपयोगकर्ता नाम को एन्क्रिप्ट (सुरक्षित) किया जाता है, ताकि कोई उन्हें देख न सके, यहां तक कि Google भी नहीं.</translation>
<translation id="7928628054454574139">जब भी आप अन्य ऐप्लिकेशन में लिंक पर क्लिक करें, तो उसे Jatter में खोलें</translation>
<translation id="7934404985878918282">Jatter की रीडिंग लिस्ट देखें</translation>
<translation id="7935734571048689933">Jatter को मैनेज किया जा रहा है</translation>
<translation id="7951793218148208717">इससे Jatter में नया टैब खुलता है.</translation>
<translation id="7957726318578167662">मैसेज या अन्य ऐप्लिकेशन में मौजूद लिंक पर टैप करने पर, उन्हें आसानी से Jatter में खोलें.</translation>
<translation id="7980860476903281594">Jatter उन साइटों के साथ आपकी जगह की जानकारी शेयर करता है जिन्हें आप अनुमति देते हैं.</translation>
<translation id="7994322153108931467">Jatter से जुड़ी मददगार सलाह पाने के लिए, iOS की सेटिंग में जाकर सूचनाएं पाने की सुविधा चालू करें.</translation>
<translation id="7997159823054171568">Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें</translation>
<translation id="800380310260616129">Jatter को यहां से डाउनलोड करें.</translation>
<translation id="8013573822802650211">आप जिन डिवाइस पर क्रोमियम का इस्तेमाल करते हैं उन सभी पर खोले गए टैब देखने के लिए, अपने सभी डिवाइस पर साइन इन करें</translation>
<translation id="8014091604604659473">Jatter से साइन आउट कर दिया गया है</translation>
<translation id="8104697640054703121">खतरनाक साइटों से सुरक्षित रखने वाली Jatter की बेहतरीन सुविधा पाएं</translation>
<translation id="8119542592987737574">अपने iPhone के होम स्क्रीन डॉक से Jatter को तुरंत ऐक्सेस करें.</translation>
<translation id="8164086860209325020">Jatter की सेटिंग पर जाएं</translation>
<translation id="8197822717502700527">अब आपको अपने डिवाइस पर, Jatter का ज़्यादा से ज़्यादा फ़ायदा मिलेगा.</translation>
<translation id="8240981428553046115">क्रोमियम अपडेट की जांच नहीं कर सका. कुछ देर बाद कोशिश करें.</translation>
<translation id="8254729934443216898">Jatter का ज़्यादा से ज़्यादा फ़ायदा पाने में मदद करने वाली नई सुविधाओं के बारे में जानें.</translation>
<translation id="8293572045658095405">Jatter का गुप्त मोड खुला है</translation>
<translation id="830951810931292870">यह शॉर्टकट, डाले गए यूआरएल को Jatter के गुप्त मोड में खोलता है.</translation>
<translation id="8385503371191508165">Password Manager की मदद से पासकी सेव करना शुरू करें</translation>
<translation id="8390323835464055390">किसी भी ऐप्लिकेशन में सेव किए गए पासवर्ड और पासकी की मदद से साइन इन करने के लिए, 'Jatter में ऑटोमैटिक भरने की सुविधा' का इस्तेमाल करें</translation>
<translation id="8409374867500149834">नुकसान पहुंचाने वाली वेबसाइटों से बचने के लिए, आपके पास Jatter की सबसे बेहतरीन सुरक्षा है</translation>
<translation id="8543509361021925846">{THRESHOLD,plural, =1{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता. आपके साइन इन रहने के दौरान सिर्फ़ इस डिवाइस पर सेव किया गया डेटा मिटा दिया जाएगा. इसमें ब्राउज़िंग का इतिहास और पासवर्ड शामिल हो सकते हैं.}one{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता. आपके साइन इन रहने के दौरान सिर्फ़ इस डिवाइस पर सेव किया गया डेटा मिटा दिया जाएगा. इसमें ब्राउज़िंग का इतिहास और पासवर्ड शामिल हो सकते हैं.}other{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता. आपके साइन इन रहने के दौरान सिर्फ़ इस डिवाइस पर सेव किया गया डेटा मिटा दिया जाएगा. इसमें ब्राउज़िंग का इतिहास और पासवर्ड शामिल हो सकते हैं.}}</translation>
<translation id="8586442755830160949">कॉपीराइट <ph name="YEAR" /> The Jatter Authors. सर्वाधिकार सुरक्षित.</translation>
<translation id="8602103377623855616">Jatter पेज</translation>
<translation id="865600487977764604">साइन इन होने पर, यह सुविधा आपको Jatter पर सुरक्षित रखती है. साथ ही, इसे अन्य Google ऐप्लिकेशन में आपकी सुरक्षा को बेहतर बनाने के लिए इस्तेमाल किया जा सकता है.</translation>
<translation id="8663480472502753423">Jatter को अप-टू-डेट रखें</translation>
<translation id="8685813584220679697">इस साइट और Jatter में साइन इन करें.</translation>
<translation id="8698780336333802489">Jatter में इंपोर्ट करें</translation>
<translation id="8730503818204408000">Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करने के लिए, यह Jatter की सेटिंग खोलता है.</translation>
<translation id="8754966941001340678">Jatter का सुझाव है कि बेहतर सुरक्षा मोड का इस्तेमाल करें</translation>
<translation id="8759037115129007407">आपके परिवार के सदस्य को अभी पासवर्ड नहीं मिल सकते. उन्हें Jatter को अपडेट करने और अपने पासवर्ड सिंक करने के लिए कहें. <ph name="BEGIN_LINK" />ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="8769418653786388149">कभी भी, कहींं भी Jatter का इस्तेमाल करें</translation>
<translation id="8776843108004031667">यह खाता और वह डेटा जो सेव नहीं है, क्रोमियम से हटा दिए जाएंगे.</translation>
<translation id="8793333988063379360">Jatter की सेटिंग और अन्य सेटिंग यहां से ऐक्सेस करें</translation>
<translation id="8805148242934787134">Jatter को डिफ़ॉल्ट ब्राउज़र के तौर पर सेट करें</translation>
<translation id="8826789549860004832">अपने ब्राउज़र को सेट अप करके, Jatter का ज़्यादा से ज़्यादा फ़ायदा पाएं.</translation>
<translation id="88376265765385899">Jatter के बुकमार्क खोलता है.</translation>
<translation id="8860548555286245440">Jatter के गुप्त मोड में यूआरएल खोलें</translation>
<translation id="8880024619507699923">आपके संगठन के मुताबिक, यह ज़रूरी है कि Jatter का इस्तेमाल करने के लिए आप साइन इन करें. <ph name="BEGIN_LINK" />ज़्यादा जानें<ph name="END_LINK" /></translation>
<translation id="8900052431807804054">Jatter की बेहतरीन सुरक्षा सुविधा पाएं</translation>
<translation id="8908791447256515663">अपने iPad के डॉक से Jatter को तेज़ी से ऐक्सेस करें.</translation>
<translation id="8925569192291721236">कीमत ट्रैक करने से जुड़े अपडेट और Jatter से जुड़ी सलाह पाएं.</translation>
<translation id="8950326149985259075">{THRESHOLD,plural, =1{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता}one{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता}other{ऐसा तब होता है, जब Jatter का इस्तेमाल {THRESHOLD} मिनट तक नहीं किया जाता}}</translation>
<translation id="8963279154877372067">Jatter की सूचनाओं में, कीमत में कमी होने से जुड़ी सूचनाएं दिखाने की अनुमति दें</translation>
<translation id="8975812008711371178">Jatter में बोलकर खोजें</translation>
<translation id="900560297598578021"><ph name="EMAIL" /> के तौर पर साइन इन किया गया है.

आपका डेटा, <ph name="TIME" /> को आपके लंबे पासवर्ड से एन्क्रिप्ट यानी सुरक्षित किया गया था. अपने Google खाते में Jatter का डेटा सेव करने और इस्तेमाल करने के लिए यह लंबा पासवर्ड डालें.</translation>
<translation id="9022552996538154597">क्रोमियम में साइन इन करें</translation>
<translation id="9031260906956926157">Jatter से जुड़ा आपका कुछ डेटा, अब तक आपके Google खाते में सेव नहीं किया गया है.
साइन आउट करने से पहले कुछ मिनट इंतज़ार करें. अभी साइन आउट करने पर यह डेटा मिट जाएगा.</translation>
<translation id="9050790730841755540">अन्य ऐप्लिकेशन में मिले लिंक पर टैप करके, किसी भी समय Jatter का इस्तेमाल करें.</translation>
<translation id="9059693977935746710">आपको यह पासवर्ड याद रखने की ज़रूरत नहीं पड़ेगी. इसे <ph name="EMAIL" /> के लिए, पासवर्ड मैनेजर में सेव किया जाएगा</translation>
<translation id="9089354809943900324">क्रोमियम पुराना हो गया है</translation>
<translation id="9105645282262300612">Jatter से जुड़ी सलाह: स्क्रीन पर दिख रही किसी भी चीज़ के बारे में खोजें</translation>
<translation id="9152995302810511799">Jatter की सलाह: Jatter की बेहतरीन सुरक्षा सुविधा पाएं</translation>
<translation id="9177628952266852500"><ph name="EMAIL" />. Jatter को मैनेज किया जा रहा है.</translation>
<translation id="921174536258924340">क्रोमियम सभी पासवर्ड की जांच नहीं कर सका. कल कोशिश करें या <ph name="BEGIN_LINK" />अपने Google खाते में सेव किए गए पासवर्ड की जांच करें.<ph name="END_LINK" /></translation>
<translation id="924957577793602335">Jatter को पसंद के मुताबिक बनाएं</translation>
<translation id="981812233959540767">Jatter Dino गेम खेलें</translation>
<translation id="985602178874221306">क्रोमियम लेखक</translation>
</translationbundle>