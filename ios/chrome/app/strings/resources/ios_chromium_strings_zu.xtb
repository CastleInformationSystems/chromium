<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1000436330784933699">Ungavula iLens lapha.</translation>
<translation id="1042296835509784301">Ivula Isiphathi Sephasiwedi kuJatter.</translation>
<translation id="1047130070405668746">Khetha i-Jatter</translation>
<translation id="1091252999271033193">Lokhu kusho ukuthi i-Jatter izocela isayithi yeselula ngaso sonke isikhathi.</translation>
<translation id="1115463765356382667">Qedela lezi zenzo eziphakanyisiwe ngezansi ukuze uthole okuningi ku-Jatter.</translation>
<translation id="1185134272377778587">Mayelana ne-Jatter</translation>
<translation id="1211450393895337634">Vula iJatter ngokushesha uma usulungele ukubhrawuza ku-iPad yakho.</translation>
<translation id="1229234641991056119">Sebenzisa amaphasiwedi, umlando, amabhukhimakhi, namakhadi akho esikweletu kuJatter</translation>
<translation id="1257458525759135959">Ukuze ulondoloze izithombe, thepha Amasethingi ukuze uvumele i-Jatter ingeze ezithombeni zakho</translation>
<translation id="1260702988262336471">Vula imenyu yeJatter</translation>
<translation id="12739128458173458">Ukuze uthumele le thebhu kwenye idivayisi, ngena ngemvume ku-Jatter kuwo womabili amadivayisi.</translation>
<translation id="1361748954329991663">I-Jatter iphelelwe isikhathi. Uma kungekho sibuyekezo esitholakalayo <ph name="BEGIN_LINK" />ku-App Store<ph name="END_LINK" />, kungenzeka ukuthi idivayisi yakho ayisazisekeli izinguqulo ezintsha ze-Jatter.</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="1423007117030725713">Qala ukusesha kuthebhu entsha ye-Jatter.</translation>
<translation id="1431818719585918472">Vumela i-Jatter ikhiye amathebhu wakho we-Incognito.</translation>
<translation id="1451665391191990528">Fihla amathebhu e-Incognito avuliwe uma ushiya iJatter</translation>
<translation id="146407871188825689">Sebenzisa iJatter ku-iPad Ngokuzenzakalelayo</translation>
<translation id="1471084500615228555">Sula idatha yokubhrawuza kuJatter</translation>
<translation id="1472013873724362412">I-akhawunti yakho ayisebenzi ku-Jatter. Sicela uxhumane nomqondisi wesizinda noma usebenzise i-akhawunti ejwayelekile ye-Google ukuze ungene ngemvume.</translation>
<translation id="148576268809812097">Londoloza Amaphasiwedi Akho kuJatter</translation>
<translation id="1501302548410882220">Sebenzisa iJatter yonke indawo</translation>
<translation id="1502360822835740515">Yenza i-Jatter isiphequluli sakho esizenzakalelayo</translation>
<translation id="1503199973012840174">I-Jatter yakho isiphelelwe yisikhathi. Ibuyekeze ukuze uhlale uphephile.</translation>
<translation id="1515748263297244785">Sebenzisa iJatter ye-iPad ngokuzenzakalela</translation>
<translation id="1531155317299575425">Ibonisa isiqondiso sokungena ngemvume ku-Jatter.</translation>
<translation id="1553657876656159572">Okuphakelayo okungokwezifiso okwenzelwe wena. Kubandakanya izindaba, ezemidlalo kanye nesimo sezulu.</translation>
<translation id="1561849081734670621">Ukuze uvale Imodi Yokukhiya ku-Jatter yivale ku-iPhone yakho.</translation>
<translation id="1569258826720962327">Sebenzisa izenzo zeJatter ku-iOS</translation>
<translation id="1573441572176948907">Hambisa iJatter kudokhi yakho</translation>
<translation id="159029779861043703">I-Jatter igcina idatha yakho enozwelo ivikelekile nge-Face ID.</translation>
<translation id="1591119736686995611">Vula Ithebhu Ye-Grid Ye-Jatter.</translation>
<translation id="16001233025397167">Ukuhlolwa Kokuphepha kukugcina uvikelekile ekuphulweni kwesivumelwano sedatha, kumasayithi angaphephile nakokunye. Thola izexwayiso mayelana nanoma iziphi izinkinga ezithinta ubumfihlo nokuvikeleka iJatter ekutholela zona.</translation>
<translation id="1617663976202781617">Idatha kusukela ekuvunyelanisweni kwe-Jatter</translation>
<translation id="164952285225495380">Le phakheji isivele ilandelelwe ku-Jatter.</translation>
<translation id="1707458603865303524">Sebenzisa i-Jatter noma nini uma uthepha amalinki kumilayezo noma kwamanye ama-app.</translation>
<translation id="1722370509450468186">Iphasiwedi yakho izolondolozwa ku-Account yakho (<ph name="EMAIL" />).</translation>
<translation id="1747088204252710672">Okuphakelayo okumuntu ngamunye okwenzelwe wena</translation>
<translation id="1811860791247653035">Ukuze uthole ukwenza ngokomuntu ngamunye nezinye izakhi, okufaka i-Jatter ku-<ph name="FEATURE_NAME_1" /> naku-<ph name="FEATURE_NAME_2" /></translation>
<translation id="1838412507805038478">I-Jatter iqinisekise ukuthi i-<ph name="ISSUER" /> ikhiphe isitifiketi sale webhusayithi.</translation>
<translation id="1839447949248872139">Vula amalinki kuJatter Ngokuzenzakalelayo</translation>
<translation id="1843424232666537147">I-Jatter inezici ezikusiza ukuthi uphathe idatha yakho ye-inthanethi nokuthi ulayisha kanjani ngokushesha amakhasi ewebhu.
<ph name="BEGIN_LINK" />Funda kabanzi<ph name="END_LINK" /></translation>
<translation id="1847960401032164406">I-Maps ku-Jatter</translation>
<translation id="1867772173333403444">4. Khetha i-Jatter</translation>
<translation id="1965068424387304464">Ithiphu yeJatter: Londoloza Amaphasiwedi</translation>
<translation id="2006345422933397527">I-Jatter ayikwazanga ukuhlola izibuyekezo. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="2042889939382983733">Buka umlando wakho we-Jatter</translation>
<translation id="2052320862053429062">I-Jatter ngezikhathi ezithile ihlola amaphasiwedi akho ngokumelene nohlu olushicilelwe ku-inthanethi. Uma yenza lokhu, amaphasiwedi akho namagama abasebenzisi ayabethelwa, ukuze angakwazi ukufundwa yinoma ubani, kubandakanya ne-Google.</translation>
<translation id="2059365270911640413">Qedela ukusetha iJatter</translation>
<translation id="2168108852149185974">Ezinye izengezo zibangela i-Jatter ukuthi iphahlazeke. Sicela uzikhiphe:</translation>
<translation id="2168593389981132306">Yenza iJatter ibe ngcono</translation>
<translation id="2178608107313874732">I-Jatter ayikwazi ukusebenzisa ikhamera yakho khona manje</translation>
<translation id="2195025571279539885">Ungathanda ukuthi i-Jatter inikezele ukuhumusha amakhasi esi-<ph name="LANGUAGE_NAME" /> kusukela kuleli sayithi ngesikhathi esizayo?</translation>
<translation id="22313767259766852">Leli kheli okwamanje lilondolozwe ku-Jatter. Ukuze uyisebenzise emikhiqizweni ye-Google, yilondoloze ku-Google Account yakho, <ph name="USER_EMAIL" />.</translation>
<translation id="2236584955986023187">Lokhu kusho ukuthi i-Jatter izocela isayithi yedeskithophu ngaso sonke isikhathi.</translation>
<translation id="2245694534483711162">IGemini ingase isebenzise indawo yakho eqondile, kuye ngemvume osuvele uyinike iJatter</translation>
<translation id="2270466829363945454">Thenga</translation>
<translation id="2313870531055795960">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Jatter. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Jatter ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="2314220608288760290">IJatter ivula ngokuzenzekela amalinki eYouTube Incognito ku-Incognito.</translation>
<translation id="231828342043114302">Ukuze uthole okuqukethwe okwenzelwe wena ngokusekelwe kokuthandayo, ngena ngemvume ku-Jatter.</translation>
<translation id="2326738825692478496">Enye idatha yakho yeJatter ayikalondolozwa kuGoogle Account.

Zama ukulinda imizuzu embalwa ngaphambi kokuphuma. Uma uphuma ngemvume manje, le datha izosulwa.</translation>
<translation id="2337722506862731008">Yabelana ngeJatter</translation>
<translation id="2340423701577464731">Faka into yohlu lokufunda kuJatter</translation>
<translation id="2374627437126809292">I-Jatter isebenzisa Amamephu eGoogle ukuze ikunikeze izikhombisi-ndlela nolwazi lwasendaweni kumakheli atholiwe.</translation>
<translation id="2386292341327187942">Ebhokisini elithi Amawijethi Okusesha, faka i-Jatter</translation>
<translation id="2389827884654658221">Finyelela kuJatter ngokushesha kusuka Esikrinini sakho Sasekhaya se-iPad.</translation>
<translation id="2426113998523353159">Inhlangano yakho idinga ukuba ungene ngemvume ukuze usebenzise i-Jatter.</translation>
<translation id="2450140762465183767">Manje ungasebenzisa i-Jatter noma nini uma uthepha ama-app kumilayezo, amadokhumenti, namanye ama-app.</translation>
<translation id="2459183986985456602">Vula ithebhu yami yakamuva kuJatter.</translation>
<translation id="2476409803017965813">Ungabuyekeza okukhethile noma nini kumasethingi eJatter.</translation>
<translation id="2478931088402984578">Khetha i-<ph name="BEGIN_BOLD" />Jatter<ph name="END_BOLD" /></translation>
<translation id="2485774047568879945">Setha iJatter njengebhrawuza yakho evuleka ngokuzenzekela ukuze wabelane kalula futhi uvule amalinki</translation>
<translation id="2512597191798760956">Cindezela futhi ubambe isithonjana seJatter bese uchofoza okuthi "Hlela isikrini sasekhaya"</translation>
<translation id="2517624234762908348">Vumelanisa idatha yakho ye-Jatter</translation>
<translation id="2575968074225731646">Finyelela iJatter ngokushesha ukusuka kuDokhi ye-iPhone yakho.</translation>
<translation id="2592940277904433508">Qhubeka usebenzisa i-Jatter</translation>
<translation id="2607609479243848905">Uma ukhohlwa umushwana wakho wokungena noma ufuna ukushintsha le sethingi, <ph name="BEGIN_LINK" />sula idatha ye-Jatter e-akhawuntini yakho<ph name="END_LINK" />.</translation>
<translation id="2640367368802736659">Ithiphu yeJatter: Sesha okubonayo ngeGoogle Lens</translation>
<translation id="2650312721222849884">Ukuze ubone amathebhu wakho noma kuphi lapho usebenzisa khona i-Jatter, vula ukuvumelanisa</translation>
<translation id="2684230048001240293">Setha i-Jatter njengesiphequluli esizenzakalelayo ukuze uvumelanise amathebhu akho, amaphasiwedi, nolwazi lokukhokha kuwo wonke amadivayisi akho</translation>
<translation id="2729836253097154631">Ngena ngemvume kuJatter ukuze uthole izinto zakho</translation>
<translation id="2730884209570016437">I-Jatter ayikwazi ukusebenzisa ikhamera yakho ngoba isetshenziswa olunye uhlelo lokusebenza</translation>
<translation id="2742952311155593352">Usuzoqeda ukusetha iJatter!</translation>
<translation id="2798503587425057129">Ivula Uhlu Lokufunda Lwe-Jatter.</translation>
<translation id="28276745681323897"><ph name="BEGIN_LINK" />Ungaphatha ukuthi iyiphi idatha ye-Jatter elondolozwa<ph name="END_LINK" /> ku-Google Account yakho.

Ukuze uthole amasethingi engeziwe asebenzisa idatha ukuthuthukisa ukuzizwisa kwakho kwe-Jatter, iya <ph name="BEGIN_LINK" />Kumasevisi e-Google<ph name="END_LINK" />.</translation>
<translation id="2832168932648876507">Sesha ngezwi kuJatter.</translation>
<translation id="2843571538056574338">Sebenzisa i-Jatter kokuthi Ukugcwalisa okuzenzakalelayo</translation>
<translation id="2918709798697875261">Inhlangano yakho idinga ukuthi uhlale ukhishwe ngemvume ku-Jatter.</translation>
<translation id="2942241131342758843">Sebenzisa i-Jatter ngokuzenzekelayo ukuze uvule amalinki, ukusesha kumawijethi, kanye nokugcwalisa ngokuzenzakalelayo amaphasiwedi kwamanye ama-app</translation>
<translation id="2977470724722393594">I-Jatter isesikhathini samanje</translation>
<translation id="3044857325852340337">Idatha ye-Jatter isuliwe</translation>
<translation id="3054480780637153380">Vula amasethingi weJatter ku-iOS, bese uthepha okuthi "I-App Yebhrawuza Evuleka Ngokuzenzekela" bese ukhetha iJatter.</translation>
<translation id="3115956258722352278">Yenza i-Jatter ibe ibhrawuza yakho yokuzenzakalelayo?</translation>
<translation id="3180939591219927904">Vula okuthi "Khiya amathebhu e-Incognito uma uvala iJatter"</translation>
<translation id="328933489847748230">{count,plural, =1{Manje kuvela iwindi le-Jatter elilodwa}one{Manje kuvela amawindi angu-{count} we-Jatter}other{Manje kuvela amawindi angu-{count} we-Jatter}}</translation>
<translation id="3344973607274501920">I-Jatter ayikwazanga ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="3366305173356742781">Idatha ye-Jatter ku-akhawunti yakho</translation>
<translation id="3387107508582892610">{THRESHOLD,plural, =1{Lokhu kwenzeka lapho i-Jatter ingasetshenziswa umzuzu ongu-{THRESHOLD}. Lokhu kungafaka umlando kanye nokugcwalisa okuzenzakalelayo.}one{Lokhu kwenzeka lapho i-Jatter ingasetshenziswa imizuzu engu-{THRESHOLD}. Lokhu kungafaka umlando kanye nokugcwalisa okuzenzakalelayo.}other{Lokhu kwenzeka lapho i-Jatter ingasetshenziswa imizuzu engu-{THRESHOLD}. Lokhu kungafaka umlando kanye nokugcwalisa okuzenzakalelayo.}}</translation>
<translation id="3410395242749598859">Enye idatha yakho yeJatter ayikalondolozwa ku-<ph name="EMAIL" /> okwamanje.
Zama ukulinda imizuzu embalwa ngaphambi kokushintsha ama-akhawunti. Uma ushintsha ama-akhawunti manje, le datha izosulwa.</translation>
<translation id="3420586870838853527">Ithiphu yeJatter: Ukubhrawuza okuphephile okuthuthukisiwe kuzohambisa usuku lwakho kahle</translation>
<translation id="3440830787838130530">Yabelana nomndeni wakho weqembu kuMphathi Wephasiwedi YeGoogle ngekhophi yephasiwedi ngendlela elula nephephile</translation>
<translation id="3472200483164753384">Ayisekelwe ku-Jatter Canary</translation>
<translation id="347967311580159871">Ukuze uthole amasethingi engeziwe asebenzisa idatha ukuthuthukisa ukuzizwisa kwakho kwe-Jatter, iya <ph name="BEGIN_LINK" />Kumasevisi e-Google<ph name="END_LINK" />.</translation>
<translation id="3512168799938877162">Iphasiwedi yakho ayizange yabiwe. Hlola ukuxhumeka kwakho kwe-inthanethi futhi uqinisekise ukuthi ungene ngemvume ku-Jatter. Bese uzame futhi.</translation>
<translation id="3529798650269984835">Vula okuthi “Ukhiya wamathebhu e-Incognito uma uvala iJatter.”</translation>
<translation id="3541247799006476453">Finyelela kalula kumaphasiwedi nezikhiye zakho zokudlula ngeJatter Ezigcwaliselayo</translation>
<translation id="3567399274263440288">Ukuze uthole okuningi kwe-Jatter, ngena ngemvume ku-Jatter nge-Google Account yakho</translation>
<translation id="3581385059720151202">Sesha okubukwayo kuJatter</translation>
<translation id="3582640969619785896">IJatter izocela ukulondoloza iphasiwedi yakho</translation>
<translation id="3594315078412605236">Lawula izindlela zokukhokha kuJatter</translation>
<translation id="3617143087229977194">Vula amasethingi Ama-app Angena Ngokuzenzekelayo ku-iOS, uthephe elithi "I-app Yokubhrawuza" bese ukhetha iJatter.</translation>
<translation id="3634039384458740619">Vula Amasethingi We-Jatter</translation>
<translation id="3639997914391704523">I-Jatter ingahlola amaphasiwedi akho uma ungena ngemvume nge-Akhawunti yakho ye-Google.</translation>
<translation id="372658070733623520">Ukuze usebenzise futhi ulondoloze idatha ye-Jatter ku-Google Account yakho, qinisekisa ukuthi nguwe.</translation>
<translation id="3728124580182886854">Linka i-Jatter namanye amasevisi e-Google ngokwenza ngokomuntu ngamunye nangezinye izinjongo</translation>
<translation id="377649297473651452">Ukubuka okunwetshiwe Kokugcwalisa okuzenzakalelayo kweJatter</translation>
<translation id="3780779443901618967">Ikuxwayisa mayelana namasayithi ayingozi, ngisho nalawo i-Google ebingazi ngawo ngaphambilini, ngokuhlaziya idatha eningi evela kumasayithi kunokuvikela okujwayelekile. Ungakhetha ukweqa izixwayiso ze-Jatter.</translation>
<translation id="3805899903892079518">I-Jatter ayinakho ukufinyelela kuzithombe zakho noma amavidiyo. Nika amandla ukufinyelela kuzilungiselelo ze-iOS &gt; Ubumfihlo &gt; Izithombe.</translation>
<translation id="3816686541346279443">IJatter izocela ukulondoloza iphasiwedi yakho.</translation>
<translation id="3827545470516145620">Uthola ukuvikeleka okujwayelekile kule divayisi</translation>
<translation id="3833326979834193417">I-Jatter isebenzisa ngokuzenzakalelayo Ukuhlola Ukuphepha nsuku zonke ukuze ikugcine uphephile ekwephulweni kwesivumelwano sedatha, amawebhusayithi angaphephile nokuningi. Ungathola okwengeziwe mayelana Nokuhlolwa Kokuphepha ku-Amasethingi.</translation>
<translation id="3837584850181228767">Ithiphu yeJatter: Ukubhrawuza Okuphephe Ngokuthuthukisiwe</translation>
<translation id="3845223911364528001">Buyela kuJatter ukuze ulayishe ifayela lakho</translation>
<translation id="3855938650519180865">Yini entsha ku-Jatter</translation>
<translation id="3886689467633467988">Ngena ngemvume kule sayithi naku-Jatter ukuze uthole amabhukhimakhi akho kanye nokuningi kuwo wonke amadivayisi akho.</translation>
<translation id="3949514465204582407">Ithiphu yeJatter: Thola amaphasiwedi akho kunoma iyiphi i-app</translation>
<translation id="4005283307739974863">Ivula futhi Iqalise Ukuhlola Kokuphepha ku-Jatter.</translation>
<translation id="4043291146360695975">Amaphasiwedi alondolozwa Kwisiphathi Sephasiwedi kule divayisi kuphela.</translation>
<translation id="4066426933127344530">Sebenzisa iJatter ngokuzenzakalela</translation>
<translation id="4087314024407094071">Ivula amasethingi kuJatter.</translation>
<translation id="4099085513035183040">Ayisekelwe ku-Jatter Beta</translation>
<translation id="4106512142782407609">Ungene ngemvume njengo-<ph name="EMAIL" />.

Idatha yakho ibhalwe ngokufihla ngomushwana wokungena. Ifake ukuze usebenzise futhi wonge idatha ye-Jatter ku-Google Account yakho.</translation>
<translation id="4118287192800900567">Ithiphu ye-Jatter: Ngena ngemvume ku-Jatter</translation>
<translation id="4195557071150719219">Bheka Amathebhu Akamuva E-Jatter</translation>
<translation id="420541179527342563">Ukuze uvale Imodi Yokukhiya ku-Jatter yivale iPad yakho.</translation>
<translation id="4272892696084633551">Siza ukuthuthukisa izici ze-Jatter nokusebenza</translation>
<translation id="4302397443352897529">Amasethingi eJatter</translation>
<translation id="4408912345039114853">Qalisa Ukuhlola Kokuphepha kwe-Jatter</translation>
<translation id="4432744876818348753">Ngena ngemvume ukuze uthole okuningi ku-Jatter.</translation>
<translation id="4445228361214254027">Inhlangano yakho ikuvalile ukukwazi ukusebenzisa nokulondoloza idatha ye-Jatter ku-Google Account yakho. Amabhukhimakhi amasha, amaphasiwedi, kanye nokuningi kuzolondolozwa kuphela kule divayisi.</translation>
<translation id="4498832288620833153">Ifaka ama-URL afakiwe ohlwini lwakho lokufunda ku-Jatter.</translation>
<translation id="4508268628669724828">Phinda uhlole lapha ukuze uthole amathiphu awusizo ukuze uthole okuningi kuJatter.</translation>
<translation id="452436063477828504">Qinisekisa ukuthi ungakwazi njalo ukusebenzisa idatha ye-Jatter Ku-Google Account yakho</translation>
<translation id="4527452566931097835">Setha iJatter njengokuzenzakalelayo?</translation>
<translation id="4555020257205549924">Uma lesi sici sivuliwe, i-Jatter izonikezela ngokuhumusha amakhasi abhalwe ngezinye izilimi isebenzisa i-Google Translate. <ph name="BEGIN_LINK" />Funda kabanzi<ph name="END_LINK" /></translation>
<translation id="4572441104543926904">Ukubethelwa komushwana wokungena akubandakanyi izindlela zokukhokha namakheli.

Ukuze ushintshe lawa masethingi, <ph name="BEGIN_LINK" />sula idatha ye-Jatter e-akhawuntini yakho<ph name="END_LINK" />.</translation>
<translation id="4578500311756617174">Ithiphu yeJatter: sebenzisa iJatter ngokuzenzakalela</translation>
<translation id="458786853569524949">Manje ungasebenzisa iJatter noma nini uma uthepha ama-app ema-imeyilini, emadokhumentini, nakwamanye ama-app.</translation>
<translation id="4633738821577273991">Thola Ukubhrawuza Okuphephile Okuthuthukisiwe kwale phrofayela ye-Jatter, futhi</translation>
<translation id="4654936625574199632">Ukuze isize ukuthuthukisa i-app, i-Jatter ithumela imibiko yokusetshenziswa nedatha yokuphahlazeka ku-Google. <ph name="BEGIN_LINK" />Phatha<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Vula iskena se-Jatter</translation>
<translation id="4685611756167369067">Vula ithebhu yeJatter Incognito</translation>
<translation id="4736424910885271643">I-akhawunti yakho iphethwe yi-<ph name="HOSTED_DOMAIN" />, ngakho idatha yakho ye-Jatter izosulwa kusuka kule divayisi</translation>
<translation id="4790638144988730920">Qhubeka usebenzisa idatha ye-Jatter ku-Google Account yakho.</translation>
<translation id="4828317641996116749">I-Jatter ayikwazanga ukuhlola wonke amaphasiwedi. Zama futhi emuva kwesikhathi.</translation>
<translation id="4856138222358683580">Izenzo zeJatter</translation>
<translation id="4904452304169763785">Izexwayiso mayelana nanoma iziphi izinkinga ezithinta ubumfihlo nokuvikeleka iJatter ekutholela zona.</translation>
<translation id="4908570938463711775">Funda izisekelo eziwusizo zeJatter ukuze uqalise</translation>
<translation id="4962295957157529683">Qedela obukade ukwenza kwelinye iwindi lakho le-Jatter elivuliwe.</translation>
<translation id="4985291216379576555">Ayixhunyiwe kwi-inthanethi, i-Jatter ayikwazi ukuhlola izibuyekezo</translation>
<translation id="4996471330284142407">Yenza okuningi nge-Jatter elula, evikelekile, nesheshayo kunangaphambilini.</translation>
<translation id="4999538639245140991">Ngoba uphuma ku-akhawunti ephethwe ngu-<ph name="SIGNOUT_MANAGED_DOMAIN" />, idatha yakho ye-Jatter izosuswa kusuka kule divayisi. Idatha yakho izohlala ku-akhawunti yakho ye-Google.</translation>
<translation id="5042011327527167688">Thepha okuthi “Buka nge-Amamephu eGoogle ku-Jatter.”</translation>
<translation id="5044871537677053278">I-Jatter ithola amakheli bese isebenzisa Amamephu eGoogle ukuze ikunikeze izikhombisi-ndlela kanye nolwazi lwendawo.</translation>
<translation id="5048140766121299007">Kula masethingi "<ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" />" vula "iJatter"</translation>
<translation id="5053429694249468757">Isula idatha yeJatter…</translation>
<translation id="5071749685031362629">IJatter ye-iOS</translation>
<translation id="5124429847818367226">Manje usungasebenzisa i-Jatter noma kunini uma ubhrawuza noma uthepha amalinki emilayezweni, kumadokhumenti, nakwamanye ama-app.</translation>
<translation id="5131565040785979529">Inhlangano yakho, <ph name="DOMAIN" />, ilawula i-akhawunti ongene kuyo ngemvume kanye nendlela i-Jatter esetshenziswa ngayo.</translation>
<translation id="5134464247000681876">Vula amalinki kuGmail, kuMaps, kuYouTube nakwamanye ama-app kuJatter</translation>
<translation id="5203244847421322551">Londoloza bese wenza amaphasiwedi azigwaliseleke kuJatter</translation>
<translation id="5218806323985098884">Hlola ukuthi yini entsha kuJatter</translation>
<translation id="5224391634244552924">Awekho amaphasiwedi alondoloziwe. I-Jatter ingahlola amaphasiwedi akho lapho uwalondoloza khona.</translation>
<translation id="5259423875997548710">Sesha okubukwayo kuJatter.</translation>
<translation id="5284913972719948193">Ngenisa idatha yakho ukuze usebenzise amaphasiwedi, umlando, amabhukhimakkhi namakhadi akho esikweletu kuJatter</translation>
<translation id="5308226104666789935">I-Jatter ayikwazi ukuhlola izibuyekezo</translation>
<translation id="5311557153294205270">Ifaka ama-URL afakiwe kumabhukhimakhi akho ku-Jatter.</translation>
<translation id="5383251701169024761">Ukuze uthole kalula amaphasiwedi akho alondoloziwe kwamanye ama-app, khetha iJatter Yokuzigcwalisela.</translation>
