import("//build/buildflag_header.gni")
import("//build/config/jatter_args.gni")

_is_jatter_prod = jatter_build_environment == "prod"

buildflag_header("jatter_buildflags") {
  header = "jatter_buildflags.h"
  flags = [
    "IS_JATTER_PROD=$_is_jatter_prod",
  ]
}

source_set("launcher_support") {
  sources = [
    "chrome_launcher_support.cc",
    "chrome_launcher_support.h",
  ]

  deps = [
    ":jatter_buildflags",
    "//base",
    "//build:branding_buildflags",
  ]
}
