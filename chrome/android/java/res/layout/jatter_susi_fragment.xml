<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jatter_fre_background">

    <!-- 1. Native Prompt UI -->
    <LinearLayout
        android:id="@+id/susi_prompt_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="72dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_jatter_mascot"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Sign in to Jatter"
            android:textColor="#202124"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Sign in to keep your personalization, chats, and notes with you across devices."
            android:textColor="#5F6368"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/susi_sign_in_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/jatter_primary_button_bg"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:text="Sign In" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/susi_skip_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:background="@android:color/transparent"
            android:textColor="#6045E2"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Stay Signed Out" />
    </LinearLayout>

    <!-- 2. Web Authentication Container -->
    <FrameLayout
        android:id="@+id/susi_web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/white" />

</FrameLayout>
