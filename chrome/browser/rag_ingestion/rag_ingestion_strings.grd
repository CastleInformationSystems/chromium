    </translations>

  <release seq="1">
    <messages fallback_to_english="true">
      <message name="IDS_RAG_INGESTION_BUBBLE_TITLE" desc="Title of the RAG Ingestion permission bubble">
        Enable personal answers for <ph name="SITE_NAME">$1<ex>Wikipedia</ex></ph>?
      </message>
      <message name="IDS_RAG_INGESTION_BUBBLE_TEXT" desc="Description in the permission bubble">
        Jatter can securely learn about websites you log into in order to provide personal answers and assistance.
      </message>
      <message name="IDS_RAG_INGESTION_ALLOW_BUTTON" desc="Allow button text">
        Enable
      </message>
      <message name="IDS_RAG_INGESTION_BLOCK_BUTTON" desc="Block button text">
        Never
      </message>
      <message name="IDS_RAG_INGESTION_TRANSITION_BUBBLE_ASK_ABOUT_TEXT" desc="Input field text">
        Ask about <ph name="SITE_NAME">$1<ex>Wikipedia</ex></ph>
      </message>
      <message name="IDS_RAG_INGESTION_TRANSITION_BUBBLE_STATUS_TEXT" desc="Text of ingestion current status">
        Learning
      </message>
      <message name="IDS_RAG_INGESTION_TRANSITION_BUBBLE_DOMAIN_ENABLED_FOR_TEXT" desc="Domain for which rag ingestion was enabled for">
        Personal answers are enabled for <ph name="SITE_NAME">$1<ex>Wikipedia</ex></ph>
      </message>
      <message name="IDS_RAG_INGESTION_TRANSITION_BUBBLE_DOMAIN_DISABLED_FOR_TEXT" desc="Used when RAG ingestion is disabled">
        Personal answers are disabled for <ph name="SITE_NAME">$1<ex>Wikipedia</ex></ph>
      </message>
    </messages>
  </release>
</grit>