<!DOCTYPE translationbundle>
<translationbundle lang="id">
<translation id="130631256467250065">Perubahan Anda akan diterapkan pada saat Anda nanti menyalakan ulang perangkat.</translation>
<translation id="261308610302996111">Buka
          menu Jatter &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          dan pastikan konfigurasi disetel ke "tidak ada proxy" atau "langsung".</translation>
<translation id="275588974610408078">Pelaporan kerusakan tidak tersedia di Jatter.</translation>
<translation id="3064346599913645280">Anda melihat halaman Jatter yang aman</translation>
<translation id="3255926992597692024">Jatter mencoba mengubah setelan pengisian metode pembayaran.</translation>
<translation id="358997566136285270">Logo Jatter</translation>
<translation id="4050599136622776556">Jatter mencoba mengedit metode pembayaran.</translation>
<translation id="4365115785552740256">Jatter tercipta berkat proyek sumber terbuka <ph name="BEGIN_LINK_CHROMIUM" />Jatter<ph name="END_LINK_CHROMIUM" /> dan berbagai <ph name="BEGIN_LINK_OSS" />software sumber terbuka<ph name="END_LINK_OSS" /> lainnya.</translation>
<translation id="4622039161600275920">Halaman ini telah diblokir oleh Jatter</translation>
<translation id="48558539577516920">Izinkan Jatter untuk mengakses jaringan di setelan firewall atau antivirus
          Anda.</translation>
<translation id="4949828774841497663">Buka Aplikasi &gt; Setelan Sistem &gt; Jaringan, pilih
          jaringan aktif, klik tombol Detail..., dan batalkan pilihan proxy
          yang mungkin telah dipilih.</translation>
<translation id="6480456350195404966">Buka
          menu Jatter &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Jaringan &amp; internet &gt; Proxy
          dan batalkan pilihan "Otomatis deteksi setelan".</translation>
<translation id="648062525172759633">Halaman ini ditujukan untuk digunakan oleh developer Jatter, dan mungkin tidak dikelola atau diuji secara aktif. Untuk mengaktifkannya, buka <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, klik tombol untuk mengaktifkan halaman debug, lalu buka lagi halaman ini.</translation>
<translation id="6549378540556750549">Jatter juga terwujud karena adanya <ph name="BEGIN_LINK_OSS" />software open source<ph name="END_LINK_OSS" /> lainnya.</translation>
<translation id="6613594504749178791">Perubahan Anda akan berlaku saat berikutnya Anda membuka Jatter.</translation>
<translation id="691026815377248078">Jatter memerlukan akses Bluetooth untuk melanjutkan 
 penyambungan. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Jatter terwujud karena adanya project open source <ph name="BEGIN_LINK_CHROMIUM" />Jatter<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="7861509383340276692">Buka
          menu Jatter &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          dan batalkan pilihan "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Jika hal ini tidak menyelesaikan masalah, sebaiknya pilih lagi opsi ini
          untuk meningkatkan kinerja.</translation>
<translation id="8597726643333341451">Anda melihat halaman Chrome for Testing yang aman</translation>
<translation id="8684913864886094367">Jatter tidak menutup dengan benar.</translation>
</translationbundle>