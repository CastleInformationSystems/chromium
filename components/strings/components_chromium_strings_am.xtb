<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="am">
<translation id="130631256467250065">ለውጦችዎ መሣሪያዎን ዳግም በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="261308610302996111">ወደ
          የJatter ምናሌ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          ይሂዱ እና ውቅርዎ ወደ «ምንም ተኪ» ወይም «ቀጥታ» መዋቀሩን ያረጋግጡ።</translation>
<translation id="275588974610408078">የብልሽት ሪፖርት በJatter ውስጥ አይገኝም።</translation>
<translation id="3064346599913645280">ደህንነቱ የተጠበቀ የJatter ገፅ እየተመለከቱ ነው</translation>
<translation id="3255926992597692024">Jatter የመክፈያ ዘዴዎችን ለመሙላት ቅንብሮችን ለማሻሻል እየሞከረ ነው።</translation>
<translation id="358997566136285270">የJatter ዓርማ</translation>
<translation id="4050599136622776556">Jatter የመክፈያ ዘዴዎችን ለማርትዕ እየሞከረ ነው።</translation>
<translation id="4365115785552740256">Jatter በ<ph name="BEGIN_LINK_CHROMIUM" />Jatter<ph name="END_LINK_CHROMIUM" />  ክፍት ምንጭ ፕሮጀክት እና በሌላ <ph name="BEGIN_LINK_OSS" />ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_OSS" /> እውን ሊሆን ችሏል።</translation>
<translation id="4622039161600275920">ይህ ገፅ በJatter ታግዷል</translation>
<translation id="48558539577516920">Jatter በኬላ ወይም የጸረ-ቫይረስ ቅንብሮችዎን አውታረ መረቡን እንዲደርስበት
        ይፍቀዱለት።</translation>
<translation id="4949828774841497663">ወደ መተግበሪያዎች &gt; የሥርዓት ቅንብሮች &gt; አውታረ መረብ ይሂዱ፣
          ንቁ አውታረ መረብ የሚለውን ይምረጡ፣ የዝርዝሮች... አዝራሩ ላይ ጠቅ ያድርጉ እና የተመረጡ ሊሆኑ የሚችሉ
          ማናቸውም ተኪዎችን አይምረጡ።</translation>
<translation id="6480456350195404966">ወደ
          Jatter ምናሌ &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          አውታረ መረብ እና በይነመረብ &gt; ተኪ
          ይሂዱ እና «በራስ-ሰር ቅንብሮችን እወቅ» የሚለውን አይምረጡ።</translation>
<translation id="648062525172759633">እነዚህ ገፆች በJatter ገንቢዎች ጥቅም ላይ እንዲውሉ የታሰቡ ናቸው እና በንቃት ተጠብቀው ላይቆዩ ወይም ላይፈተሹ ይችላሉ። እነሱን ለማንቃት ወደ <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> ያስሱ፣ የስሕተት አርም ገፆችን ለማንቃት አዝራሩን ጠቅ ያድርጉ እና ከዚያም እንደገና ወደዚህ ገፅ ያስሱ።</translation>
<translation id="6549378540556750549">እንዲሁም Jatter በሌላ <ph name="BEGIN_LINK_OSS" />ክፍት ምንጭ ሶፍትዌር<ph name="END_LINK_OSS" /> እንዲሆን ተደርጓል።</translation>
<translation id="6613594504749178791">ለውጦችዎ Jatter በሚያስጀምሩበት ቀጣዩ ጊዜ ላይ ይተገበራሉ።</translation>
<translation id="691026815377248078">Jatter ማጣመርን ለመቀጠል የብሉቱዝ መዳረሻ ያስፈልገዋል። <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Jatter በ<ph name="BEGIN_LINK_CHROMIUM" />Jatter<ph name="END_LINK_CHROMIUM" /> ክፍት ምንጭ ፕሮጀክት እንዲሆን ተደርጓል።</translation>
<translation id="7861509383340276692">ወደ
        የJatter ምናሌ &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        ይሂዱና «<ph name="NO_PREFETCH_DESCRIPTION" />»ን አይምረጡ።
        ይሄ ችግሩን ካልፈታው ለተሻሻለ አፈጻጸም ይህን አማራጭ እንደገና መምረጥ እንመክራለን።</translation>
<translation id="8597726643333341451">ደህንነቱ የተጠበቀ የChrome ለሙከራ ገፅ እየተመለከቱ ነው</translation>
<translation id="8684913864886094367">Jatter በትክክል አልተዘጋም።</translation>
</translationbundle>