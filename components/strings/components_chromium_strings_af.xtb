<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="af">
<translation id="130631256467250065">Jou veranderinge sal in werking tree wanneer jy jou toestel herbegin.</translation>
<translation id="261308610302996111">Gaan na
          die Jatter-kieslys &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          en maak seker jou opstelling is op “geen instaanbediener nie” of “direk” gestel.</translation>
<translation id="275588974610408078">Omvalrapportering is nie beskikbaar in Jatter nie.</translation>
<translation id="3064346599913645280">Jy bekyk tans 'n veilige Jatter-bladsy</translation>
<translation id="3255926992597692024">Jatter probeer tans instellings vir die invul van betaalmetodes wysig.</translation>
<translation id="358997566136285270">Jatter-logo</translation>
<translation id="4050599136622776556">Jatter probeer tans om betaalmetodes te wysig.</translation>
<translation id="4365115785552740256">Jatter word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM" />Jatter<ph name="END_LINK_CHROMIUM" />-oopbronprojek en ander <ph name="BEGIN_LINK_OSS" />oopbronsagteware<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">Hierdie bladsy is deur Jatter geblokkeer</translation>
<translation id="48558539577516920">Laat Jatter in jou brandmuur- of antivirusinstellings toe om by jou netwerk
          in te gaan.</translation>
<translation id="4949828774841497663">Gaan na Apps &gt; Stelselinstellings &gt; Netwerk, kies die
          aktiewe netwerk, klik die Besonderhedeknoppie, en ontkies enige instaanbedieners
          wat dalk gekies is.</translation>
<translation id="6480456350195404966">Gaan na
          die Jatter-kieslys &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Netwerk en internet &gt; Instaanbediener
          en ontkies “Vind instellings outomaties”.</translation>
<translation id="648062525172759633">Hierdie bladsye is bedoel vir gebruik deur Jatter-ontwikkelaars en word dalk nie aktief onderhou of getoets nie. As jy hulle wil aktiveer, navigeer na <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, klik die knoppie om ontfoutbladsye te aktiveer en navigeer dan terug na hierdie bladsy toe.</translation>
<translation id="6549378540556750549">Jatter word ook moontlik gemaak deur ander <ph name="BEGIN_LINK_OSS" />oopbronsagteware<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Jou veranderinge sal in werking tree wanneer jy Jatter weer herbegin.</translation>
<translation id="691026815377248078">Jatter het Bluetooth-toegang nodig om voort te gaan met 
 saambinding. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">Jatter word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM" />Jatter<ph name="END_LINK_CHROMIUM" />-oopbronprojek.</translation>
<translation id="7861509383340276692">Gaan na
        die Jatter-kieslys &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        en ontmerk "<ph name="NO_PREFETCH_DESCRIPTION" />."
        As dit nie die probleem oplos nie, beveel ons aan dat hierdie opsie
        weer gekies word vir verbeterde werkverrigting.</translation>
<translation id="8597726643333341451">Jy bekyk tans ’n veilige Chrome-toetsweergawe-bladsy</translation>
<translation id="8684913864886094367">Chrome het nie reg toegemaak nie.</translation>
</translationbundle>